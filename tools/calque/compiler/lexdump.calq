// calq0 slice-1 driver: lex input unit 0 and dump the token stream
// (the tokenizer itself lives in lex.calq; this file exists so the
// unit's `main` can move on as calq0 grows - one main per translation,
// and the real compiler main will replace these slice drivers).
//
// Dump format: `<kind> <text> <line>:<col>` per token, then
// "count <n>"; on a lexical error: `error <line>:<col> <message>`
// and exit code 1.
pub fn main() i64 {
    const count: i64 = __calque_input_count();
    if count < 1 {
        io.print("error 1:1 no input unit\n");
        return 1;
    }
    const src: Str = __calque_input(0);
    const out: Lexed = lex(src);
    if out.ok == false {
        io.print("error ");
        io.print(str.fromI64(out.err_line));
        io.print(":");
        io.print(str.fromI64(out.err_col));
        io.print(" ");
        io.print(out.msg);
        io.print("\n");
        return 1;
    }
    const m: i64 = vector.len(out.toks);
    var i: i64 = 0;
    while i < m {
        const t: Tok = vector.get(out.toks, i);
        io.print(kind_name(t.kind));
        io.print(" ");
        io.print(t.text);
        io.print(" ");
        io.print(str.fromI64(t.line));
        io.print(":");
        io.print(str.fromI64(t.col));
        io.print("\n");
        i = i + 1;
    }
    io.print("count ");
    io.print(str.fromI64(m));
    io.print("\n");
    return 0;
}
