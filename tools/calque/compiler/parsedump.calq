// calq0 slice-2b driver: lex + parse input unit 0 as a full b0
// PROGRAM (type declarations + functions) and dump the AST. The
// expression-only mode lives in exprdump.calq; the real compiler main
// replaces both when the corpus gate lands.
pub fn main() i64 {
    const count: i64 = __calque_input_count();
    if count < 1 {
        io.print("error 1:1 no input unit\n");
        return 1;
    }
    const src: Str = __calque_input(0);
    const lx: Lexed = lex(src);
    if state_ok(lx.state) == false {
        io.print(fail_text(state_fail(lx.state)));
        io.print("\n");
        return 1;
    }
    const p: P = p_new(lx.toks);
    const a: Ast = p_ast(p);
    if p_ok(p) == false {
        io.print(fail_text(state_fail(p_state(p))));
        io.print("\n");
        return 1;
    }
    io.print(d_ast(a));
    io.print("\n");
    return 0;
}
