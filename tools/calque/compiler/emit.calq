// calq0 slice 3a - the EMITTER core: AST -> kernel-IR artifact text,
// mirroring the seed's emission rules (D-092 closure convention, the
// artifact header, the entry wrapper). STATE (D-112): one Emitter
// value, initialized by %Emitter{} defaults; mutating helpers take
// `mut e: Emitter` (the scoped exclusive interface), read-only helpers
// take plain `e: Emitter`, and the counters are real scalar fields -
// no singleton-vector cells. The emitter REJECTS recovery nodes
// (Expr.Bad, D-109): e_bad records the failure in State and yields "";
// the driver bails before printing, so nothing shaped like a valid
// expression ever reaches execution.
//
// Slice 3a covers: the module header + main wrapper, integer/bool/Str
// literals, and function bodies whose only content is the return
// expression (extended by the following slices: statements, calls,
// checked arithmetic, matches, records - one proving test each,
// differential against the SEED's emission for the same program).

pub const Blk = struct {
    label: Str = "",
    lines: [Str] = [],
};

// The active comptime substitution (D-113): a comptime parameter's
// name mapped to the instantiation's concrete type.
pub const TV = struct {
    name: Str,
    ty: Ty,
};

pub const InstN = struct {
    key: Str,
    f: Fn,
};

pub const InstE = struct {
    f: Fn,
    sub: Vector(TV),
};

pub const GRes = struct {
    f: Fn,
    args: Vector(Expr),
};

pub const Emitter = struct {
    output: [Str] = ["// calque-artifact v0"],

    next_value: i64 = 0,
    next_block: i64 = 0,
    current_block: i64 = 0,
    terminated: bool = false,
    state: State = State.Ok,

    blocks: [Blk] = [%Blk{}],
    scopes: [Scope] = [],
    value_types: [VTy] = [],
    return_types: [Ty] = [Ty.UnitV],
    files: [Str] = ["?"],
    asts: [Ast] = [%Ast{fns: [], types: []}],
    lifted: [Str] = [],
    instq: [InstE] = [],
    insts: [InstN] = [],
    tvars: [TV] = [],
    lams: i64 = 0,
    capbar: i64 = 0,
    caps: [Binding] = [],
    cap_origs: [Binding] = [],
    capenv_ty: Str = "",
};

pub fn e_init() Emitter {
    return %Emitter{};
}

pub fn e_ast(mut e: Emitter) Ast {
    return vector.get(e.asts, 0);
}

pub fn e_ast_set(mut e: Emitter, a: Ast) {
    vector.set(e.asts, 0, a);
}

pub fn e_ret_set(mut e: Emitter, t: Ty) {
    vector.set(e.return_types, 0, t);
}

pub fn e_file_set(mut e: Emitter, f: Str) {
    vector.set(e.files, 0, f);
}

pub fn scope_push(mut e: Emitter) {
    vector.push(e.scopes, empty_scope());
}

pub fn scope_pop(mut e: Emitter) {
    // b0 vectors have no truncate; scopes are a vector CELL so the pop
    // rebuilds the outer vector minus its last entry.
    const sc: Vector(Scope) = e.scopes;
    const n: i64 = vector.len(sc);
    var kept: Vector(Scope) = vector.new();
    var i: i64 = 0;
    while i < n - 1 {
        vector.push(kept, vector.get(sc, i));
        i = i + 1;
    }
    e.scopes = kept;
}

pub fn e_ok(mut e: Emitter) bool {
    return state_ok(e.state);
}

pub fn e_state(mut e: Emitter) State {
    return e.state;
}

pub fn e_fail(mut e: Emitter, b: BadNode) Str {
    e.state = State.Failed(%Fail{msg: b.msg, line: b.line, col: b.col});
    return "";
}

pub fn e_fail_at(mut e: Emitter, line: i64, col: i64, msg: Str) Str {
    // FIRST failure wins: later diagnostics usually cascade from the
    // root (D-109's state model).
    if state_ok(e.state) == false {
        return "";
    }
    e.state = State.Failed(%Fail{msg: msg, line: line, col: col});
    return "";
}

pub fn fresh(mut e: Emitter) Str {
    e.next_value = e.next_value + 1;
    return str.concat("%t", str.fromI64(e.next_value));
}

pub fn fresh_label(mut e: Emitter) Str {
    e.next_block = e.next_block + 1;
    return str.concat("b", str.fromI64(e.next_block));
}

pub fn cur_block(mut e: Emitter) [Str] {
    const b: Blk = vector.get(e.blocks, e.current_block);
    return b.lines;
}

// Indented line (inside a function body / block).
pub fn emit_line(mut e: Emitter, s: Str) {
    vector.push(e.output, str.concat("  ", s));
}

// Top-level line (function headers, closing braces, wrapper lines).
pub fn emit_top(mut e: Emitter, s: Str) {
    vector.push(e.output, s);
}

pub fn new_block(mut e: Emitter, label: Str) {
    var lines: Vector(Str) = vector.new();
    vector.push(e.blocks, %Blk{label: label, lines: lines});
    e.current_block = vector.len(e.blocks) - 1;
    e.terminated = false;
}

pub fn terminate(mut e: Emitter, s: Str) {
    emit_line(e, s);
    e.terminated = true;
}

pub fn is_terminated(mut e: Emitter) bool {
    return e.terminated;
}

// Emitters a block label (col 0) and opens a fresh unterminated block.
pub fn new_label(mut e: Emitter, label: Str) {
    emit_top(e, str.concat("^", str.concat(label, ":")));
    e.terminated = false;
}

// The seed's closed MLIR string-escape set: \" \\ then \0A \09 \0D \00.
pub fn e_esc(s: Str) Str {
    var out: Str = "";
    var i: i64 = 0;
    const n: i64 = str.len(s);
    while i < n {
        const c: Str = str.sub(s, i, 1);
        if c == "\"" {
            out = str.concat(out, "\\\"");
        } else {
            if c == "\\" {
                out = str.concat(out, "\\\\");
            } else {
                if c == "\n" {
                    out = str.concat(out, "\\0A");
                } else {
                    if c == "\t" {
                        out = str.concat(out, "\\09");
                    } else {
                        if c == "\r" {
                            out = str.concat(out, "\\0D");
                        } else {
                            if c == "\0" {
                                out = str.concat(out, "\\00");
                            } else {
                                out = str.concat(out, c);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return out;
}

pub fn e_int(mut e: Emitter, text: Str) Str {
    const v: Str = fresh(e);
    emit_line(e, str.concat(v, str.concat(" = arith.constant ", str.concat(text, " : i64"))));
    vset(e, v, Ty.I64);
    return v;
}

pub fn e_bool(mut e: Emitter, text: Str) Str {
    const v: Str = fresh(e);
    emit_line(e, str.concat(v, str.concat(" = arith.constant ", text)));
    vset(e, v, Ty.BoolV);
    return v;
}

pub fn e_str(mut e: Emitter, text: Str) Str {
    const v: Str = fresh(e);
    var acc: Str = " = \"frk_bstr.lit\"() {text = \"";
    acc = str.concat(acc, e_esc(text));
    acc = str.concat(acc, "\"} : () -> !frk_bstr.str");
    emit_line(e, str.concat(v, acc));
    vset(e, v, Ty.StrV);
    return v;
}

pub fn ty_is_unit(t: Ty) bool {
    return match t {
        Ty.UnitV => true,
        _ => false,
    };
}

pub fn ty_is_i64(t: Ty) bool {
    return match t {
        Ty.I64 => true,
        _ => false,
    };
}

pub fn ty_ir(t: Ty) Str {
    return match t {
        Ty.I64 => "i64",
        Ty.BoolV => "i1",
        Ty.StrV => "!frk_bstr.str",
        Ty.UnitV => "unit",
        Ty.Named(n) => n,
        Ty.Vec(inner) => "vec",
        Ty.OptT(inner) => "opt",
        Ty.ResT(rz) => "res",
        Ty.Tup(tys) => "tup",
        Ty.ArrT(a2) => "arr",
        Ty.FnT(sig) => "fn",
        Ty.TyBad(b) => "bad",
    };
}

pub fn sym_of(f: Fn) Str {
    if f.name == "main" {
        return "__calque_main";
    }
    if str.len(f.ns) > 0 {
        return str.concat(f.ns, str.concat("__", f.name));
    }
    return f.name;
}

pub fn e_fn(mut e: Emitter, f: Fn) {
    e.next_value = 0;
    e.next_block = 0;
    var fresh_vt: Vector(VTy) = vector.new();
    e.value_types = fresh_vt;
    var fresh_sc: Vector(Scope) = vector.new();
    e.scopes = fresh_sc;
    e_ret_set(e, f.ret);
    e_file_set(e, f.file);
    e.terminated = false;
    new_block(e, "");
    e_fn_core(e, f);
}

pub fn e_fn_core(mut e: Emitter, f: Fn) {
    scope_push(e);
    var head: Str = str.concat("func.func @", sym_of(f));
    var args: Str = "%env: !frk_closure.envref";
    const np: i64 = vector.len(f.params);
    var i: i64 = 0;
    while i < np {
        const prm: Param = vector.get(f.params, i);
        if prm.mut {
            args = str.concat(args, str.concat(", %", str.concat(prm.name, str.concat(": ", box_ir_t(e_ast(e), prm.ty)))));
            declare(e, %Binding{name: prm.name, is_box: true, ty: prm.ty, id: str.concat("%", prm.name), box: box_ir_t(e_ast(e), prm.ty)});
        } else {
            args = str.concat(args, str.concat(", %", str.concat(prm.name, str.concat(": ", value_ir_t(e_ast(e), prm.ty)))));
            declare(e, %Binding{name: prm.name, is_box: false, ty: prm.ty, id: str.concat("%", prm.name), box: ""});
        }
        i = i + 1;
    }
    head = str.concat(head, str.concat("(", str.concat(args, ")")));
    if ty_is_unit(f.ret) == false {
        head = str.concat(head, str.concat(" -> ", value_ir_t(e_ast(e), f.ret)));
    }
    head = str.concat(head, " {");
    emit_top(e, head);
    const b: Block = f.body;
    var upto: i64 = vector.len(b.stmts);
    var tail_if: IfE = %IfE{cond: poison(), then: poison_block(), has_else: false, els: poison_block()};
    var has_tail_if: bool = false;
    if ty_is_unit(f.ret) == false {
        if b.has_tail == false {
            if upto > 0 {
                const last: Stmt = vector.get(b.stmts, upto - 1);
                tail_if = tail_if_of(last);
                has_tail_if = tail_if.has_else;
                if has_tail_if {
                    upto = upto - 1;
                }
            }
        }
    }
    var i2: i64 = 0;
    while i2 < upto {
        emit_stmt(e, vector.get(b.stmts, i2));
        i2 = i2 + 1;
    }
    const a: Ast = e_ast(e);
    if is_terminated(e) == false {
    if has_tail_if {
        const v: Str = emit_ifx(e, tail_if);
        var acc: Str = "func.return ";
        acc = str.concat(acc, v);
        acc = str.concat(acc, " : ");
        acc = str.concat(acc, value_ir_t(a, f.ret));
        terminate(e, acc);
    } else {
        if b.has_tail {
            const v2: Str = emit_expr_typed(e, b.tail, f.ret);
            if is_terminated(e) == false {
                if ty_is_unit(f.ret) {
                    // A unit fn's tail ran for its effects: bare return.
                    terminate(e, "func.return");
                } else {
                    if str.len(v2) == 0 {
                        if e_ok(e) {
                            e_fail_at(e, 1, 1, "internal: valueless tail in a value-returning function");
                        }
                    } else {
                        var acc2: Str = "func.return ";
                        acc2 = str.concat(acc2, v2);
                        acc2 = str.concat(acc2, " : ");
                        acc2 = str.concat(acc2, value_ir_t(a, f.ret));
                        terminate(e, acc2);
                    }
                }
            }
        } else {
            terminate(e, "func.return");
        }
    }
    }
    scope_pop(e);
    emit_top(e, "}");
}

// The seed's tail-if special case: a trailing `if ... else ...`
// STATEMENT in a value-returning function is its value (emitted once,
// as an expression).
pub fn tail_if_of(s: Stmt) IfE {
    return match s {
        Stmt.If(f) => %IfE{cond: f.cond, then: f.then, has_else: f.has_else, els: f.els},
        _ => %IfE{cond: poison(), then: poison_block(), has_else: false, els: poison_block()},
    };
}

pub fn e_entry(mut e: Emitter, sym: Str) {
    emit_top(e, "func.func @main() -> i64 attributes {llvm.emit_c_interface} {");
    emit_top(e, "  %env = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>");
    emit_top(e, str.concat("  %cl = \"frk_closure.make\"(%env) {callee = @", str.concat(sym, "} : (!frk_adt.product<[]>) -> !frk_closure.fn<[], [i64]>")));
    emit_top(e, "  %args = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>");
    emit_top(e, "  %r = \"frk_closure.apply\"(%cl, %args) : (!frk_closure.fn<[], [i64]>, !frk_adt.product<[]>) -> i64");
    emit_top(e, "  return %r : i64");
    emit_top(e, "}");
}

// Serializes the artifact: header, every block (label line when
// non-empty, lines indented two spaces), newline per line - the
// driver prints each with io.print.
pub fn e_render(mut e: Emitter) [Str] {
    return e.output;
}

// Emitters a whole module: every function, then the entry wrapper when a
// `main` exists (the seed's shape).
// ------------------------------------------------ closures (SPEC 6.4)

pub const LiftS = struct {
    out: [Str],
    nv: i64,
    nb: i64,
    term: bool,
    vt: [VTy],
    rets: [Ty],
    depth: i64,
    capbar: i64,
    caps: [Binding],
    origs: [Binding],
    cenv: Str,
};

pub fn lift_snapshot(mut e: Emitter) LiftS {
    return %LiftS{out: e.output, nv: e.next_value, nb: e.next_block, term: e.terminated, vt: e.value_types, rets: e.return_types, depth: vector.len(e.scopes), capbar: e.capbar, caps: e.caps, origs: e.cap_origs, cenv: e.capenv_ty};
}

pub fn scope_truncate(mut e: Emitter, depth: i64) {
    if vector.len(e.scopes) > depth {
        var kept: Vector(Scope) = vector.new();
        var i: i64 = 0;
        while i < depth {
            vector.push(kept, vector.get(e.scopes, i));
            i = i + 1;
        }
        e.scopes = kept;
    }
}

pub fn lift_restore(mut e: Emitter, s: LiftS) {
    e.output = s.out;
    e.next_value = s.nv;
    e.next_block = s.nb;
    e.terminated = s.term;
    e.value_types = s.vt;
    e.return_types = s.rets;
    e.capbar = s.capbar;
    e.caps = s.caps;
    e.cap_origs = s.origs;
    e.capenv_ty = s.cenv;
    scope_truncate(e, s.depth);
}

pub fn lift_prepare(mut e: Emitter, depth: i64) {
    var fresh_out: Vector(Str) = vector.new();
    e.output = fresh_out;
    e.next_value = 0;
    e.next_block = 0;
    e.terminated = false;
    var fresh_vt: Vector(VTy) = vector.new();
    e.value_types = fresh_vt;
    e.capbar = depth;
    var fresh_caps: Vector(Binding) = vector.new();
    e.caps = fresh_caps;
    var fresh_origs: Vector(Binding) = vector.new();
    e.cap_origs = fresh_origs;
}

pub fn lam_sig(l: LamE) FnSig {
    var ts: Vector(Ty) = vector.new();
    const n: i64 = vector.len(l.params);
    var i: i64 = 0;
    while i < n {
        const prm: Param = vector.get(l.params, i);
        vector.push(ts, prm.ty);
        i = i + 1;
    }
    return %FnSig{params: ts, ret: l.ret};
}

pub fn capenv_ir_e(mut e: Emitter, caps: [Binding]) Str {
    const a: Ast = e_ast(e);
    var parts: Str = "";
    const n: i64 = vector.len(caps);
    var i: i64 = 0;
    while i < n {
        if i > 0 {
            parts = str.concat(parts, ", ");
        }
        const cb: Binding = vector.get(caps, i);
        if cb.cap_kind == "box" {
            parts = str.concat(parts, cb.cap_box);
        } else {
            parts = str.concat(parts, value_ir_t(a, cb.ty));
        }
        i = i + 1;
    }
    var l: Str = "!frk_adt.product<[";
    l = str.concat(l, parts);
    l = str.concat(l, "]>");
    return l;
}

pub fn emit_lifted_lines(mut e: Emitter, lines: [Str]) {
    const n: i64 = vector.len(lines);
    var i: i64 = 0;
    while i < n {
        vector.push(e.lifted, vector.get(lines, i));
        i = i + 1;
    }
}

// `try e` (SPEC 6.5): an Ok/Err union operand; the Err edge returns
// Err(x) from the enclosing function (the same E), the Ok edge yields
// the payload through block arguments.
pub fn emit_try_e(mut e: Emitter, tr: TryX) Str {
    const v: Str = emit_expr(e, tr.expr);
    const oty: Ty = vget(e, v);
    if is_named_t(oty) == false and is_res_t(oty) == false {
        return e_fail_at(e, tr.line, tr.col, "`try` needs an error-union operand");
    }
    const a: Ast = e_ast(e);
    const od: TypeDecl = decl_for(a, oty);
    if od.is_union == false {
        return e_fail_at(e, tr.line, tr.col, "`try` needs an error union (Ok + Err variants)");
    }
    if vector.len(od.variants) != 2 {
        return e_fail_at(e, tr.line, tr.col, "`try` needs an error union (Ok + Err variants)");
    }
    const v0: VariantDecl = vector.get(od.variants, 0);
    const v1: VariantDecl = vector.get(od.variants, 1);
    if v0.name != "Ok" {
        return e_fail_at(e, tr.line, tr.col, "`try` needs an error union (Ok + Err variants)");
    }
    if v1.name != "Err" {
        return e_fail_at(e, tr.line, tr.col, "`try` needs an error union (Ok + Err variants)");
    }
    if v0.has_payload == false {
        return e_fail_at(e, tr.line, tr.col, "`try` needs an error union (Ok + Err variants)");
    }
    if v1.has_payload == false {
        return e_fail_at(e, tr.line, tr.col, "`try` needs an error union (Ok + Err variants)");
    }
    const rty: Ty = e_ret(e);
    if is_named_t(rty) == false and is_res_t(rty) == false {
        return e_fail_at(e, tr.line, tr.col, "the enclosing function must return an error union for `try`");
    }
    const rd: TypeDecl = decl_for(a, rty);
    if rd.is_union == false {
        return e_fail_at(e, tr.line, tr.col, "the enclosing function must return an error union for `try`");
    }
    if vector.len(rd.variants) != 2 {
        return e_fail_at(e, tr.line, tr.col, "the enclosing function must return an error union for `try`");
    }
    const r1: VariantDecl = vector.get(rd.variants, 1);
    if r1.name != "Err" {
        return e_fail_at(e, tr.line, tr.col, "the enclosing function must return an error union for `try`");
    }
    if r1.has_payload == false {
        return e_fail_at(e, tr.line, tr.col, "the enclosing function must return an error union for `try`");
    }
    if same_ty(r1.ty, v1.ty) == false {
        return e_fail_at(e, tr.line, tr.col, "`try` propagates a different error type (use result.mapError)");
    }
    const tag: Str = fresh(e);
    var lt: Str = " = \"frk_adt.tag_of\"(";
    lt = str.concat(lt, v);
    lt = str.concat(lt, ") : (");
    lt = str.concat(lt, value_ir_t(a, oty));
    lt = str.concat(lt, ") -> i64");
    emit_line(e, str.concat(tag, lt));
    const zt: Str = const_i64(e, "0");
    const is_ok: Str = fresh(e);
    emit_line(e, str.concat(is_ok, str.concat(" = arith.cmpi eq, ", str.concat(tag, str.concat(", ", str.concat(zt, " : i64"))))));
    const okb: Str = fresh_label(e);
    const errb: Str = fresh_label(e);
    emit_line(e, str.concat("cf.cond_br ", str.concat(is_ok, str.concat(", ^", str.concat(okb, str.concat(", ^", errb))))));
    new_label(e, okb);
    const stored: Str = fresh(e);
    var l1: Str = " = \"frk_adt.extract\"(";
    l1 = str.concat(l1, v);
    l1 = str.concat(l1, ") {variant = 0 : i64, field = 0 : i64} : (");
    l1 = str.concat(l1, value_ir_t(a, oty));
    l1 = str.concat(l1, ") -> ");
    l1 = str.concat(l1, storage_ir_t(a, v0.ty));
    emit_line(e, str.concat(stored, l1));
    const pv: Str = unwrap_load(e, stored, v0.ty, tr.line, tr.col);
    const join: Str = fresh_label(e);
    const jarg: Str = str.concat("%j", str.fromI64(e.next_block));
    var l2: Str = "cf.br ^";
    l2 = str.concat(l2, join);
    l2 = str.concat(l2, "(");
    l2 = str.concat(l2, pv);
    l2 = str.concat(l2, " : ");
    l2 = str.concat(l2, value_ir_t(a, v0.ty));
    l2 = str.concat(l2, ")");
    terminate(e, l2);
    new_label(e, errb);
    const estored: Str = fresh(e);
    var l3: Str = " = \"frk_adt.extract\"(";
    l3 = str.concat(l3, v);
    l3 = str.concat(l3, ") {variant = 1 : i64, field = 0 : i64} : (");
    l3 = str.concat(l3, value_ir_t(a, oty));
    l3 = str.concat(l3, ") -> ");
    l3 = str.concat(l3, storage_ir_t(a, v1.ty));
    emit_line(e, str.concat(estored, l3));
    const ev: Str = unwrap_load(e, estored, v1.ty, tr.line, tr.col);
    const rw: Str = wrap_store(e, ev, v1.ty, tr.line, tr.col);
    const e0: Str = fresh(e);
    emit_line(e, str.concat(e0, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
    const sn: Str = fresh(e);
    var l4: Str = " = \"frk_adt.product_snoc\"(";
    l4 = str.concat(l4, e0);
    l4 = str.concat(l4, ", ");
    l4 = str.concat(l4, rw);
    l4 = str.concat(l4, ") : (!frk_adt.product<[]>, ");
    l4 = str.concat(l4, storage_ir_t(a, v1.ty));
    l4 = str.concat(l4, ") -> !frk_adt.product<[");
    l4 = str.concat(l4, storage_ir_t(a, v1.ty));
    l4 = str.concat(l4, "]>");
    emit_line(e, str.concat(sn, l4));
    const sm: Str = fresh(e);
    var l5: Str = " = \"frk_adt.make_sum\"(";
    l5 = str.concat(l5, sn);
    l5 = str.concat(l5, ") {variant = 1 : i64} : (!frk_adt.product<[");
    l5 = str.concat(l5, storage_ir_t(a, v1.ty));
    l5 = str.concat(l5, "]>) -> ");
    l5 = str.concat(l5, value_ir_t(a, rty));
    emit_line(e, str.concat(sm, l5));
    terminate(e, str.concat("func.return ", str.concat(sm, str.concat(" : ", value_ir_t(a, rty)))));
    const jfull: Str = str.concat(join, str.concat("(", str.concat(jarg, str.concat(": ", str.concat(value_ir_t(a, v0.ty), ")")))));
    emit_top(e, str.concat("^", str.concat(jfull, ":")));
    e.terminated = false;
    vset(e, jarg, v0.ty);
    return jarg;
}

// `expr catch |e| { ... }` (SPEC 6.5, level 0): the Ok path unwraps;
// the Err path runs the replacement block (the error bound as an
// ordinary local) whose value joins as the unwrapped type; a
// diverging block (the playbook's `catch { return .Err(...) }`)
// needs no join arm.
pub fn emit_catch_e(mut e: Emitter, cx: CatchX) Str {
    const a: Ast = e_ast(e);
    const v: Str = emit_expr(e, cx.expr);
    const oty: Ty = vget(e, v);
    if is_named_t(oty) == false and is_res_t(oty) == false {
        return e_fail_at(e, cx.line, cx.col, "`catch` needs an error-union operand");
    }
    const od: TypeDecl = decl_for(a, oty);
    if od.is_union == false {
        return e_fail_at(e, cx.line, cx.col, "`catch` needs an error union (Ok + Err variants)");
    }
    if vector.len(od.variants) != 2 {
        return e_fail_at(e, cx.line, cx.col, "`catch` needs an error union (Ok + Err variants)");
    }
    const v0: VariantDecl = vector.get(od.variants, 0);
    const v1: VariantDecl = vector.get(od.variants, 1);
    if v0.name != "Ok" or v1.name != "Err" or v0.has_payload == false or v1.has_payload == false {
        return e_fail_at(e, cx.line, cx.col, "`catch` needs an error union (Ok + Err variants)");
    }
    const tag: Str = fresh(e);
    var lt: Str = " = \"frk_adt.tag_of\"(";
    lt = str.concat(lt, v);
    lt = str.concat(lt, ") : (");
    lt = str.concat(lt, value_ir_t(a, oty));
    lt = str.concat(lt, ") -> i64");
    emit_line(e, str.concat(tag, lt));
    const is_ok: Str = fresh(e);
    var le: Str = " = arith.cmpi eq, ";
    le = str.concat(le, tag);
    le = str.concat(le, ", ");
    le = str.concat(le, const_i64(e, "0"));
    le = str.concat(le, " : i64");
    emit_line(e, str.concat(is_ok, le));
    const okb: Str = fresh_label(e);
    const errb: Str = fresh_label(e);
    emit_line(e, str.concat("cf.cond_br ", str.concat(is_ok, str.concat(", ^", str.concat(okb, str.concat(", ^", errb))))));
    new_label(e, okb);
    const stored: Str = fresh(e);
    var l1: Str = " = \"frk_adt.extract\"(";
    l1 = str.concat(l1, v);
    l1 = str.concat(l1, ") {variant = 0 : i64, field = 0 : i64} : (");
    l1 = str.concat(l1, value_ir_t(a, oty));
    l1 = str.concat(l1, ") -> ");
    l1 = str.concat(l1, storage_ir_t(a, v0.ty));
    emit_line(e, str.concat(stored, l1));
    const pv: Str = unwrap_load(e, stored, v0.ty, cx.line, cx.col);
    const join: Str = fresh_label(e);
    const jarg: Str = str.concat("%j", str.fromI64(e.next_block));
    var l2: Str = "cf.br ^";
    l2 = str.concat(l2, join);
    l2 = str.concat(l2, "(");
    l2 = str.concat(l2, pv);
    l2 = str.concat(l2, " : ");
    l2 = str.concat(l2, value_ir_t(a, v0.ty));
    l2 = str.concat(l2, ")");
    terminate(e, l2);
    new_label(e, errb);
    const estored: Str = fresh(e);
    var l3: Str = " = \"frk_adt.extract\"(";
    l3 = str.concat(l3, v);
    l3 = str.concat(l3, ") {variant = 1 : i64, field = 0 : i64} : (");
    l3 = str.concat(l3, value_ir_t(a, oty));
    l3 = str.concat(l3, ") -> ");
    l3 = str.concat(l3, storage_ir_t(a, v1.ty));
    emit_line(e, str.concat(estored, l3));
    const ev: Str = unwrap_load(e, estored, v1.ty, cx.line, cx.col);
    scope_push(e);
    if str.len(cx.bind) > 0 {
        declare(e, %Binding{name: cx.bind, is_box: false, ty: v1.ty, id: ev, box: ""});
        vset(e, ev, v1.ty);
    }
    const bv: Str = emit_block_expr(e, cx.block);
    scope_pop(e);
    if is_terminated(e) == false {
        if str.len(bv) == 0 {
            return e_fail_at(e, cx.line, cx.col, "the catch block must produce a value or diverge");
        }
        if same_ty(vget(e, bv), v0.ty) == false {
            return e_fail_at(e, cx.line, cx.col, "the catch block yields a different type than the union's Ok payload");
        }
        var l4: Str = "cf.br ^";
        l4 = str.concat(l4, join);
        l4 = str.concat(l4, "(");
        l4 = str.concat(l4, bv);
        l4 = str.concat(l4, " : ");
        l4 = str.concat(l4, value_ir_t(a, v0.ty));
        l4 = str.concat(l4, ")");
        terminate(e, l4);
    }
    const jfull: Str = str.concat(join, str.concat("(", str.concat(jarg, str.concat(": ", str.concat(value_ir_t(a, v0.ty), ")")))));
    emit_top(e, str.concat("^", str.concat(jfull, ":")));
    e.terminated = false;
    vset(e, jarg, v0.ty);
    return jarg;
}

pub fn emit_tuple_e(mut e: Emitter, items: Vector(Expr), expected: Ty) Str {
    const a: Ast = e_ast(e);
    var exp_tys: Vector(Ty) = vector.new();
    var has_exp: bool = false;
    match expected {
        Ty.Tup(tys) => {
            exp_tys = tys;
            has_exp = true;
        },
        _ => {},
    };
    const n: i64 = vector.len(items);
    const e0a: Str = fresh(e);
    emit_line(e, str.concat(e0a, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
    var acc: Str = e0a;
    var el_tys: Vector(Ty) = vector.new();
    var el_irs: Vector(Str) = vector.new();
    var i: i64 = 0;
    while i < n {
        var v: Str = "";
        var vt: Ty = Ty.UnitV;
        if has_exp and i < vector.len(exp_tys) {
            vt = vector.get(exp_tys, i);
            v = emit_expr_typed(e, vector.get(items, i), vt);
        } else {
            v = emit_expr(e, vector.get(items, i));
            vt = vget(e, v);
        }
        const stored: Str = wrap_store(e, v, vt, 0, 0);
        vector.push(el_tys, vt);
        vector.push(el_irs, storage_ir_t(a, vt));
        var pt_new: Str = "!frk_adt.product<[";
        var j: i64 = 0;
        while j <= i {
            if j > 0 {
                pt_new = str.concat(pt_new, ", ");
            }
            pt_new = str.concat(pt_new, vector.get(el_irs, j));
            j = j + 1;
        }
        pt_new = str.concat(pt_new, "]>");
        const sn: Str = fresh(e);
        var l: Str = " = \"frk_adt.product_snoc\"(";
        l = str.concat(l, acc);
        l = str.concat(l, ", ");
        l = str.concat(l, stored);
        l = str.concat(l, ") : (");
        if i == 0 {
            l = str.concat(l, "!frk_adt.product<[]>");
        } else {
            var pt_prev: Str = "!frk_adt.product<[";
            var k: i64 = 0;
            while k < i {
                if k > 0 {
                    pt_prev = str.concat(pt_prev, ", ");
                }
                pt_prev = str.concat(pt_prev, vector.get(el_irs, k));
                k = k + 1;
            }
            pt_prev = str.concat(pt_prev, "]>");
            l = str.concat(l, pt_prev);
        }
        l = str.concat(l, ", ");
        l = str.concat(l, storage_ir_t(a, vt));
        l = str.concat(l, ") -> ");
        l = str.concat(l, pt_new);
        emit_line(e, str.concat(sn, l));
        acc = sn;
        i = i + 1;
    }
    vset(e, acc, Ty.Tup(el_tys));
    return acc;
}

pub fn emit_index_e(mut e: Emitter, ix: IdxE) Str {
    const br: Ref = ix.base;
    if str.len(br.mod) != 0 {
        return e_fail_at(e, 0, 0, "indexing needs a named base (slice)");
    }
    const b: Binding = lookup(e, br.name);
    if b.name == "" {
        return e_fail_at(e, 0, 0, str.concat("unknown name `", str.concat(br.name, "`")));
    }
    var aty: Ty = poison_ty();
    var n2: i64 = 0;
    var ety: Ty = poison_ty();
    var is_arr2: bool = false;
    const bty2: Ty = b.ty;
    match bty2 {
        Ty.ArrT(a2) => {
            aty = bty2;
            n2 = a2.n;
            ety = a2.ty;
            is_arr2 = true;
        },
        _ => {},
    };
    if is_arr2 == false {
        return e_fail_at(e, 0, 0, "indexing needs a fixed array ([N]T) base");
    }
    const a: Ast = e_ast(e);
    const val: Str = read_binding(e, b);
    const iv: Str = emit_expr(e, ix.idx);
    const out: Str = fresh(e);
    var l: Str = " = \"frk_mem.array_get\"(";
    l = str.concat(l, val);
    l = str.concat(l, ", ");
    l = str.concat(l, iv);
    l = str.concat(l, ") : (");
    l = str.concat(l, value_ir_t(a, aty));
    l = str.concat(l, ", i64) -> ");
    l = str.concat(l, storage_ir_t(a, ety));
    emit_line(e, str.concat(out, l));
    return unwrap_load(e, out, ety, 0, 0);
}

pub fn emit_lambda_expr(mut e: Emitter, l: LamE) Str {
    const npg: i64 = vector.len(l.params);
    var pgi: i64 = 0;
    while pgi < npg {
        const pg: Param = vector.get(l.params, pgi);
        if ty_is_hole(pg.ty) {
            return e_fail_at(e, 0, 0, "cannot infer this closure's parameter types; annotate them, or place the closure where a fn type is expected");
        }
        pgi = pgi + 1;
    }
    if ty_is_hole(l.ret) {
        return e_fail_at(e, 0, 0, "cannot infer this closure's return type; annotate it, or place the closure where a fn type is expected");
    }
    const n: i64 = e.lams;
    e.lams = n + 1;
    const sym: Str = str.concat("__calque_lam_", str.fromI64(n));
    var lps: Vector(Param) = vector.new();
    const nlp: i64 = vector.len(l.params);
    var lpi: i64 = 0;
    while lpi < nlp {
        const lp: Param = vector.get(l.params, lpi);
        vector.push(lps, %Param{name: lp.name, ty: tv_res(e, lp.ty), mut: lp.mut, is_comptime: false});
        lpi = lpi + 1;
    }
    const lret0: Ty = tv_res(e, l.ret);
    const fake: Fn = %Fn{name: sym, params: lps, ret: lret0, body: l.body, file: e_file(e), ns: "", test_name: ""};
    // the return_types CELL is mutated in place (vector.set), so the
    // lift snapshot aliases it: save/restore the enclosing ret
    // explicitly around the closure's emission.
    const old_ret: Ty = e_ret(e);
    const s1: LiftS = lift_snapshot(e);
    // the closure's OWN return type types its `return` statements.
    e_ret_set(e, lret0);
    lift_prepare(e, s1.depth);
    e.capenv_ty = "!frk_adt.product<[]>";
    e_fn_core(e, fake);
    const caps1: [Binding] = e.caps;
    const origs1: [Binding] = e.cap_origs;
    lift_restore(e, s1);
    const env_ty: Str = capenv_ir_e(e, caps1);
    const s2: LiftS = lift_snapshot(e);
    e_ret_set(e, lret0);
    lift_prepare(e, s2.depth);
    e.capenv_ty = env_ty;
    e_fn_core(e, fake);
    const lifted: [Str] = e.output;
    lift_restore(e, s2);
    e_ret_set(e, old_ret);
    emit_lifted_lines(e, lifted);
    const a: Ast = e_ast(e);
    const e0: Str = fresh(e);
    emit_line(e, str.concat(e0, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
    var acc: Str = e0;
    var acc_ty: Str = "!frk_adt.product<[]>";
    var fields: Str = "";
    const nc: i64 = vector.len(caps1);
    var i: i64 = 0;
    while i < nc {
        const cb: Binding = vector.get(caps1, i);
        const ob: Binding = vector.get(origs1, i);
        const slot: Str = binding_slot(e, ob);
        var st: Str = value_ir_t(a, cb.ty);
        if cb.cap_kind == "box" {
            st = cb.cap_box;
        }
        if i > 0 {
            fields = str.concat(fields, ", ");
        }
        fields = str.concat(fields, st);
        const nxt: Str = fresh(e);
        var l2: Str = " = \"frk_adt.product_snoc\"(";
        l2 = str.concat(l2, acc);
        l2 = str.concat(l2, ", ");
        l2 = str.concat(l2, slot);
        l2 = str.concat(l2, ") : (");
        l2 = str.concat(l2, acc_ty);
        l2 = str.concat(l2, ", ");
        l2 = str.concat(l2, st);
        l2 = str.concat(l2, ") -> !frk_adt.product<[");
        l2 = str.concat(l2, fields);
        l2 = str.concat(l2, "]>");
        emit_line(e, str.concat(nxt, l2));
        acc = nxt;
        acc_ty = str.concat("!frk_adt.product<[", str.concat(fields, "]>"));
        i = i + 1;
    }
    const cl: Str = fresh(e);
    const sig: FnSig = lam_sig(l);
    var l3: Str = " = \"frk_closure.make\"(";
    l3 = str.concat(l3, acc);
    l3 = str.concat(l3, ") {callee = @");
    l3 = str.concat(l3, sym);
    l3 = str.concat(l3, "} : (");
    l3 = str.concat(l3, acc_ty);
    l3 = str.concat(l3, ") -> ");
    l3 = str.concat(l3, fn_ir_t(a, sig));
    emit_line(e, str.concat(cl, l3));
    vset(e, cl, Ty.FnT(sig));
    return cl;
}

pub fn emit_module(mut e: Emitter, a: Ast) {
    e_ast_set(e, a);
    var has_main: bool = false;
    var main_ok: bool = true;
    const nf: i64 = vector.len(a.fns);
    var i: i64 = 0;
    var test_i: i64 = 0;
    while i < nf {
        const f: Fn = vector.get(a.fns, i);
        if is_generic_fn(f) {
            // D-113: instances are emitted by the flush below.
        } else {
            var is_test_fn: bool = false;
            if str.len(f.name) >= 14 {
                if str.sub(f.name, 0, 14) == "__calque_test_" {
                    is_test_fn = true;
                }
            }
            if is_test_fn {
                vector.push(e.output, str.concat("// test: ", f.test_name));
            }
            e_fn(e, f);
            if is_test_fn {
                // a runner entry per test (no envref argument)
                test_i = test_i + 1;
                var w: Str = "func.func @__calque_test_entry_";
                w = str.concat(w, str.fromI64(test_i));
                w = str.concat(w, "() -> i64 {");
                vector.push(e.output, w);
                vector.push(e.output, "  %env = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>");
                var w2: Str = "  %cl = \"frk_closure.make\"(%env) {callee = @";
                w2 = str.concat(w2, f.name);
                w2 = str.concat(w2, "} : (!frk_adt.product<[]>) -> !frk_closure.fn<[], [i64]>");
                vector.push(e.output, w2);
                vector.push(e.output, "  %args = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>");
                vector.push(e.output, "  %r = \"frk_closure.apply\"(%cl, %args) : (!frk_closure.fn<[], [i64]>, !frk_adt.product<[]>) -> i64");
                vector.push(e.output, "  return %r : i64");
                vector.push(e.output, "}");
            }
        }
        if f.name == "main" {
            has_main = true;
            if ty_is_i64(f.ret) == false {
                main_ok = false;
            }
        }
        i = i + 1;
    }
    if has_main == false {
        const _x: Str = e_fail_at(e, 1, 1, "the unit has no `pub fn main() i64` entry");
    } else {
        if main_ok == false {
            const _y: Str = e_fail_at(e, 1, 1, "seed v0 requires `fn main()` returning i64");
        } else {
            e_entry(e, "__calque_main");
        }
    }
    // The lifted closures and the generic instances follow the entry,
    // in waves (lams first, then instances; repeat while either queue
    // grows) - mirroring the seed's flush order byte for byte.
    var wave: bool = true;
    while wave {
        wave = false;
        const nlift: i64 = vector.len(e.lifted);
        if nlift > 0 {
            var li: i64 = 0;
            while li < nlift {
                vector.push(e.output, vector.get(e.lifted, li));
                li = li + 1;
            }
            var fresh_lift: Vector(Str) = vector.new();
            e.lifted = fresh_lift;
            wave = true;
        }
        const ninst: i64 = vector.len(e.instq);
        if ninst > 0 {
            const old_q: Vector(InstE) = e.instq;
            var fresh_q: Vector(InstE) = vector.new();
            e.instq = fresh_q;
            var qi: i64 = 0;
            while qi < ninst {
                const qe: InstE = vector.get(old_q, qi);
                const saved: [TV] = e.tvars;
                e.tvars = qe.sub;
                e_fn(e, qe.f);
                e.tvars = saved;
                qi = qi + 1;
            }
            wave = true;
        }
    }
}

pub fn emit_tyv(mut e: Emitter, tx: Ty) Str {
    const _x: Str = e_fail_at(e, 0, 0, "a type value is only valid as an instantiation argument (D-113)");
    return "";
}

// ---------------------------------------------------------------- 3b core
// Scopes, bindings, and the type helpers the statements need. Bindings
// are VALUES in a per-scope vector (the cell exception covers the
// emitter's mutable state, D-109).

pub const Binding = struct {
    name: Str,
    is_box: bool,
    ty: Ty,
    id: Str,
    box: Str,
    is_cap: bool = false,
    cap_idx: i64 = 0,
    cap_kind: Str = "",
    cap_box: Str = "",
};

pub const Scope = struct {
    entries: Vector(Binding),
};

pub fn empty_scope() Scope {
    var entries: Vector(Binding) = vector.new();
    return %Scope{entries: entries};
}

pub fn lookup(mut e: Emitter, name: Str) Binding {
    const sc: Vector(Scope) = e.scopes;
    var i: i64 = vector.len(sc);
    while i > 0 {
        const s: Scope = vector.get(sc, i - 1);
        var j: i64 = vector.len(s.entries);
        while j > 0 {
            const b: Binding = vector.get(s.entries, j - 1);
            if b.name == name {
                if i - 1 < e.capbar {
                    return record_capture(e, name, b);
                }
                return b;
            }
            j = j - 1;
        }
        i = i - 1;
    }
    return %Binding{name: "", is_box: false, ty: Ty.UnitV, id: "", box: ""};
}

pub fn record_capture(mut e: Emitter, name: Str, b: Binding) Binding {
    const caps: Vector(Binding) = e.caps;
    const n: i64 = vector.len(caps);
    var i: i64 = 0;
    while i < n {
        const cb: Binding = vector.get(caps, i);
        if cb.name == name {
            return cb;
        }
        i = i + 1;
    }
    var ck: Str = "ssa";
    if b.is_box {
        ck = "box";
    }
    const bx: Str = box_ir_t(e_ast(e), b.ty);
    const proxy: Binding = %Binding{name: name, is_box: true, ty: b.ty, id: "", box: bx, is_cap: true, cap_idx: n, cap_kind: ck, cap_box: bx};
    vector.push(caps, proxy);
    vector.push(e.cap_origs, b);
    return proxy;
}

pub fn declare(mut e: Emitter, b: Binding) {
    const sc: Vector(Scope) = e.scopes;
    const s: Scope = vector.get(sc, vector.len(sc) - 1);
    vector.push(s.entries, b);
}

// Type environment: the AST's declarations (linear scan; calq0's own
// scale is small by construction).
// The virtual union decls of the structural shorthands (SPEC 6.5);
// the match/variant/try machinery reads decls uniformly.
pub fn synth_td(t: Ty) TypeDecl {
    return match t {
        Ty.OptT(inner) => synth_opt_td(inner),
        Ty.ResT(rz) => synth_res_td(rz),
        _ => synth_empty_td(),
    };
}

pub fn synth_empty_td() TypeDecl {
    var fs: Vector(FieldDecl) = vector.new();
    var vs: Vector(VariantDecl) = vector.new();
    return %TypeDecl{name: "", is_union: false, fields: fs, variants: vs};
}

pub fn synth_opt_td(inner: Ty) TypeDecl {
    var fs: Vector(FieldDecl) = vector.new();
    var vs: Vector(VariantDecl) = vector.new();
    vector.push(vs, %VariantDecl{name: "Some", has_payload: true, ty: inner});
    vector.push(vs, %VariantDecl{name: "None", has_payload: false, ty: Ty.UnitV});
    return %TypeDecl{name: "", is_union: true, fields: fs, variants: vs};
}

pub fn synth_res_td(rz: ResTT) TypeDecl {
    var fs: Vector(FieldDecl) = vector.new();
    var vs: Vector(VariantDecl) = vector.new();
    vector.push(vs, %VariantDecl{name: "Ok", has_payload: true, ty: rz.ok});
    vector.push(vs, %VariantDecl{name: "Err", has_payload: true, ty: rz.err});
    return %TypeDecl{name: "", is_union: true, fields: fs, variants: vs};
}

pub fn decl_for(a: Ast, t: Ty) TypeDecl {
    if is_named_t(t) {
        return find_td(a, named_of(t));
    }
    return synth_td(t);
}

pub fn find_td(a: Ast, name: Str) TypeDecl {
    const n: i64 = vector.len(a.types);
    var i: i64 = 0;
    while i < n {
        const td: TypeDecl = vector.get(a.types, i);
        if td.name == name {
            return td;
        }
        i = i + 1;
    }
    return %TypeDecl{name: "", is_union: false, fields: vector_new_fd(), variants: vector_new_vd()};
}

pub fn vector_new_fd() Vector(FieldDecl) {
    var v: Vector(FieldDecl) = vector.new();
    return v;
}

pub fn vector_new_vd() Vector(VariantDecl) {
    var v: Vector(VariantDecl) = vector.new();
    return v;
}

pub fn named_ok(a: Ast, n: Str) bool {
    const td: TypeDecl = find_td(a, n);
    return td.name != "";
}

pub fn typed_ok(a: Ast, ty: Ty) bool {
    return match ty {
        Ty.Named(n) => named_ok(a, n),
        _ => true,
    };
}

pub fn ir_ty(t: Ty) Str {
    return match t {
        Ty.I64 => "i64",
        Ty.BoolV => "i1",
        Ty.StrV => "!frk_bstr.str",
        Ty.UnitV => "",
        Ty.Named(n) => n,
        Ty.Vec(inner) => "vec",
        Ty.OptT(inner) => "opt",
        Ty.ResT(rz) => "res",
        Ty.Tup(tys) => "tup",
        Ty.ArrT(a2) => "arr",
        Ty.FnT(sig) => "fn",
        Ty.TyBad(b) => "bad",
    };
}

// storage_ir mirrors the seed: named types erase to recref; vectors
// keep their box; builtins map directly.
pub fn storage_ir_t(a: Ast, t: Ty) Str {
    return match t {
        Ty.Named(n) => "!frk_mem.recref",
        Ty.Vec(inner) => value_ir_t(a, t),
        Ty.OptT(inner) => value_ir_t(a, t),
        Ty.ResT(rz) => value_ir_t(a, t),
        Ty.Tup(tys) => value_ir_t(a, t),
        Ty.ArrT(a2) => value_ir_t(a, t),
        Ty.FnT(sig) => fn_ir_t(a, sig),
        _ => ir_ty(t),
    };
}

pub fn parse_slot_e(s: Str) i64 {
    const n: i64 = str.len(s);
    if n == 0 {
        return 0 - 1;
    }
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        const c: Str = str.sub(s, i, i + 1);
        if c == "0" {
            acc = acc * 10;
        } else {
            if c == "1" {
                acc = acc * 10 + 1;
            } else {
                if c == "2" {
                    acc = acc * 10 + 2;
                } else {
                    if c == "3" {
                        acc = acc * 10 + 3;
                    } else {
                        if c == "4" {
                            acc = acc * 10 + 4;
                        } else {
                            if c == "5" {
                                acc = acc * 10 + 5;
                            } else {
                                if c == "6" {
                                    acc = acc * 10 + 6;
                                } else {
                                    if c == "7" {
                                        acc = acc * 10 + 7;
                                    } else {
                                        if c == "8" {
                                            acc = acc * 10 + 8;
                                        } else {
                                            if c == "9" {
                                                acc = acc * 10 + 9;
                                            } else {
                                                return 0 - 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return acc;
}

pub fn tup_ir(a: Ast, tys: Vector(Ty)) Str {
    var acc: Str = "!frk_adt.product<[";
    const n: i64 = vector.len(tys);
    var i: i64 = 0;
    while i < n {
        if i > 0 {
            acc = str.concat(acc, ", ");
        }
        acc = str.concat(acc, storage_ir_t(a, vector.get(tys, i)));
        i = i + 1;
    }
    return str.concat(acc, "]>");
}

pub fn value_ir_t(a: Ast, t: Ty) Str {
    return match t {
        Ty.Named(n) => named_value_ir(a, n),
        Ty.Vec(inner) => vec_box(a, inner),
        Ty.OptT(inner) => str.concat("!frk_adt.sum<[[", str.concat(storage_ir_t(a, inner), "], []]>")),
        Ty.Tup(tys) => tup_ir(a, tys),
        Ty.ArrT(a2) => str.concat("!frk_mem.arr<", str.concat(storage_ir_t(a, a2.ty), ">")),
        Ty.ResT(rz) => str.concat("!frk_adt.sum<[[", str.concat(storage_ir_t(a, rz.ok), str.concat("], [", str.concat(storage_ir_t(a, rz.err), "]]>")))),
        Ty.FnT(sig) => fn_ir_t(a, sig),
        _ => ir_ty(t),
    };
}

pub fn fn_ir_t(a: Ast, sig: FnSig) Str {
    var ps: Str = "";
    const n: i64 = vector.len(sig.params);
    var i: i64 = 0;
    while i < n {
        if i > 0 {
            ps = str.concat(ps, ", ");
        }
        ps = str.concat(ps, value_ir_t(a, vector.get(sig.params, i)));
        i = i + 1;
    }
    var l: Str = "!frk_closure.fn<[";
    l = str.concat(l, ps);
    l = str.concat(l, "], [");
    l = str.concat(l, value_ir_t(a, sig.ret));
    l = str.concat(l, "]>");
    return l;
}

pub fn named_value_ir(a: Ast, n: Str) Str {
    const td: TypeDecl = find_td(a, n);
    if td.is_union == false {
        return str.concat("!frk_mem.box<", str.concat(product_ir(a, td), ">"));
    }
    return sum_ir(a, td);
}

pub fn product_ir(a: Ast, td: TypeDecl) Str {
    var parts: Str = "";
    const nf: i64 = vector.len(td.fields);
    var i: i64 = 0;
    while i < nf {
        const f: FieldDecl = vector.get(td.fields, i);
        if i > 0 {
            parts = str.concat(parts, ", ");
        }
        parts = str.concat(parts, storage_ir_t(a, f.ty));
        i = i + 1;
    }
    return str.concat("!frk_adt.product<[", str.concat(parts, "]>"));
}

pub fn sum_ir(a: Ast, td: TypeDecl) Str {
    var parts: Str = "";
    const nv: i64 = vector.len(td.variants);
    var i: i64 = 0;
    while i < nv {
        const v: VariantDecl = vector.get(td.variants, i);
        if i > 0 {
            parts = str.concat(parts, ", ");
        }
        if v.has_payload {
            parts = str.concat(parts, str.concat("[", str.concat(storage_ir_t(a, v.ty), "]")));
        } else {
            parts = str.concat(parts, "[]");
        }
        i = i + 1;
    }
    return str.concat("!frk_adt.sum<[", str.concat(parts, "]>"));
}

pub fn box_ir_t(a: Ast, t: Ty) Str {
    return str.concat("!frk_mem.box<", str.concat(value_ir_t(a, t), ">"));
}

pub fn vec_slot_ir(t: Ty) Str {
    return match t {
        Ty.I64 => "i64",
        Ty.StrV => "!frk_bstr.str",
        Ty.Named(n) => "!frk_mem.recref",
        _ => "bad",
    };
}

pub fn vec_prefix(t: Ty) Str {
    return match t {
        Ty.I64 => "__calque_vector_i64",
        Ty.StrV => "__calque_vector_bstr",
        Ty.Named(n) => "__calque_vector_box",
        _ => "__calque_vector_bad",
    };
}

pub fn vec_box(a: Ast, inner: Ty) Str {
    var acc: Str = "!frk_mem.box<!frk_adt.product<[!frk_mem.arr<";
    acc = str.concat(acc, vec_slot_ir(inner));
    acc = str.concat(acc, ">, i64, i64]>>");
    return acc;
}

pub fn field_index(td: TypeDecl, name: Str) i64 {
    const nf: i64 = vector.len(td.fields);
    var i: i64 = 0;
    while i < nf {
        const f: FieldDecl = vector.get(td.fields, i);
        if f.name == name {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- values
// The seed's E.vtypes convention: ids returned, types tracked beside
// them. One lookup table per emission context.

pub const VTy = struct {
    id: Str,
    ty: Ty,
};

pub fn vset(mut e: Emitter, id: Str, ty: Ty) {
    vector.push(e.value_types, %VTy{id: id, ty: ty});
}

pub fn vget(mut e: Emitter, id: Str) Ty {
    const n: i64 = vector.len(e.value_types);
    var i: i64 = n;
    while i > 0 {
        const vt: VTy = vector.get(e.value_types, i - 1);
        if vt.id == id {
            return vt.ty;
        }
        i = i - 1;
    }
    return Ty.UnitV;
}

pub fn e_ret(mut e: Emitter) Ty {
    return vector.get(e.return_types, 0);
}

pub fn e_file(mut e: Emitter) Str {
    return vector.get(e.files, 0);
}

pub fn loc_msg(mut e: Emitter, line: i64, col: i64, code: Str, what: Str) Str {
    var acc: Str = str.concat(e_file(e), ":");
    acc = str.concat(acc, str.fromI64(line));
    acc = str.concat(acc, ":");
    acc = str.concat(acc, str.fromI64(col));
    acc = str.concat(acc, ": error: ");
    acc = str.concat(acc, code);
    acc = str.concat(acc, ": ");
    acc = str.concat(acc, what);
    return acc;
}

// A terminating poison value for the unreachable arms of emitted traps
// (mirrors the seed's poison(): builtins as constants, named types as
// empty boxes, vectors as the mirrored intrinsic's terminator).
pub fn e_poison(mut e: Emitter, t: Ty) Str {
    const unit_t: Ty = t;
    return match unit_t {
        Ty.I64 => e_int(e, "0"),
        Ty.BoolV => e_bool(e, "false"),
        Ty.StrV => e_str(e, ""),
        Ty.OptT(inner) => poison_variant(e, inner, t),
        Ty.ResT(rz) => poison_variant(e, rz.ok, t),
        Ty.Tup(tys) => poison_tup(e, tys, t),
        Ty.ArrT(a2) => poison_arr(e, a2, t),
        _ => named_poison(e, t),
    };
}

pub fn poison_arr(mut e: Emitter, a2: ArrTT, arr_ty: Ty) Str {
    const av: Str = fresh(e);
    const nl: Str = const_i64(e, str.fromI64(a2.n));
    var l: Str = " = \"frk_mem.array_new\"(";
    l = str.concat(l, nl);
    l = str.concat(l, ") : (i64) -> ");
    l = str.concat(l, value_ir_t(e_ast(e), arr_ty));
    emit_line(e, str.concat(av, l));
    vset(e, av, arr_ty);
    return av;
}

pub fn poison_tup(mut e: Emitter, tys: Vector(Ty), sum_ty: Ty) Str {
    const a: Ast = e_ast(e);
    const n: i64 = vector.len(tys);
    var acc: Str = "";
    var pt_prev: Str = "";
    var i: i64 = 0;
    while i < n {
        const sty: Ty = vector.get(tys, i);
        const p: Str = e_poison(e, sty);
        var from: Str = "";
        if i == 0 {
            from = fresh(e);
            emit_line(e, str.concat(from, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
            pt_prev = "!frk_adt.product<[]>";
        } else {
            from = acc;
        }
        const stored: Str = wrap_store(e, p, sty, 0, 0);
        var pt_new: Str = "!frk_adt.product<[";
        var j: i64 = 0;
        while j <= i {
            if j > 0 {
                pt_new = str.concat(pt_new, ", ");
            }
            pt_new = str.concat(pt_new, storage_ir_t(a, vector.get(tys, j)));
            j = j + 1;
        }
        pt_new = str.concat(pt_new, "]>");
        const sn: Str = fresh(e);
        var l: Str = " = \"frk_adt.product_snoc\"(";
        l = str.concat(l, from);
        l = str.concat(l, ", ");
        l = str.concat(l, stored);
        l = str.concat(l, ") : (");
        l = str.concat(l, pt_prev);
        l = str.concat(l, ", ");
        l = str.concat(l, storage_ir_t(a, sty));
        l = str.concat(l, ") -> ");
        l = str.concat(l, pt_new);
        emit_line(e, str.concat(sn, l));
        acc = sn;
        pt_prev = pt_new;
        i = i + 1;
    }
    vset(e, acc, sum_ty);
    return acc;
}

// Variant-0 (Some/Ok) carry with a poisoned payload, for a structural
// union's unreachable arms.
pub fn poison_variant(mut e: Emitter, payload_ty: Ty, sum_ty: Ty) Str {
    const a: Ast = e_ast(e);
    const p: Str = e_poison(e, payload_ty);
    const stored: Str = wrap_store(e, p, payload_ty, 0, 0);
    const sty: Str = storage_ir_t(a, payload_ty);
    const e0: Str = fresh(e);
    emit_line(e, str.concat(e0, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
    const prod: Str = fresh(e);
    var l1: Str = " = \"frk_adt.product_snoc\"(";
    l1 = str.concat(l1, e0);
    l1 = str.concat(l1, ", ");
    l1 = str.concat(l1, stored);
    l1 = str.concat(l1, ") : (!frk_adt.product<[]>, ");
    l1 = str.concat(l1, sty);
    l1 = str.concat(l1, ") -> !frk_adt.product<[");
    l1 = str.concat(l1, sty);
    l1 = str.concat(l1, "]>");
    emit_line(e, str.concat(prod, l1));
    const s: Str = fresh(e);
    var l2: Str = " = \"frk_adt.make_sum\"(";
    l2 = str.concat(l2, prod);
    l2 = str.concat(l2, ") {variant = 0 : i64} : (!frk_adt.product<[");
    l2 = str.concat(l2, sty);
    l2 = str.concat(l2, "]>) -> ");
    l2 = str.concat(l2, value_ir_t(a, sum_ty));
    emit_line(e, str.concat(s, l2));
    vset(e, s, sum_ty);
    return s;
}

pub fn named_poison(mut e: Emitter, t: Ty) Str {
    return match t {
        Ty.Named(n) => named_poison_box(e, n),
        Ty.Vec(inner) => named_poison_vec(e, inner),
        _ => e_int(e, "0"),
    };
}

pub fn named_poison_vec(mut e: Emitter, inner: Ty) Str {
    const v: Str = fresh(e);
    emit_line(e, str.concat(v, str.concat(" = func.call @", str.concat(vec_prefix(inner), str.concat("_new() : () -> ", vec_box(e_ast(e), inner))))));
    return v;
}

pub fn named_poison_box(mut e: Emitter, n: Str) Str {
    // The seed's poison(), mirrored: a struct poison is a box of a
    // product of STORAGE poisons (named fields = recref_null, others
    // recurse through e_poison); a union poison is variant 0's
    // product, storage-poisoned.
    const a: Ast = e_ast(e);
    const td: TypeDecl = find_td(a, n);
    const sty: Ty = Ty.Named(td.name);
    if td.is_union == false {
        const e0: Str = fresh(e);
        emit_line(e, str.concat(e0, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
        var acc: Str = e0;
        var acc_fields: Str = "";
        var acc_ty: Str = "!frk_adt.product<[]>";
        const nf: i64 = vector.len(td.fields);
        var j: i64 = 0;
        while j < nf {
            const f: FieldDecl = vector.get(td.fields, j);
            var val: Str = "";
            var st: Str = "";
            if is_named_t(f.ty) {
                val = fresh(e);
                emit_line(e, str.concat(val, " = \"frk_mem.recref_null\"() : () -> !frk_mem.recref"));
                st = "!frk_mem.recref";
            } else {
                val = e_poison(e, f.ty);
                st = storage_ir_t(a, f.ty);
            }
            var new_fields: Str = st;
            if j > 0 {
                new_fields = str.concat(acc_fields, str.concat(", ", st));
            }
            const new_ty: Str = str.concat("!frk_adt.product<[", str.concat(new_fields, "]>"));
            const nxt: Str = fresh(e);
            var l1: Str = " = \"frk_adt.product_snoc\"(";
            l1 = str.concat(l1, acc);
            l1 = str.concat(l1, ", ");
            l1 = str.concat(l1, val);
            l1 = str.concat(l1, ") : (");
            l1 = str.concat(l1, acc_ty);
            l1 = str.concat(l1, ", ");
            l1 = str.concat(l1, st);
            l1 = str.concat(l1, ") -> ");
            l1 = str.concat(l1, new_ty);
            emit_line(e, str.concat(nxt, l1));
            acc = nxt;
            acc_fields = new_fields;
            acc_ty = new_ty;
            j = j + 1;
        }
        const b: Str = fresh(e);
        emit_line(e, str.concat(b, str.concat(" = \"frk_mem.box_new\"(", str.concat(acc, str.concat(") : (", str.concat(acc_ty, str.concat(") -> !frk_mem.box<", str.concat(acc_ty, ">"))))))));
        return b;
    }
    const v0: VariantDecl = vector.get(td.variants, 0);
    var prod_v: Str = "";
    var prod_t: Str = "!frk_adt.product<[]>";
    if v0.has_payload == false {
        prod_v = fresh(e);
        emit_line(e, str.concat(prod_v, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
    } else {
        var val: Str = "";
        var st: Str = "";
        if is_named_t(v0.ty) {
            val = fresh(e);
            emit_line(e, str.concat(val, " = \"frk_mem.recref_null\"() : () -> !frk_mem.recref"));
            st = "!frk_mem.recref";
        } else {
            val = e_poison(e, v0.ty);
            st = storage_ir_t(a, v0.ty);
        }
        const e1: Str = fresh(e);
        emit_line(e, str.concat(e1, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
        const sn: Str = fresh(e);
        var l1: Str = " = \"frk_adt.product_snoc\"(";
        l1 = str.concat(l1, e1);
        l1 = str.concat(l1, ", ");
        l1 = str.concat(l1, val);
        l1 = str.concat(l1, ") : (!frk_adt.product<[]>, ");
        l1 = str.concat(l1, st);
        l1 = str.concat(l1, ") -> !frk_adt.product<[");
        l1 = str.concat(l1, st);
        l1 = str.concat(l1, "]>");
        emit_line(e, str.concat(sn, l1));
        prod_v = sn;
        prod_t = str.concat("!frk_adt.product<[", str.concat(st, "]>"));
    }
    const s: Str = fresh(e);
    var l2: Str = " = \"frk_adt.make_sum\"(";
    l2 = str.concat(l2, prod_v);
    l2 = str.concat(l2, ") {variant = 0 : i64} : (");
    l2 = str.concat(l2, prod_t);
    l2 = str.concat(l2, ") -> ");
    l2 = str.concat(l2, value_ir_t(a, sty));
    emit_line(e, str.concat(s, l2));
    return s;
}

// The seed's guard: cond_br cond ^trap ^ok; ^trap: message + rt trap +
// poison return; ^ok: continue. Byte-mirrored.
pub fn guard(mut e: Emitter, cond: Str, msg: Str, line: i64, col: i64) {
    const trap: Str = fresh_label(e);
    const ok: Str = fresh_label(e);
    emit_line(e, str.concat("cf.cond_br ", str.concat(cond, str.concat(", ^", str.concat(trap, str.concat(", ^", ok))))));
    new_label(e, trap);
    const m: Str = e_str(e, msg);
    emit_line(e, str.concat("func.call @frk_rt_calque_trap(", str.concat(m, ") : (!frk_bstr.str) -> ()")));
    if ty_is_unit(e_ret(e)) {
        terminate(e, "func.return");
    } else {
        const p: Str = e_poison(e, e_ret(e));
        terminate(e, str.concat("func.return ", str.concat(p, str.concat(" : ", value_ir_t(e_ast(e), e_ret(e))))));
    }
    new_label(e, ok);
}

pub fn const_i64(mut e: Emitter, text: Str) Str {
    return e_int(e, text);
}

// Checked arithmetic, mirroring the seed's emit_checked op for op
// (codes, messages, and the exact sequence shapes).
pub fn emit_checked(mut e: Emitter, op: Str, a: Str, b: Str, line: i64, col: i64) Str {
    const res: Str = fresh(e);
    const zero: Str = const_i64(e, "0");
    if op == "+" {
        emit_line(e, str.concat(res, str.concat(" = arith.addi ", str.concat(a, str.concat(", ", str.concat(b, " : i64"))))));
        const x1: Str = fresh(e);
        const x2: Str = fresh(e);
        const x3: Str = fresh(e);
        const neg: Str = fresh(e);
        emit_line(e, str.concat(x1, str.concat(" = arith.xori ", str.concat(a, str.concat(", ", str.concat(res, " : i64"))))));
        emit_line(e, str.concat(x2, str.concat(" = arith.xori ", str.concat(b, str.concat(", ", str.concat(res, " : i64"))))));
        emit_line(e, str.concat(x3, str.concat(" = arith.andi ", str.concat(x1, str.concat(", ", str.concat(x2, " : i64"))))));
        emit_line(e, str.concat(neg, str.concat(" = arith.cmpi slt, ", str.concat(x3, str.concat(", ", str.concat(zero, " : i64"))))));
        guard(e, neg, loc_msg(e, line, col, "CQ0001", "integer overflow (i64 add)"), line, col);
        vset(e, res, Ty.I64);
        return res;
    }
    if op == "-" {
        emit_line(e, str.concat(res, str.concat(" = arith.subi ", str.concat(a, str.concat(", ", str.concat(b, " : i64"))))));
        const x1: Str = fresh(e);
        const x2: Str = fresh(e);
        const x3: Str = fresh(e);
        const neg: Str = fresh(e);
        emit_line(e, str.concat(x1, str.concat(" = arith.xori ", str.concat(a, str.concat(", ", str.concat(res, " : i64"))))));
        emit_line(e, str.concat(x2, str.concat(" = arith.xori ", str.concat(a, str.concat(", ", str.concat(b, " : i64"))))));
        emit_line(e, str.concat(x3, str.concat(" = arith.andi ", str.concat(x1, str.concat(", ", str.concat(x2, " : i64"))))));
        emit_line(e, str.concat(neg, str.concat(" = arith.cmpi slt, ", str.concat(x3, str.concat(", ", str.concat(zero, " : i64"))))));
        guard(e, neg, loc_msg(e, line, col, "CQ0002", "integer overflow (i64 sub)"), line, col);
        vset(e, res, Ty.I64);
        return res;
    }
    if op == "*" {
        // overflow iff b != 0 and the wrapped product does not divide
        // back; min*-1 routes the quotient to 0 via select (the seed's
        // CQ0003 recipe, mirrored op for op).
        const resm: Str = fresh(e);
        emit_line(e, str.concat(resm, str.concat(" = arith.muli ", str.concat(a, str.concat(", ", str.concat(b, " : i64"))))));
        const bnz: Str = fresh(e);
        emit_line(e, str.concat(bnz, str.concat(" = arith.cmpi ne, ", str.concat(b, str.concat(", ", str.concat(zero, " : i64"))))));
        const bz: Str = fresh(e);
        emit_line(e, str.concat(bz, str.concat(" = arith.cmpi eq, ", str.concat(b, str.concat(", ", str.concat(zero, " : i64"))))));
        const one1: Str = const_i64(e, "1");
        const bsafe: Str = fresh(e);
        emit_line(e, str.concat(bsafe, str.concat(" = arith.select ", str.concat(bz, str.concat(", ", str.concat(one1, str.concat(", ", str.concat(b, " : i64"))))))));
        const maxlit: Str = const_i64(e, "9223372036854775807");
        const one2: Str = const_i64(e, "1");
        const m0: Str = fresh(e);
        const minv: Str = fresh(e);
        const minus1: Str = fresh(e);
        emit_line(e, str.concat(m0, str.concat(" = arith.subi ", str.concat(zero, str.concat(", ", str.concat(maxlit, " : i64"))))));
        emit_line(e, str.concat(minv, str.concat(" = arith.subi ", str.concat(m0, str.concat(", ", str.concat(one2, " : i64"))))));
        emit_line(e, str.concat(minus1, str.concat(" = arith.subi ", str.concat(zero, str.concat(", ", str.concat(one2, " : i64"))))));
        const amin: Str = fresh(e);
        const bm1: Str = fresh(e);
        const special: Str = fresh(e);
        emit_line(e, str.concat(amin, str.concat(" = arith.cmpi eq, ", str.concat(a, str.concat(", ", str.concat(minv, " : i64"))))));
        emit_line(e, str.concat(bm1, str.concat(" = arith.cmpi eq, ", str.concat(b, str.concat(", ", str.concat(minus1, " : i64"))))));
        emit_line(e, str.concat(special, str.concat(" = arith.andi ", str.concat(amin, str.concat(", ", str.concat(bm1, " : i1"))))));
        const zr: Str = fresh(e);
        emit_line(e, str.concat(zr, str.concat(" = arith.select ", str.concat(special, str.concat(", ", str.concat(zero, str.concat(", ", str.concat(resm, " : i64"))))))));
        const q: Str = fresh(e);
        emit_line(e, str.concat(q, str.concat(" = arith.divsi ", str.concat(zr, str.concat(", ", str.concat(bsafe, " : i64"))))));
        const nq: Str = fresh(e);
        emit_line(e, str.concat(nq, str.concat(" = arith.cmpi ne, ", str.concat(q, str.concat(", ", str.concat(a, " : i64"))))));
        const ovf: Str = fresh(e);
        emit_line(e, str.concat(ovf, str.concat(" = arith.andi ", str.concat(nq, str.concat(", ", str.concat(bnz, " : i1"))))));
        guard(e, ovf, loc_msg(e, line, col, "CQ0003", "integer overflow (i64 mul)"), line, col);
        vset(e, resm, Ty.I64);
        return resm;
    }
    if op == "/" {
        return emit_div(e, op, a, b, res, line, col);
    }
    if op == "%" {
        return emit_div(e, op, a, b, res, line, col);
    }
    return e_fail_at(e, line, col, str.concat("operator `", str.concat(op, "` lands in slice 3b-beta")));
}

// division/remainder: zero divisor and MIN/-1 overflow checks (the
// seed's CQ0004/CQ0005 recipe, mirrored).
pub fn emit_div(mut e: Emitter, op: Str, a: Str, b: Str, res: Str, line: i64, col: i64) Str {
    const zero2: Str = const_i64(e, "0");
    const is_zero: Str = fresh(e);
    emit_line(e, str.concat(is_zero, str.concat(" = arith.cmpi eq, ", str.concat(b, str.concat(", ", str.concat(zero2, " : i64"))))));
    if op == "/" {
        guard(e, is_zero, loc_msg(e, line, col, "CQ0004", "division by zero"), line, col);
    } else {
        guard(e, is_zero, loc_msg(e, line, col, "CQ0004", "remainder by zero"), line, col);
    }
    const maxlit: Str = const_i64(e, "9223372036854775807");
    const one: Str = const_i64(e, "1");
    const m1: Str = fresh(e);
    const minv: Str = fresh(e);
    const minus1: Str = fresh(e);
    emit_line(e, str.concat(m1, str.concat(" = arith.subi ", str.concat(zero2, str.concat(", ", str.concat(maxlit, " : i64"))))));
    emit_line(e, str.concat(minv, str.concat(" = arith.subi ", str.concat(m1, str.concat(", ", str.concat(one, " : i64"))))));
    emit_line(e, str.concat(minus1, str.concat(" = arith.subi ", str.concat(zero2, str.concat(", ", str.concat(one, " : i64"))))));
    const is_min: Str = fresh(e);
    const is_m1: Str = fresh(e);
    const both: Str = fresh(e);
    emit_line(e, str.concat(is_min, str.concat(" = arith.cmpi eq, ", str.concat(a, str.concat(", ", str.concat(minv, " : i64"))))));
    emit_line(e, str.concat(is_m1, str.concat(" = arith.cmpi eq, ", str.concat(b, str.concat(", ", str.concat(minus1, " : i64"))))));
    emit_line(e, str.concat(both, str.concat(" = arith.andi ", str.concat(is_min, str.concat(", ", str.concat(is_m1, " : i1"))))));
    if op == "/" {
        guard(e, both, loc_msg(e, line, col, "CQ0005", "division overflow (i64 min / -1)"), line, col);
    } else {
        guard(e, both, loc_msg(e, line, col, "CQ0005", "remainder overflow (i64 min % -1)"), line, col);
    }
    if op == "/" {
        emit_line(e, str.concat(res, str.concat(" = arith.divsi ", str.concat(a, str.concat(", ", str.concat(b, " : i64"))))));
    } else {
        emit_line(e, str.concat(res, str.concat(" = arith.remsi ", str.concat(a, str.concat(", ", str.concat(b, " : i64"))))));
    }
    vset(e, res, Ty.I64);
    return res;
}

pub fn cmp_pred(op: Str) Str {
    if op == "==" {
        return "eq";
    }
    if op == "!=" {
        return "ne";
    }
    if op == "<" {
        return "slt";
    }
    if op == "<=" {
        return "sle";
    }
    if op == ">" {
        return "sgt";
    }
    return "sge";
}

// Short-circuiting and/or (SPEC 5.1), mirroring the seed's block
// shapes byte for byte: the deciding value rides the false (and) /
// true (or) edge through block arguments.
pub fn emit_shortcircuit(mut e: Emitter, op: Str, lnode: Expr, rnode: Expr, line: i64, col: i64) Str {
    const a: Str = emit_expr(e, lnode);
    if ty_is_bool(vget(e, a)) == false {
        return e_fail_at(e, line, col, str.concat("`", str.concat(op, "` takes bool operands (SPEC 5.1)")));
    }
    const rhs_label: Str = fresh_label(e);
    const dec_label: Str = fresh_label(e);
    const join_label: Str = fresh_label(e);
    if op == "and" {
        emit_line(e, str.concat("cf.cond_br ", str.concat(a, str.concat(", ^", str.concat(rhs_label, str.concat(", ^", dec_label))))));
    } else {
        emit_line(e, str.concat("cf.cond_br ", str.concat(a, str.concat(", ^", str.concat(dec_label, str.concat(", ^", rhs_label))))));
    }
    new_label(e, rhs_label);
    const b: Str = emit_expr(e, rnode);
    if ty_is_bool(vget(e, b)) == false {
        return e_fail_at(e, line, col, str.concat("`", str.concat(op, "` takes bool operands (SPEC 5.1)")));
    }
    terminate(e, str.concat("cf.br ^", str.concat(join_label, str.concat("(", str.concat(b, " : i1)")))));
    new_label(e, dec_label);
    terminate(e, str.concat("cf.br ^", str.concat(join_label, str.concat("(", str.concat(a, " : i1)")))));
    const jarg: Str = str.concat("%j", str.sub(join_label, 1, str.len(join_label) - 1));
    var l: Str = "^";
    l = str.concat(l, join_label);
    l = str.concat(l, "(");
    l = str.concat(l, jarg);
    l = str.concat(l, ": i1):");
    emit_top(e, l);
    e.terminated = false;
    vset(e, jarg, Ty.BoolV);
    return jarg;
}

pub fn emit_cmp(mut e: Emitter, op: Str, a: Str, b: Str, line: i64, col: i64) Str {
    const ta: Ty = vget(e, a);
    const tb: Ty = vget(e, b);
    var t: Ty = ta;
    if ty_is_unit(t) {
        t = tb;
    }
    var comparable: bool = false;
    if ty_is_i64(t) {
        comparable = true;
    }
    if ty_is_bool(t) {
        comparable = true;
    }
    if ty_is_str(t) {
        comparable = true;
    }
    if comparable {
        var is_eqop: bool = false;
        if op == "==" {
            is_eqop = true;
        }
        if op == "!=" {
            is_eqop = true;
        }
        if is_eqop {
            const eqr: Str = emit_equality(e, a, b, t, line, col);
            if op == "==" {
                return eqr;
            }
            const tt: Str = e_bool(e, "true");
            const n: Str = fresh(e);
            emit_line(e, str.concat(n, str.concat(" = arith.xori ", str.concat(eqr, str.concat(", ", str.concat(tt, " : i1"))))));
            vset(e, n, Ty.BoolV);
            return n;
        }
        if ty_is_bool(t) {
            return e_fail_at(e, line, col, "boolean ordering is not in the seed (use == / !=)");
        }
        if ty_is_str(t) {
            return e_fail_at(e, line, col, "string ordering is outside the verified subset (use == / !=)");
        }
    }
    const r: Str = fresh(e);
    emit_line(e, str.concat(r, str.concat(" = arith.cmpi ", str.concat(cmp_pred(op), str.concat(", ", str.concat(a, str.concat(", ", str.concat(b, " : i64"))))))));
    vset(e, r, Ty.BoolV);
    return r;
}

// ---------------------------------------------------------------- reads
pub fn cap_slot(mut e: Emitter, b: Binding) Str {
    const slot: Str = fresh(e);
    var st: Str = value_ir_t(e_ast(e), b.ty);
    if b.cap_kind == "box" {
        st = b.cap_box;
    }
    var l: Str = " = \"frk_closure.env_load\"(%env) {index = ";
    l = str.concat(l, str.fromI64(b.cap_idx));
    l = str.concat(l, " : i64, env = ");
    l = str.concat(l, e.capenv_ty);
    l = str.concat(l, "} : (!frk_closure.envref) -> ");
    l = str.concat(l, st);
    emit_line(e, str.concat(slot, l));
    return slot;
}

pub fn binding_slot(mut e: Emitter, b: Binding) Str {
    if b.is_cap {
        return cap_slot(e, b);
    }
    return b.id;
}

pub fn read_binding(mut e: Emitter, b: Binding) Str {
    if b.is_cap {
        const slot: Str = cap_slot(e, b);
        if b.cap_kind == "box" {
            const v0: Str = fresh(e);
            const a0: Ast = e_ast(e);
            var l0: Str = " = \"frk_mem.box_get\"(";
            l0 = str.concat(l0, slot);
            l0 = str.concat(l0, ") : (");
            l0 = str.concat(l0, b.cap_box);
            l0 = str.concat(l0, ") -> ");
            l0 = str.concat(l0, value_ir_t(a0, b.ty));
            emit_line(e, str.concat(v0, l0));
            vset(e, v0, b.ty);
            return v0;
        }
        vset(e, slot, b.ty);
        return slot;
    }
    if b.is_box == false {
        vset(e, b.id, b.ty);
        return b.id;
    }
    const v: Str = fresh(e);
    const a: Ast = e_ast(e);
    emit_line(e, str.concat(v, str.concat(" = \"frk_mem.box_get\"(", str.concat(b.id, str.concat(") : (", str.concat(b.box, str.concat(") -> ", value_ir_t(a, b.ty))))))));
    vset(e, v, b.ty);
    return v;
}

pub fn vty_of(mut e: Emitter, a: Str) Ty {
    return vget(e, a);
}

// ---------------------------------------------------------------- calls
pub fn sym_of2(f: Fn) Str {
    return sym_of(f);
}

pub fn call_sym(name: Str, mod: Str) Str {
    if str.len(mod) > 0 {
        return str.concat(mod, str.concat("__", name));
    }
    if name == "main" {
        return "__calque_main";
    }
    return name;
}

pub fn find_fn(a: Ast, sym: Str) Fn {
    const n: i64 = vector.len(a.fns);
    var i: i64 = 0;
    while i < n {
        const f: Fn = vector.get(a.fns, i);
        if sym_of(f) == sym {
            return f;
        }
        i = i + 1;
    }
    return poison_fn();
}

pub fn emit_apply(mut e: Emitter, cb: Binding, args: Vector(Expr), line: i64, col: i64) Str {
    var sig: FnSig = %FnSig{params: empty_ty_vec(), ret: Ty.UnitV};
    var found: bool = false;
    const bty2: Ty = cb.ty;
    match bty2 {
        Ty.FnT(s2) => { sig = s2; found = true; },
        _ => {},
    };
    if found == false {
        return e_fail_at(e, line, col, "internal: apply on a non-fn binding");
    }
    const fv: Str = read_binding(e, cb);
    const na: i64 = vector.len(args);
    if na != vector.len(sig.params) {
        return e_fail_at(e, line, col, "closure arity mismatch");
    }
    const a: Ast = e_ast(e);
    const e0: Str = fresh(e);
    emit_line(e, str.concat(e0, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
    var acc: Str = e0;
    var acc_ty: Str = "!frk_adt.product<[]>";
    var fields: Str = "";
    var i: i64 = 0;
    while i < na {
        const av: Str = emit_expr(e, vector.get(args, i));
        const aty: Ty = vget(e, av);
        if same_ty(aty, vector.get(sig.params, i)) == false {
            return e_fail_at(e, line, col, "closure argument type mismatch");
        }
        const st: Str = value_ir_t(a, aty);
        if i > 0 {
            fields = str.concat(fields, ", ");
        }
        fields = str.concat(fields, st);
        const nxt: Str = fresh(e);
        var l2: Str = " = \"frk_adt.product_snoc\"(";
        l2 = str.concat(l2, acc);
        l2 = str.concat(l2, ", ");
        l2 = str.concat(l2, av);
        l2 = str.concat(l2, ") : (");
        l2 = str.concat(l2, acc_ty);
        l2 = str.concat(l2, ", ");
        l2 = str.concat(l2, st);
        l2 = str.concat(l2, ") -> !frk_adt.product<[");
        l2 = str.concat(l2, fields);
        l2 = str.concat(l2, "]>");
        emit_line(e, str.concat(nxt, l2));
        acc = nxt;
        acc_ty = str.concat("!frk_adt.product<[", str.concat(fields, "]>"));
        i = i + 1;
    }
    const res: Str = fresh(e);
    var l3: Str = " = \"frk_closure.apply\"(";
    l3 = str.concat(l3, fv);
    l3 = str.concat(l3, ", ");
    l3 = str.concat(l3, acc);
    l3 = str.concat(l3, ") : (");
    l3 = str.concat(l3, fn_ir_t(a, sig));
    l3 = str.concat(l3, ", ");
    l3 = str.concat(l3, acc_ty);
    l3 = str.concat(l3, ") -> ");
    l3 = str.concat(l3, value_ir_t(a, sig.ret));
    emit_line(e, str.concat(res, l3));
    vset(e, res, sig.ret);
    return res;
}

pub fn empty_ty_vec() Vector(Ty) {
    var v: Vector(Ty) = vector.new();
    return v;
}

pub fn emit_call(mut e: Emitter, c: Call, line: i64, col: i64) Str {
    const r: Ref = c.callee;
    if str.len(r.mod) == 0 {
        const cb: Binding = lookup(e, r.name);
        if cb.name != "" {
            var is_fn_ty: bool = false;
            const dty: Ty = cb.ty;
            match dty {
                Ty.FnT(sig) => { is_fn_ty = true; },
                _ => {},
            };
            if is_fn_ty {
                return emit_apply(e, cb, c.args, line, col);
            }
        }
    }
    if str.len(r.mod) == 0 {
        if r.name == "__calque_input_count" {
            if vector.len(c.args) != 0 {
                return e_fail_at(e, line, col, "__calque_input_count takes no arguments");
            }
            const res0: Str = fresh(e);
            emit_line(e, str.concat(res0, " = func.call @__calque_input_count() : () -> i64"));
            vset(e, res0, Ty.I64);
            return res0;
        }
        if r.name == "__calque_input" {
            if vector.len(c.args) != 1 {
                return e_fail_at(e, line, col, "__calque_input takes exactly one i64");
            }
            const a1: Str = emit_expr(e, vector.get(c.args, 0));
            const res1: Str = fresh(e);
            emit_line(e, str.concat(res1, str.concat(" = func.call @__calque_input(", str.concat(a1, ") : (i64) -> !frk_bstr.str"))));
            vset(e, res1, Ty.StrV);
            return res1;
        }
        if r.name == "__calque_input_name" {
            if vector.len(c.args) != 1 {
                return e_fail_at(e, line, col, "__calque_input_name takes exactly one i64");
            }
            const a2: Str = emit_expr(e, vector.get(c.args, 0));
            const res2: Str = fresh(e);
            emit_line(e, str.concat(res2, str.concat(" = func.call @__calque_input_name(", str.concat(a2, ") : (i64) -> !frk_bstr.str"))));
            vset(e, res2, Ty.StrV);
            return res2;
        }
        if r.name == "__calque_input_ns" {
            if vector.len(c.args) != 1 {
                return e_fail_at(e, line, col, "__calque_input_ns takes exactly one i64");
            }
            const a3: Str = emit_expr(e, vector.get(c.args, 0));
            const res3: Str = fresh(e);
            emit_line(e, str.concat(res3, str.concat(" = func.call @__calque_input_ns(", str.concat(a3, ") : (i64) -> !frk_bstr.str"))));
            vset(e, res3, Ty.StrV);
            return res3;
        }
    }
    if str.len(r.mod) > 0 {
        const td: TypeDecl = find_td(e_ast(e), r.mod);
        if td.name != "" {
            return emit_variant_make(e, td, Ty.Named(td.name), r.name, c.args, line, col);
        }
    }
    if r.mod == "assert" {
        if r.name == "equal" {
            // `assert.equal(a, b)` (C2, F33): compare by the operands'
            // types; a mismatch traps loudly.
            const a2: Ast = e_ast(e);
            const na2: i64 = vector.len(c.args);
            if na2 != 2 {
                return e_fail_at(e, line, col, "assert.equal takes exactly two arguments");
            }
            const av: Str = emit_expr(e, vector.get(c.args, 0));
            const bv: Str = emit_expr(e, vector.get(c.args, 1));
            const aty: Ty = vget(e, av);
            const bty: Ty = vget(e, bv);
            if same_ty(aty, bty) == false {
                return e_fail_at(e, line, col, "assert.equal operands must have the same type");
            }
            const cond: Str = fresh(e);
            match aty {
                Ty.StrV => {
                    var lc: Str = " = \"frk_bstr.eq\"(";
                    lc = str.concat(lc, av);
                    lc = str.concat(lc, ", ");
                    lc = str.concat(lc, bv);
                    lc = str.concat(lc, ") : (!frk_bstr.str, !frk_bstr.str) -> i1");
                    emit_line(e, str.concat(cond, lc));
                },
                Ty.BoolV => {
                    emit_line(e, str.concat(cond, str.concat(" = arith.cmpi eq, ", str.concat(av, str.concat(", ", str.concat(bv, " : i1"))))));
                },
                Ty.I64 => {
                    emit_line(e, str.concat(cond, str.concat(" = arith.cmpi eq, ", str.concat(av, str.concat(", ", str.concat(bv, " : i64"))))));
                },
                _ => {
                    return e_fail_at(e, line, col, "assert.equal supports i64, bool, and Str (D-115's slice)");
                },
            };
            const okb: Str = fresh_label(e);
            const failb: Str = fresh_label(e);
            emit_line(e, str.concat("cf.cond_br ", str.concat(cond, str.concat(", ^", str.concat(okb, str.concat(", ^", failb))))));
            new_label(e, failb);
            const msg: Str = fresh(e);
            emit_line(e, str.concat(msg, " = \"frk_bstr.lit\"() {text = \"assert.equal failed\"} : () -> !frk_bstr.str"));
            emit_line(e, str.concat("func.call @frk_rt_calque_trap(", str.concat(msg, ") : (!frk_bstr.str) -> ()")));
            const rt2: Ty = e_ret(e);
            const pv2: Str = e_poison(e, rt2);
            terminate(e, str.concat("func.return ", str.concat(pv2, str.concat(" : ", value_ir_t(a2, rt2)))));
            new_label(e, okb);
            return "";
        }
    }
    if r.mod == "io" {
        if r.name == "print" {
            const n_io: i64 = vector.len(c.args);
            if n_io != 1 {
                return e_fail_at(e, line, col, "io.print takes exactly one Str (seed v0)");
            }
            const a0: Str = emit_expr(e, vector.get(c.args, 0));
            emit_line(e, str.concat("func.call @frk_rt_calque_print(", str.concat(a0, ") : (!frk_bstr.str) -> ()")));
            return "";
        }
        return e_fail_at(e, line, col, str.concat("io.", str.concat(r.name, " is not in seed v0")));
    }
    if r.mod == "vector" {
        return emit_vector_call(e, r.name, c.args, line, col);
    }
    if r.mod == "str" {
        if r.name == "len" {
            const na0: i64 = vector.len(c.args);
            if na0 != 1 {
                return e_fail_at(e, line, col, "str.len takes exactly one argument");
            }
            const a0: Str = emit_expr(e, vector.get(c.args, 0));
            const res0: Str = fresh(e);
            emit_line(e, str.concat(res0, str.concat(" = \"frk_bstr.len\"(", str.concat(a0, ") : (!frk_bstr.str) -> i64"))));
            vset(e, res0, Ty.I64);
            return res0;
        }
        if r.name == "concat" {
            const na1: i64 = vector.len(c.args);
            if na1 != 2 {
                return e_fail_at(e, line, col, "str.concat takes exactly two arguments");
            }
            const x0: Str = emit_expr(e, vector.get(c.args, 0));
            const x1: Str = emit_expr(e, vector.get(c.args, 1));
            const res1: Str = fresh(e);
            emit_line(e, str.concat(res1, str.concat(" = \"frk_bstr.concat\"(", str.concat(x0, str.concat(", ", str.concat(x1, ") : (!frk_bstr.str, !frk_bstr.str) -> !frk_bstr.str"))))));
            vset(e, res1, Ty.StrV);
            return res1;
        }
        if r.name == "sub" {
            const na2: i64 = vector.len(c.args);
            if na2 != 3 {
                return e_fail_at(e, line, col, "str.sub takes exactly three arguments");
            }
            const s: Str = emit_expr(e, vector.get(c.args, 0));
            const start: Str = emit_expr(e, vector.get(c.args, 1));
            const len: Str = emit_expr(e, vector.get(c.args, 2));
            const zero_sub: Str = const_i64(e, "0");
            const e1: Str = fresh(e);
            const e2: Str = fresh(e);
            const endv: Str = fresh(e);
            const e3: Str = fresh(e);
            const bad1: Str = fresh(e);
            const bad: Str = fresh(e);
            const slen: Str = fresh(e);
            emit_line(e, str.concat(slen, str.concat(" = \"frk_bstr.len\"(", str.concat(s, ") : (!frk_bstr.str) -> i64"))));
            emit_line(e, str.concat(e1, str.concat(" = arith.cmpi slt, ", str.concat(start, str.concat(", ", str.concat(zero_sub, " : i64"))))));
            emit_line(e, str.concat(e2, str.concat(" = arith.cmpi slt, ", str.concat(len, str.concat(", ", str.concat(zero_sub, " : i64"))))));
            emit_line(e, str.concat(endv, str.concat(" = arith.addi ", str.concat(start, str.concat(", ", str.concat(len, " : i64"))))));
            emit_line(e, str.concat(e3, str.concat(" = arith.cmpi sgt, ", str.concat(endv, str.concat(", ", str.concat(slen, " : i64"))))));
            emit_line(e, str.concat(bad1, str.concat(" = arith.ori ", str.concat(e1, str.concat(", ", str.concat(e2, " : i1"))))));
            emit_line(e, str.concat(bad, str.concat(" = arith.ori ", str.concat(bad1, str.concat(", ", str.concat(e3, " : i1"))))));
            guard(e, bad, loc_msg(e, line, col, "CQ0006", "str.sub out of bounds"), line, col);
            const one_sub: Str = const_i64(e, "1");
            const from: Str = fresh(e);
            const to: Str = fresh(e);
            emit_line(e, str.concat(from, str.concat(" = arith.addi ", str.concat(start, str.concat(", ", str.concat(one_sub, " : i64"))))));
            emit_line(e, str.concat(to, str.concat(" = arith.addi ", str.concat(start, str.concat(", ", str.concat(len, " : i64"))))));
            const res2: Str = fresh(e);
            emit_line(e, str.concat(res2, str.concat(" = \"frk_bstr.sub\"(", str.concat(s, str.concat(", ", str.concat(from, str.concat(", ", str.concat(to, ") : (!frk_bstr.str, i64, i64) -> !frk_bstr.str"))))))));
            vset(e, res2, Ty.StrV);
            return res2;
        }
        // str.fromI64 and other members resolve as namespaced functions.
    }
    const sym: Str = call_sym(r.name, r.mod);
    const f: Fn = find_fn(e_ast(e), sym);
    if f.name == "" {
        return e_fail_at(e, line, col, str.concat("unknown function `", str.concat(sym, "`")));
    }
    if is_generic_fn(f) {
        const g: GRes = resolve_generic(e, f, c.args, line, col);
        return emit_fn_args(e, g.f, sym_of(g.f), g.args, line, col);
    }
    return emit_fn_args(e, f, sym, c.args, line, col);
}

// ---------------------------------------------------------------- D-113

pub fn is_generic_fn(f: Fn) bool {
    const n: i64 = vector.len(f.params);
    var i: i64 = 0;
    while i < n {
        const prm: Param = vector.get(f.params, i);
        if prm.is_comptime {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn mangle_ty(t: Ty) Str {
    return match t {
        Ty.I64 => "i64",
        Ty.BoolV => "bool",
        Ty.StrV => "str",
        Ty.UnitV => "unit",
        Ty.Named(mn) => mn,
        Ty.Vec(inner) => str.concat("vec_", mangle_ty(inner)),
        Ty.ArrT(a2) => str.concat("arr", str.concat(str.fromI64(a2.n), str.concat("_", mangle_ty(a2.ty)))),
        Ty.Tup(tys) => {
            var acc: Str = "tup";
            const n: i64 = vector.len(tys);
            var i: i64 = 0;
            while i < n {
                acc = str.concat(acc, "_");
                acc = str.concat(acc, mangle_ty(vector.get(tys, i)));
                i = i + 1;
            }
            acc
        },
        Ty.OptT(inner) => str.concat("opt_", mangle_ty(inner)),
        Ty.ResT(rz) => str.concat("res_", str.concat(mangle_ty(rz.err), str.concat("_", mangle_ty(rz.ok)))),
        Ty.FnT(sig) => "fn",
        Ty.TyBad(x) => "t",
    };
}

pub fn subst_ty_list(t: Ty, sub: Vector(TV)) Ty {
    const n: i64 = vector.len(sub);
    var i: i64 = 0;
    while i < n {
        const tv: TV = vector.get(sub, i);
        i = i + 1;
    }
    return match t {
        Ty.Named(nm) => find_tv(nm, sub),
        Ty.Vec(inner) => Ty.Vec(subst_ty_list(inner, sub)),
        Ty.ArrT(a2) => Ty.ArrT(%ArrTT{n: a2.n, ty: subst_ty_list(a2.ty, sub)}),
        Ty.Tup(tys) => {
            var ts: Vector(Ty) = vector.new();
            const n: i64 = vector.len(tys);
            var i: i64 = 0;
            while i < n {
                vector.push(ts, subst_ty_list(vector.get(tys, i), sub));
                i = i + 1;
            }
            Ty.Tup(ts)
        },
        Ty.OptT(inner) => Ty.OptT(subst_ty_list(inner, sub)),
        Ty.ResT(rz) => Ty.ResT(%ResTT{err: subst_ty_list(rz.err, sub), ok: subst_ty_list(rz.ok, sub)}),
        Ty.FnT(sig) => Ty.FnT(sig_subst(sig, sub)),
        _ => t,
    };
}

pub fn find_tv(nm: Str, sub: Vector(TV)) Ty {
    const n: i64 = vector.len(sub);
    var i: i64 = 0;
    while i < n {
        const tv: TV = vector.get(sub, i);
        if tv.name == nm {
            return tv.ty;
        }
        i = i + 1;
    }
    return Ty.Named(nm);
}

pub fn sig_subst(sig: FnSig, sub: Vector(TV)) FnSig {
    var ps: Vector(Ty) = vector.new();
    const n: i64 = vector.len(sig.params);
    var i: i64 = 0;
    while i < n {
        vector.push(ps, subst_ty_list(vector.get(sig.params, i), sub));
        i = i + 1;
    }
    return %FnSig{params: ps, ret: subst_ty_list(sig.ret, sub)};
}

// The funnels: AST types read during emission resolve through the
// ACTIVE substitution (an instance's tvars).
pub fn tv_res(e: Emitter, t: Ty) Ty {
    return match t {
        Ty.Named(nm) => tv_lookup(e, nm),
        Ty.Vec(inner) => Ty.Vec(tv_res(e, inner)),
        Ty.ArrT(a2) => Ty.ArrT(%ArrTT{n: a2.n, ty: tv_res(e, a2.ty)}),
        Ty.Tup(tys) => {
            var ts: Vector(Ty) = vector.new();
            const n: i64 = vector.len(tys);
            var i: i64 = 0;
            while i < n {
                vector.push(ts, tv_res(e, vector.get(tys, i)));
                i = i + 1;
            }
            Ty.Tup(ts)
        },
        Ty.OptT(inner) => Ty.OptT(tv_res(e, inner)),
        Ty.ResT(rz) => Ty.ResT(%ResTT{err: tv_res(e, rz.err), ok: tv_res(e, rz.ok)}),
        Ty.FnT(sig) => Ty.FnT(sig_res(e, sig)),
        _ => t,
    };
}

pub fn tv_lookup(e: Emitter, nm: Str) Ty {
    const n: i64 = vector.len(e.tvars);
    var i: i64 = 0;
    while i < n {
        const tv: TV = vector.get(e.tvars, i);
        if tv.name == nm {
            return tv.ty;
        }
        i = i + 1;
    }
    return Ty.Named(nm);
}

pub fn sig_res(e: Emitter, sig: FnSig) FnSig {
    var ps: Vector(Ty) = vector.new();
    const n: i64 = vector.len(sig.params);
    var i: i64 = 0;
    while i < n {
        vector.push(ps, tv_res(e, vector.get(sig.params, i)));
        i = i + 1;
    }
    return %FnSig{params: ps, ret: tv_res(e, sig.ret)};
}

pub fn ty_is_unknown(t: Ty) bool {
    return match t {
        Ty.TyBad(b) => true,
        _ => false,
    };
}

pub fn name_bound(names: Vector(Str), nm: Str) bool {
    const n: i64 = vector.len(names);
    var i: i64 = 0;
    while i < n {
        if vector.get(names, i) == nm {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn tv_get(sub: Vector(TV), nm: Str) Ty {
    const n: i64 = vector.len(sub);
    var i: i64 = 0;
    while i < n {
        const tv: TV = vector.get(sub, i);
        if tv.name == nm {
            return tv.ty;
        }
        i = i + 1;
    }
    return Ty.TyBad(%BadNode{msg: "<unknown>", line: 0, col: 0});
}

pub fn is_tyarg_expr(mut e: Emitter, a: Expr) bool {
    return match a {
        Expr.TyV(t0) => true,
        Expr.Ref(r0) => {
            const b0: Binding = lookup(e, r0.name);
            b0.name == "" and str.len(r0.mod) == 0
        },
        _ => false,
    };
}

pub fn tyarg_value(mut e: Emitter, a: Expr, line: i64, col: i64) Ty {
    return match a {
        Expr.TyV(t0) => tv_res(e, t0),
        Expr.Ref(r0) => {
            if r0.name == "Str" {
                Ty.StrV
            } else {
                Ty.Named(r0.name)
            }
        },
        _ => {
            const _x: Str = e_fail_at(e, line, col, "a comptime type argument must be a type name or type keyword");
            Ty.UnitV
        },
    };
}

pub fn infer_field_ty(mut e: Emitter, recv: Str, field: Str, line: i64, col: i64) Ty {
    const b0: Binding = lookup(e, recv);
    if b0.name == "" {
        e_fail_at(e, line, col, str.concat("generic inference probe: unknown receiver `", str.concat(recv, "`")));
        return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
    }
    const bty: Ty = b0.ty;
    match bty {
        Ty.Tup(tys) => {
            const nidx: i64 = parse_slot_e(field);
            if nidx >= 0 {
                if nidx < vector.len(tys) {
                    return tv_res(e, vector.get(tys, nidx));
                }
            }
            return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
        },
        _ => {},
    };
    return match bty {
        Ty.Named(nm) => {
            const a: Ast = e_ast(e);
            const td: TypeDecl = find_td(a, nm);
            if td.name == "" {
                e_fail_at(e, line, col, str.concat("generic inference probe: unknown type `", str.concat(nm, "`")));
                Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col})
            } else {
                if td.is_union {
                    Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col})
                } else {
                    const nf: i64 = vector.len(td.fields);
                    var found: bool = false;
                    var fty: Ty = Ty.UnitV;
                    var i: i64 = 0;
                    while i < nf {
                        const fd: FieldDecl = vector.get(td.fields, i);
                        if fd.name == field {
                            found = true;
                            fty = fd.ty;
                        }
                        i = i + 1;
                    }
                    if found {
                        tv_res(e, fty)
                    } else {
                        e_fail_at(e, line, col, str.concat("generic inference probe: no field `", str.concat(field, "`")));
                        Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col})
                    }
                }
            }
        },
        _ => {
            Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col})
        },
    };
}

pub fn infer_call_ty(mut e: Emitter, c0: Call, line: i64, col: i64) Ty {
    const r0: Ref = c0.callee;
    // the builtin namespaces have no AST fns: their result types are
    // known here (the emit_call builtin branches' mirror).
    if r0.mod == "str" {
        if r0.name == "len" {
            return Ty.I64;
        }
        if r0.name == "eq" {
            return Ty.BoolV;
        }
        return Ty.StrV;
    }
    if r0.mod == "io" {
        return Ty.UnitV;
    }
    if r0.mod == "assert" {
        return Ty.UnitV;
    }
    if r0.mod == "vector" {
        if r0.name == "len" {
            return Ty.I64;
        }
        return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
    }
    const sym0: Str = call_sym(r0.name, r0.mod);
    const f2: Fn = find_fn(e_ast(e), sym0);
    if f2.name == "" {
        return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
        return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
    }
    if is_generic_fn(f2) {
        const g: GRes = resolve_generic(e, f2, c0.args, line, col);
        const gf: Fn = g.f;
        return gf.ret;
    }
    return f2.ret;
}

pub fn infer_pipe_ty(mut e: Emitter, b0: Bin, line: i64, col: i64) Ty {
    // `x |> stage(args)` types as the STAGE's result over the piped
    // value leading the arguments (the parse-time desugar's mirror).
    const stage: Expr = b0.r;
    match stage {
        Expr.Call(c0) => {
            var args: Vector(Expr) = vector.new();
            vector.push(args, b0.l);
            const n: i64 = vector.len(c0.args);
            var i: i64 = 0;
            while i < n {
                vector.push(args, vector.get(c0.args, i));
                i = i + 1;
            }
            return infer_call_ty(e, %Call{callee: c0.callee, args: args, line: line, col: col}, line, col);
        },
        Expr.Ref(r0) => {
            var args2: Vector(Expr) = vector.new();
            vector.push(args2, b0.l);
            return infer_call_ty(e, %Call{callee: r0, args: args2, line: line, col: col}, line, col);
        },
        _ => {
            return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
        },
    };
}

pub fn infer_bin_ty(mut e: Emitter, b0: Bin, line: i64, col: i64) Ty {
    const op: Str = b0.op;
    if op == "|>" {
        return infer_pipe_ty(e, b0, line, col);
    }
    if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" {
        return Ty.BoolV;
    }
    if op == "and" or op == "or" {
        return Ty.BoolV;
    }
    const lt: Ty = infer_expr_ty(e, b0.l, line, col);
    if ty_is_unknown(lt) {
        return infer_expr_ty(e, b0.r, line, col);
    }
    return lt;
}

// A bare top-level fn name used as a VALUE: its signature as a fn type.
pub fn infer_fn_value_ty(mut e: Emitter, nm: Str, line: i64, col: i64) Ty {
    const f2: Fn = find_fn(e_ast(e), nm);
    if f2.name == "" {
        return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
    }
    if is_generic_fn(f2) {
        return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
    }
    var ps: Vector(Ty) = vector.new();
    const n: i64 = vector.len(f2.params);
    var i: i64 = 0;
    while i < n {
        const prm: Param = vector.get(f2.params, i);
        vector.push(ps, tv_res(e, prm.ty));
        i = i + 1;
    }
    return Ty.FnT(%FnSig{params: ps, ret: tv_res(e, f2.ret)});
}

pub fn infer_tup_lit(mut e: Emitter, es: Vector(Expr), line: i64, col: i64) Ty {
    var tys: Vector(Ty) = vector.new();
    const n: i64 = vector.len(es);
    var i: i64 = 0;
    while i < n {
        const et: Ty = infer_expr_ty(e, vector.get(es, i), line, col);
        if ty_is_unknown(et) {
            return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
        }
        vector.push(tys, tv_res(e, et));
        i = i + 1;
    }
    return Ty.Tup(tys);
}

pub fn infer_index_ty(mut e: Emitter, ix: IdxE, line: i64, col: i64) Ty {
    const br: Ref = ix.base;
    if str.len(br.mod) != 0 {
        return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
    }
    const b: Binding = lookup(e, br.name);
    if b.name == "" {
        return Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
    }
    const bty2: Ty = b.ty;
    return match bty2 {
        Ty.ArrT(a2) => tv_res(e, a2.ty),
        _ => Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col}),
    };
}

pub fn infer_expr_ty(mut e: Emitter, ex: Expr, line: i64, col: i64) Ty {
    return match ex {
        Expr.Int(t0) => Ty.I64,
        Expr.Str(t0) => Ty.StrV,
        Expr.Bool(t0) => Ty.BoolV,
        Expr.Ref(r0) => {
            if str.len(r0.mod) == 0 {
                const b0: Binding = lookup(e, r0.name);
                if b0.name == "" {
                    infer_fn_value_ty(e, r0.name, line, col)
                } else {
                    b0.ty
                }
            } else {
                infer_field_ty(e, r0.mod, r0.name, line, col)
            }
        },
        Expr.Call(c0) => infer_call_ty(e, c0, line, col),
        Expr.Bin(b0) => infer_bin_ty(e, b0, line, col),
        Expr.Tup(es) => infer_tup_lit(e, es, line, col),
        Expr.IndexE(ix2) => infer_index_ty(e, ix2, line, col),
        _ => Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col}),
    };
}

pub fn has_unbound(t: Ty, sub: Vector(TV), names: Vector(Str)) bool {
    return match t {
        Ty.Named(nm) => {
            if name_bound(names, nm) {
                ty_is_unknown(tv_get(sub, nm))
            } else {
                false
            }
        },
        Ty.Vec(inner) => has_unbound(inner, sub, names),
        Ty.OptT(inner) => has_unbound(inner, sub, names),
        Ty.ArrT(a2) => has_unbound(a2.ty, sub, names),
        Ty.Tup(tys) => {
            var found: bool = false;
            const n: i64 = vector.len(tys);
            var i: i64 = 0;
            while i < n {
                if has_unbound(vector.get(tys, i), sub, names) {
                    found = true;
                }
                i = i + 1;
            }
            found
        },
        Ty.ResT(rz) => has_unbound(rz.err, sub, names) or has_unbound(rz.ok, sub, names),
        Ty.FnT(sig) => {
            var found: bool = false;
            const n: i64 = vector.len(sig.params);
            var i: i64 = 0;
            while i < n {
                if has_unbound(vector.get(sig.params, i), sub, names) {
                    found = true;
                }
                i = i + 1;
            }
            found or has_unbound(sig.ret, sub, names)
        },
        _ => false,
    };
}

pub fn unify_ty(declared: Ty, actual: Ty, sub: Vector(TV), names: Vector(Str)) {
    if ty_is_unknown(actual) {
        return;
    }
    match declared {
        Ty.Named(nm) => {
            if name_bound(names, nm) {
                if ty_is_unknown(tv_get(sub, nm)) {
                    vector.push(sub, %TV{name: nm, ty: actual});
                }
            }
        },
        Ty.Vec(inner) => {
            match actual {
                Ty.Vec(a2) => unify_ty(inner, a2, sub, names),
                _ => {},
            };
        },
        Ty.OptT(inner) => {
            match actual {
                Ty.OptT(a2) => unify_ty(inner, a2, sub, names),
                _ => {},
            };
        },
        Ty.ArrT(a2) => {
            match actual {
                Ty.ArrT(b2) => unify_ty(a2.ty, b2.ty, sub, names),
                _ => {},
            };
        },
        Ty.Tup(tys) => {
            match actual {
                Ty.Tup(a2) => {
                    if vector.len(tys) == vector.len(a2) {
                        const n: i64 = vector.len(tys);
                        var i: i64 = 0;
                        while i < n {
                            unify_ty(vector.get(tys, i), vector.get(a2, i), sub, names);
                            i = i + 1;
                        }
                    }
                },
                _ => {},
            };
        },
        Ty.ResT(rz) => {
            match actual {
                Ty.ResT(a2) => {
                    unify_ty(rz.err, a2.err, sub, names);
                    unify_ty(rz.ok, a2.ok, sub, names);
                },
                _ => {},
            };
        },
        Ty.FnT(sig) => {
            match actual {
                Ty.FnT(s2) => {
                    if vector.len(sig.params) == vector.len(s2.params) {
                        const n: i64 = vector.len(sig.params);
                        var i: i64 = 0;
                        while i < n {
                            unify_ty(vector.get(sig.params, i), vector.get(s2.params, i), sub, names);
                            i = i + 1;
                        }
                        unify_ty(sig.ret, s2.ret, sub, names);
                    }
                },
                _ => {},
            };
        },
        _ => {},
    };
}

pub fn probe_lam_unify(mut e: Emitter, l0: LamE, declared: Ty, sub: Vector(TV), names: Vector(Str), line: i64, col: i64) {
    var dps: Vector(Ty) = vector.new();
    var dsig: FnSig = %FnSig{params: dps, ret: Ty.UnitV};
    var is_fn_t: bool = false;
    match declared {
        Ty.FnT(s2) => {
            dsig = s2;
            is_fn_t = true;
        },
        _ => {},
    };
    if is_fn_t == false {
        return;
    }
    scope_push(e);
    var bound: bool = true;
    const nlp: i64 = vector.len(l0.params);
    var i: i64 = 0;
    while i < nlp {
        const lp: Param = vector.get(l0.params, i);
        var lty: Ty = lp.ty;
        if ty_is_hole(lty) {
            if i < vector.len(dsig.params) {
                lty = subst_ty_list(vector.get(dsig.params, i), sub);
            } else {
                bound = false;
            }
        }
        if bound {
            declare(e, %Binding{name: lp.name, is_box: false, ty: lty, id: str.concat("%", lp.name), box: ""});
        }
        i = i + 1;
    }
    var pret: Ty = Ty.TyBad(%BadNode{msg: "<unknown>", line: line, col: col});
    if bound {
        const b0: Block = l0.body;
        if b0.has_tail {
            pret = infer_expr_ty(e, b0.tail, line, col);
        }
    }
    scope_pop(e);
    if ty_is_unknown(pret) {
        e_fail_at(e, line, col, "generic inference: the closure's body tail is not typeable");
        return;
    }
    var ps2: Vector(Ty) = vector.new();
    const nn: i64 = vector.len(dsig.params);
    var j: i64 = 0;
    while j < nn {
        vector.push(ps2, subst_ty_list(vector.get(dsig.params, j), sub));
        j = j + 1;
    }
    unify_ty(declared, Ty.FnT(%FnSig{params: ps2, ret: pret}), sub, names);
}

pub fn resolve_generic(mut e: Emitter, f: Fn, args: Vector(Expr), line: i64, col: i64) GRes {
    var names: Vector(Str) = vector.new();
    const np: i64 = vector.len(f.params);
    var i: i64 = 0;
    while i < np {
        const prm: Param = vector.get(f.params, i);
        if prm.is_comptime {
            vector.push(names, prm.name);
        }
        i = i + 1;
    }
    var sub: Vector(TV) = vector.new();
    var ai: i64 = 0;
    i = 0;
    while i < np {
        const prm: Param = vector.get(f.params, i);
        if prm.is_comptime {
            const na: i64 = vector.len(args);
            if ai < na {
                if is_tyarg_expr(e, vector.get(args, ai)) {
                    const t0: Ty = tyarg_value(e, vector.get(args, ai), line, col);
                    vector.push(sub, %TV{name: prm.name, ty: t0});
                    ai = ai + 1;
                }
            }
        }
        i = i + 1;
    }
    var vi: i64 = ai;
    i = 0;
    while i < np {
        const prm: Param = vector.get(f.params, i);
        if prm.is_comptime == false {
            const na2: i64 = vector.len(args);
            if vi < na2 {
                const a: Expr = vector.get(args, vi);
                var did_probe: bool = false;
                match a {
                    Expr.Lam(l0) => {
                        if has_unbound(prm.ty, sub, names) {
                            did_probe = true;
                            probe_lam_unify(e, l0, prm.ty, sub, names, line, col);
                        }
                    },
                    _ => {},
                };
                if did_probe == false {
                    const actual: Ty = infer_expr_ty(e, a, line, col);
                    if ty_is_unknown(actual) == false {
                        unify_ty(prm.ty, actual, sub, names);
                    }
                }
            }
            vi = vi + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < np {
        const prm2: Param = vector.get(f.params, i);
        if prm2.is_comptime {
            if ty_is_unknown(tv_get(sub, prm2.name)) {
                var bmsg: Str = "cannot infer `";
                bmsg = str.concat(bmsg, prm2.name);
                bmsg = str.concat(bmsg, "` of `");
                bmsg = str.concat(bmsg, f.name);
                bmsg = str.concat(bmsg, "` bound=");
                bmsg = str.concat(bmsg, str.fromI64(vector.len(sub)));
                bmsg = str.concat(bmsg, " na=");
                bmsg = str.concat(bmsg, str.fromI64(vector.len(args)));
                e_fail_at(e, line, col, bmsg);
                return %GRes{f: f, args: args};
            }
        }
        i = i + 1;
    }
    var key: Str = f.name;
    var si: i64 = 0;
    const ns_: i64 = vector.len(sub);
    while si < ns_ {
        const sv: TV = vector.get(sub, si);
        key = str.concat(key, str.concat("__", mangle_ty(sv.ty)));
        si = si + 1;
    }
    var found2: bool = false;
    var instf: Fn = f;
    const ni: i64 = vector.len(e.insts);
    var ii: i64 = 0;
    while ii < ni {
        const ie: InstN = vector.get(e.insts, ii);
        if ie.key == key {
            found2 = true;
            instf = ie.f;
        }
        ii = ii + 1;
    }
    if found2 == false {
        var vps: Vector(Param) = vector.new();
        var pi: i64 = 0;
        while pi < np {
            const prm3: Param = vector.get(f.params, pi);
            if prm3.is_comptime == false {
                vector.push(vps, %Param{name: prm3.name, ty: subst_ty_list(prm3.ty, sub), mut: prm3.mut, is_comptime: false});
            }
            pi = pi + 1;
        }
        instf = %Fn{name: key, params: vps, ret: subst_ty_list(f.ret, sub), body: f.body, file: f.file, ns: "", test_name: ""};
        vector.push(e.insts, %InstN{key: key, f: instf});
        vector.push(e.instq, %InstE{f: instf, sub: sub});
    }
    var valargs: Vector(Expr) = vector.new();
    const na3: i64 = vector.len(args);
    var vj: i64 = ai;
    while vj < na3 {
        vector.push(valargs, vector.get(args, vj));
        vj = vj + 1;
    }
    return %GRes{f: instf, args: valargs};
}

pub fn emit_fn_args(mut e: Emitter, f: Fn, sym: Str, args: Vector(Expr), line: i64, col: i64) Str {
    if state_ok(e.state) == false {
        return "";
    }
    const a: Ast = e_ast(e);
    var parts: Str = "%env";
    var types: Str = "!frk_closure.envref";
    const na: i64 = vector.len(args);
    const np: i64 = vector.len(f.params);
    if na != np {
        return e_fail_at(e, line, col, str.concat("`", str.concat(sym, "` arity mismatch")));
    }
    var i: i64 = 0;
    while i < na {
        const prm: Param = vector.get(f.params, i);
        if prm.mut {
            const agr: Expr = vector.get(args, i);
            const ar: Ref = ref_of_expr(agr);
            if str.len(ar.name) == 0 {
                e_fail_at(e, line, col, "mut arguments must be names (a variable or a mut parameter)");
                return "";
            }
            if str.len(ar.mod) > 0 {
                e_fail_at(e, line, col, "mut arguments must be names (a variable or a mut parameter)");
                return "";
            }
            const ab: Binding = lookup(e, ar.name);
            if ab.name == "" {
                e_fail_at(e, line, col, str.concat("unknown name `", str.concat(ar.name, "`")));
                return "";
            }
            if ab.is_box == false {
                e_fail_at(e, line, col, str.concat("`", str.concat(ar.name, "` is not mutable (declare it with var, or take it as a mut parameter)")));
                return "";
            }
            var k: i64 = 0;
            while k < i {
                const pk: Param = vector.get(f.params, k);
                if pk.mut {
                    const ak: Ref = ref_of_expr(vector.get(args, k));
                    if ak.name == ar.name {
                        e_fail_at(e, line, col, str.concat("`", str.concat(ar.name, "` cannot occupy two mut positions in one call")));
                        return "";
                    }
                }
                k = k + 1;
            }
            parts = str.concat(parts, str.concat(", ", ab.id));
            types = str.concat(types, str.concat(", ", box_ir_t(a, prm.ty)));
        } else {
            const v: Str = emit_expr_typed(e, vector.get(args, i), tv_res(e, prm.ty));
            parts = str.concat(parts, str.concat(", ", v));
            types = str.concat(types, str.concat(", ", value_ir_t(a, tv_res(e, prm.ty))));
        }
        i = i + 1;
    }
    if ty_is_unit(f.ret) {
        emit_line(e, str.concat("func.call @", str.concat(sym, str.concat("(", str.concat(parts, str.concat(") : (", str.concat(types, ") -> ()")))))));
        return "";
    }
    const res: Str = fresh(e);
    emit_line(e, str.concat(res, str.concat(" = func.call @", str.concat(sym, str.concat("(", str.concat(parts, str.concat(") : (", str.concat(types, str.concat(") -> ", value_ir_t(a, f.ret))))))))));
    vset(e, res, f.ret);
    return res;
}

// ---------------------------------------------------------------- expressions
pub fn emit_expr(mut e: Emitter, ex: Expr) Str {
    return match ex {
        Expr.Int(t) => e_int(e, t),
        Expr.Bool(t) => e_bool(e, t),
        Expr.Str(t) => e_str(e, t),
        Expr.Ref(r) => emit_ref(e, r, 0, 0),
        Expr.Call(c) => emit_call(e, c, c.line, c.col),
        Expr.Bin(b) => emit_bin(e, b),
        Expr.If(f) => emit_ifx(e, f),
        Expr.Blk(b) => emit_block_expr(e, b),
        Expr.List(l) => e_fail_at(e, 0, 0, "a collection literal needs a [T]/Vector annotation (bind it: `const v: [i64] = [...]`)"),
        Expr.Lam(l) => emit_lambda_expr(e, l),
        Expr.TryE(tr) => emit_try_e(e, tr),
        Expr.CatchE(cx) => emit_catch_e(e, cx),
        Expr.TyV(tx) => emit_tyv(e, tx),
        Expr.Tup(es) => emit_tuple_e(e, es, Ty.UnitV),
        Expr.IndexE(ix2) => emit_index_e(e, ix2),
        Expr.Bad(b) => e_fail(e, b),
        Expr.Match(m) => emit_match(e, m),
        Expr.Make(m) => emit_make(e, m, m.line, m.col),
    };
}

pub fn emit_ref(mut e: Emitter, r: Ref, line: i64, col: i64) Str {
    if str.len(r.mod) > 0 {
        const td: TypeDecl = find_td(e_ast(e), r.mod);
        if td.name != "" {
            if td.is_union == false {
                var msg_ty: Str = "`";
                msg_ty = str.concat(msg_ty, r.mod);
                msg_ty = str.concat(msg_ty, "` is a struct type; construct it with `%");
                msg_ty = str.concat(msg_ty, r.mod);
                msg_ty = str.concat(msg_ty, "{...}`");
                return e_fail_at(e, line, col, msg_ty);
            }
            const idx: i64 = variant_index(td, r.name);
            if idx < 0 {
                return e_fail_at(e, line, col, str.concat("unknown variant `", str.concat(r.name, "`")));
            }
            const v: VariantDecl = vector.get(td.variants, idx);
            if v.has_payload {
                return e_fail_at(e, line, col, str.concat("variant `", str.concat(r.name, "` carries a payload (call its constructor)")));
            }
            return emit_unit_variant(e, td, Ty.Named(td.name), r.name, line, col);
        }
        const owner: Binding = lookup(e, r.mod);
        if owner.name == "" {
            return e_fail_at(e, line, col, str.concat("unknown name `", str.concat(r.mod, "`")));
        }
        const oty2: Ty = owner.ty;
        match oty2 {
            Ty.Tup(tys) => {
                const nidx: i64 = parse_slot_e(r.name);
                if nidx < 0 {
                    return e_fail_at(e, line, col, str.concat("a tuple's members are numeric (`t.0`); `", str.concat(r.name, "` is not")));
                }
                if nidx >= vector.len(tys) {
                    return e_fail_at(e, line, col, str.concat("tuple index out of range: ", r.name));
                }
                const slot_ty: Ty = vector.get(tys, nidx);
                const value: Str = read_binding(e, owner);
                const a2: Ast = e_ast(e);
                const got: Str = fresh(e);
                var lg: Str = " = \"frk_adt.get\"(";
                lg = str.concat(lg, value);
                lg = str.concat(lg, ") {field = ");
                lg = str.concat(lg, str.fromI64(nidx));
                lg = str.concat(lg, " : i64} : (");
                lg = str.concat(lg, value_ir_t(a2, owner.ty));
                lg = str.concat(lg, ") -> ");
                lg = str.concat(lg, storage_ir_t(a2, slot_ty));
                emit_line(e, str.concat(got, lg));
                return unwrap_load(e, got, slot_ty, line, col);
            },
            _ => {},
        };
        if is_named_t(owner.ty) == false {
            return e_fail_at(e, line, col, str.concat("`", str.concat(r.mod, "` has no fields")));
        }
        const recv: Str = read_binding(e, owner);
        return emit_field_access(e, recv, named_of(owner.ty), r.name, line, col);
    }
    const b: Binding = lookup(e, r.name);
    if b.name == "" {
        // a bare top-level fn name as a VALUE: a closure over an empty
        // environment (first-class fn values, SPEC 6.4).
        const f2: Fn = find_fn(e_ast(e), r.name);
        if f2.name != "" {
            if is_generic_fn(f2) {
                return e_fail_at(e, line, col, "a generic fn value needs explicit instantiation (D-113)");
            }
            return emit_fn_value(e, f2);
        }
        return e_fail_at(e, line, col, str.concat("unknown name `", str.concat(r.name, "`")));
    }
    return read_binding(e, b);
}

pub fn fn_sig_of(f: Fn) FnSig {
    var ps: Vector(Ty) = vector.new();
    const n: i64 = vector.len(f.params);
    var i: i64 = 0;
    while i < n {
        const prm: Param = vector.get(f.params, i);
        vector.push(ps, prm.ty);
        i = i + 1;
    }
    return %FnSig{params: ps, ret: f.ret};
}

pub fn emit_fn_value(mut e: Emitter, f: Fn) Str {
    const a: Ast = e_ast(e);
    const sig: FnSig = fn_sig_of(f);
    const e0: Str = fresh(e);
    emit_line(e, str.concat(e0, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
    const cl: Str = fresh(e);
    var l: Str = " = \"frk_closure.make\"(";
    l = str.concat(l, e0);
    l = str.concat(l, ") {callee = @");
    l = str.concat(l, sym_of(f));
    l = str.concat(l, "} : (!frk_adt.product<[]>) -> ");
    l = str.concat(l, fn_ir_t(a, sig));
    emit_line(e, str.concat(cl, l));
    vset(e, cl, Ty.FnT(sig));
    return cl;
}

pub fn emit_bin(mut e: Emitter, b: Bin) Str {
    if b.op == "and" {
        return emit_shortcircuit(e, "and", b.l, b.r, b.line, b.col);
    }
    if b.op == "or" {
        return emit_shortcircuit(e, "or", b.l, b.r, b.line, b.col);
    }
    const a: Str = emit_expr(e, b.l);
    const c: Str = emit_expr(e, b.r);
    if b.op == "+" {
        return emit_checked(e, b.op, a, c, b.line, b.col);
    }
    if b.op == "-" {
        return emit_checked(e, b.op, a, c, b.line, b.col);
    }
    if b.op == "*" {
        return emit_checked(e, b.op, a, c, b.line, b.col);
    }
    if b.op == "/" {
        return emit_checked(e, b.op, a, c, b.line, b.col);
    }
    if b.op == "%" {
        return emit_checked(e, b.op, a, c, b.line, b.col);
    }
    if b.op == "==" {
        return emit_cmp(e, b.op, a, c, b.line, b.col);
    }
    if b.op == "!=" {
        return emit_cmp(e, b.op, a, c, b.line, b.col);
    }
    if b.op == "<" {
        return emit_cmp(e, b.op, a, c, b.line, b.col);
    }
    if b.op == "<=" {
        return emit_cmp(e, b.op, a, c, b.line, b.col);
    }
    if b.op == ">" {
        return emit_cmp(e, b.op, a, c, b.line, b.col);
    }
    if b.op == ">=" {
        return emit_cmp(e, b.op, a, c, b.line, b.col);
    }
    return e_fail_at(e, 0, 0, str.concat("operator `", str.concat(b.op, "` lands in slice 3b-beta")));
}

// Block expression: statements with scopes, optional tail value.
pub fn emit_block_expr(mut e: Emitter, b: Block) Str {
    scope_push(e);
    var value: Str = "";
    const n: i64 = vector.len(b.stmts);
    var i: i64 = 0;
    while i < n {
        if is_terminated(e) == false {
            emit_stmt(e, vector.get(b.stmts, i));
        }
        i = i + 1;
    }
    if is_terminated(e) == false {
        if b.has_tail {
            value = emit_expr(e, b.tail);
        }
    }
    scope_pop(e);
    return value;
}

// `if` expression (else required): then/else arms branch to a join
// with the value; mirrors the seed's block reordering linearly.
// A value-position block's trailing `if ... else ...` statement IS
// its value (recursively - the seed's fn-tail convention generalised
// to match arms and if branches).
pub fn emit_value_block(mut e: Emitter, blk: Block) Str {
    if blk.has_tail == false {
        const n: i64 = vector.len(blk.stmts);
        if n > 0 {
            const last: Stmt = vector.get(blk.stmts, n - 1);
            match last {
                Stmt.If(f0) => {
                    if f0.has_else {
                        var upto: i64 = n - 1;
                        var si: i64 = 0;
                        while si < upto {
                            if is_terminated(e) {
                                si = upto;
                            } else {
                                emit_stmt(e, vector.get(blk.stmts, si));
                                si = si + 1;
                            }
                        }
                        if is_terminated(e) == false {
                            return emit_ifx(e, %IfE{cond: f0.cond, then: f0.then, has_else: f0.has_else, els: f0.els});
                        }
                        return "";
                    }
                },
                _ => {},
            };
        }
    }
    return emit_block_expr(e, blk);
}

pub fn emit_ifx(mut e: Emitter, f: IfE) Str {
    if f.has_else == false {
        return e_fail_at(e, 0, 0, "an `if` in expression position requires `else` (SPEC 5)");
    }
    const cond: Str = emit_expr(e, f.cond);
    const tl: Str = fresh_label(e);
    const el: Str = fresh_label(e);
    const jl: Str = fresh_label(e);
    emit_line(e, str.concat("cf.cond_br ", str.concat(cond, str.concat(", ^", str.concat(tl, str.concat(", ^", el))))));
    new_label(e, tl);
    const tv: Str = emit_value_block(e, f.then);
    var ty: Ty = Ty.UnitV;
    var has_ty: bool = false;
    if str.len(tv) > 0 {
        ty = vget(e, tv);
        has_ty = true;
    }
    const then_end_len: i64 = vector.len(e.output);
    new_label(e, el);
    const ev: Str = emit_value_block(e, f.els);
    if has_ty == false {
        if str.len(ev) > 0 {
            ty = vget(e, ev);
            has_ty = true;
        }
    }
    const a: Ast = e_ast(e);
    // join arg name mirrors the seed: %j<label-counter>
    var join_arg: Str = "";
    if has_ty {
        // named from the join block itself (nested constructs advance
        // the counter; reading it here would alias an inner join).
        join_arg = str.concat("%j", str.sub(jl, 1, str.len(jl) - 1));
        emit_top(e, str.concat("^", str.concat(jl, str.concat("(", str.concat(join_arg, str.concat(": ", str.concat(value_ir_t(a, ty), "):")))))));
        e.terminated = false;
    } else {
        new_label(e, jl);
    }
    // patch the then-branch: its br must land right after its arm lines
    const br_then: Str = br_for(e, jl, tv, ty, has_ty);
    const br_else: Str = br_for(e, jl, ev, ty, has_ty);
    var patched: Vector(Str) = vector.new();
    const no = vector.len(e.output);
    var i: i64 = 0;
    while i < no {
        // splice br_then after the then arm (before the else label) and
        // br_else at the end (before the join label) - linear rebuild
        i = i + 1;
    }
    // Simpler: rebuild out by walking and inserting.
    var rebuilt: Vector(Str) = vector.new();
    var j: i64 = 0;
    while j < no {
        const line: Str = vector.get(e.output, j);
        if j == then_end_len {
            vector.push(rebuilt, br_then);
        }
        if j == no - 1 {
            vector.push(rebuilt, br_else);
        }
        vector.push(rebuilt, line);
        j = j + 1;
    }
    e.output = rebuilt;
    if has_ty {
        vset(e, join_arg, ty);
        return join_arg;
    }
    return "";
}

pub fn br_for(mut e: Emitter, jl: Str, v: Str, ty: Ty, has_ty: bool) Str {
    const a: Ast = e_ast(e);
    if has_ty {
        if str.len(v) > 0 {
            var acc: Str = "  cf.br ^"; // spliced raw: carries its indent
            acc = str.concat(acc, jl);
            acc = str.concat(acc, "(");
            acc = str.concat(acc, v);
            acc = str.concat(acc, " : ");
            acc = str.concat(acc, value_ir_t(a, ty));
            acc = str.concat(acc, ")");
            return acc;
        }
    }
    return str.concat("  cf.br ^", jl);
}

// ---------------------------------------------------------------- statements
pub fn emit_stmt(mut e: Emitter, s: Stmt) {
    match s {
        Stmt.Const(c) => emit_const(e, c),
        Stmt.Var(v) => emit_var(e, v),
        Stmt.FAssign(f) => emit_fassign(e, f),
        Stmt.Assign(a) => emit_assign(e, a),
        Stmt.Ret(r) => emit_ret(e, r),
        Stmt.While(w) => emit_while(e, w),
        Stmt.If(f) => emit_ifs(e, %IfE{cond: f.cond, then: f.then, has_else: f.has_else, els: f.els}),
        Stmt.Expr(x) => emit_expr_stmt(e, x),
        Stmt.Destr(d) => emit_destr(e, d),
        Stmt.TDestr(td) => emit_tdestr_e(e, td),
    };
}

pub fn emit_const(mut e: Emitter, c: ConstS) {
    const cty: Ty = tv_res(e, c.ty);
    var v: Str = "";
    if is_vec_new(c.expr) {
        v = emit_vec_new(e, cty, 0, 0);
    } else {
        if c.has_ty {
            v = emit_expr_typed(e, c.expr, cty);
        } else {
            v = emit_expr(e, c.expr);
        }
    }
    var ty: Ty = cty;
    if c.has_ty == false {
        ty = vget(e, v);
    }
    declare(e, %Binding{name: c.name, is_box: false, ty: ty, id: v, box: ""});
}

pub fn emit_var(mut e: Emitter, d: VarS) {
    const dty0: Ty = tv_res(e, d.ty);
    var v: Str = "";
    if is_vec_new(d.expr) {
        v = emit_vec_new(e, dty0, 0, 0);
    } else {
        if d.has_ty {
            v = emit_expr_typed(e, d.expr, dty0);
        } else {
            v = emit_expr(e, d.expr);
        }
    }
    var dty: Ty = dty0;
    if d.has_ty == false {
        dty = vget(e, v);
    }
    const b: Str = fresh(e);
    const a: Ast = e_ast(e);
    emit_line(e, str.concat(b, str.concat(" = \"frk_mem.box_new\"(", str.concat(v, str.concat(") : (", str.concat(value_ir_t(a, dty), str.concat(") -> ", box_ir_t(a, dty))))))));
    declare(e, %Binding{name: d.name, is_box: true, ty: dty, id: b, box: box_ir_t(a, dty)});
}

pub fn emit_assign(mut e: Emitter, x: AssignS) {
    const b: Binding = lookup(e, x.name);
    if b.name == "" {
        const _e: Str = e_fail_at(e, 0, 0, str.concat("unknown name `", str.concat(x.name, "` in assignment")));
        return;
    }
    var assignable: bool = b.is_box;
    if b.is_cap {
        if b.cap_kind == "box" {
            assignable = true;
        }
    }
    if assignable == false {
        const _e2: Str = e_fail_at(e, 0, 0, str.concat("cannot assign to immutable `", str.concat(x.name, "`")));
        return;
    }
    var bty: Str = b.box;
    if b.is_cap {
        bty = b.cap_box;
    }
    const bid: Str = binding_slot(e, b);
    const bwt: Ty = tv_res(e, b.ty);
    const v: Str = emit_expr_typed(e, x.expr, bwt);
    const a: Ast = e_ast(e);

    emit_line(e, str.concat("\"frk_mem.box_set\"(", str.concat(bid, str.concat(", ", str.concat(v, str.concat(") : (", str.concat(bty, str.concat(", ", str.concat(value_ir_t(a, bwt), ") -> ()")))))))));
}

pub fn emit_ret(mut e: Emitter, r: RetS) {
    if r.has_expr == false {
        terminate(e, "func.return");
        return;
    }
    var ret_ty: Ty = Ty.UnitV;
    const rr: Ty = e_ret(e);
    ret_ty = rr;
    const v: Str = emit_expr_typed(e, r.expr, ret_ty);
    const a: Ast = e_ast(e);
    var acc: Str = "func.return ";
    acc = str.concat(acc, v);
    acc = str.concat(acc, " : ");
    acc = str.concat(acc, value_ir_t(a, vget(e, v)));
    terminate(e, acc);
}

pub fn emit_while(mut e: Emitter, w: WhileS) {
    const head: Str = fresh_label(e);
    const body: Str = fresh_label(e);
    const done: Str = fresh_label(e);
    terminate(e, str.concat("cf.br ^", head));
    new_label(e, head);
    const cond: Str = emit_expr(e, w.cond);
    emit_line(e, str.concat("cf.cond_br ", str.concat(cond, str.concat(", ^", str.concat(body, str.concat(", ^", done))))));
    new_label(e, body);
    emit_block_expr(e, w.body);
    if is_terminated(e) == false {
        terminate(e, str.concat("cf.br ^", head));
    }
    new_label(e, done);
}

pub fn emit_ifs(mut e: Emitter, f: IfE) {
    const cond: Str = emit_expr(e, f.cond);
    const tl: Str = fresh_label(e);
    const cont: Str = fresh_label(e);
    var el: Str = "";
    if f.has_else {
        el = fresh_label(e);
        emit_line(e, str.concat("cf.cond_br ", str.concat(cond, str.concat(", ^", str.concat(tl, str.concat(", ^", el))))));
    } else {
        emit_line(e, str.concat("cf.cond_br ", str.concat(cond, str.concat(", ^", str.concat(tl, str.concat(", ^", cont))))));
    }
    new_label(e, tl);
    emit_block_expr(e, f.then);
    if is_terminated(e) == false {
        terminate(e, str.concat("cf.br ^", cont));
    }
    if f.has_else {
        new_label(e, el);
        emit_block_expr(e, f.els);
        if is_terminated(e) == false {
            terminate(e, str.concat("cf.br ^", cont));
        }
    }
    new_label(e, cont);
}

pub fn emit_expr_stmt(mut e: Emitter, x: ExprS) {
    const v: Str = emit_expr(e, x.expr);
    return;
}

pub fn emit_tdestr_e(mut e: Emitter, td: TDestrS) {
    const a: Ast = e_ast(e);
    const v: Str = emit_expr(e, td.expr);
    const vty: Ty = vget(e, v);
    var tys: Vector(Ty) = vector.new();
    var is_t: bool = false;
    match vty {
        Ty.Tup(t2) => {
            tys = t2;
            is_t = true;
        },
        _ => {},
    };
    if is_t == false {
        e_fail_at(e, 0, 0, "tuple destructuring needs a tuple-typed initializer");
        return;
    }
    const n: i64 = vector.len(td.names);
    if n != vector.len(tys) {
        e_fail_at(e, 0, 0, "tuple destructuring arity does not match");
        return;
    }
    var i: i64 = 0;
    while i < n {
        const nm: Str = vector.get(td.names, i);
        const slot_ty: Ty = vector.get(tys, i);
        const got: Str = fresh(e);
        var lg: Str = " = \"frk_adt.get\"(";
        lg = str.concat(lg, v);
        lg = str.concat(lg, ") {field = ");
        lg = str.concat(lg, str.fromI64(i));
        lg = str.concat(lg, " : i64} : (");
        lg = str.concat(lg, value_ir_t(a, vty));
        lg = str.concat(lg, ") -> ");
        lg = str.concat(lg, storage_ir_t(a, slot_ty));
        emit_line(e, str.concat(got, lg));
        const value: Str = unwrap_load(e, got, slot_ty, 0, 0);
        if td.mutable {
            const b: Str = fresh(e);
            emit_line(e, str.concat(b, str.concat(" = \"frk_mem.box_new\"(", str.concat(value, str.concat(") : (", str.concat(value_ir_t(a, slot_ty), str.concat(") -> ", box_ir_t(a, slot_ty))))))));
            declare(e, %Binding{name: nm, is_box: true, ty: slot_ty, id: b, box: box_ir_t(a, slot_ty)});
        } else {
            declare(e, %Binding{name: nm, is_box: false, ty: slot_ty, id: value, box: ""});
        }
        i = i + 1;
    }
}

pub fn emit_destr(mut e: Emitter, d: DestrS) {
    emit_destr_names(e, d, 0, 0);
}

pub fn emit_tail_if(mut e: Emitter, f: IfE) {
    const cond: Str = emit_expr(e, f.cond);
    const tl: Str = fresh_label(e);
    const el: Str = fresh_label(e);
    const jl: Str = fresh_label(e);
    const ty: Ty = e_ret(e);
    const a: Ast = e_ast(e);
    emit_line(e, str.concat("cf.cond_br ", str.concat(cond, str.concat(", ^", str.concat(tl, str.concat(", ^", el))))));
    emit_top(e, str.concat("^", str.concat(tl, ":")));
    scope_push(e);
    const tv: Str = emit_block_expr(e, f.then);
    scope_pop(e);
    var acc_t: Str = "func.return ";
    acc_t = str.concat(acc_t, tv);
    acc_t = str.concat(acc_t, " : ");
    acc_t = str.concat(acc_t, value_ir_t(a, ty));
    terminate(e, acc_t);
    emit_top(e, str.concat("^", str.concat(el, ":")));
    scope_push(e);
    const ev: Str = emit_block_expr(e, f.els);
    scope_pop(e);
    var acc_e: Str = "func.return ";
    acc_e = str.concat(acc_e, ev);
    acc_e = str.concat(acc_e, " : ");
    acc_e = str.concat(acc_e, value_ir_t(a, ty));
    terminate(e, acc_e);
    emit_top(e, str.concat("^", str.concat(jl, ":")));
}

// ---------------------------------------------------------------- 3b-beta-1
// Records, variants, destructuring, field access, Str/bool comparisons,
// and the vector prelude - each mirroring the seed op for op.

pub fn is_named_t(t: Ty) bool {
    return match t {
        Ty.Named(n) => true,
        _ => false,
    };
}

pub fn is_vec_t(t: Ty) bool {
    return match t {
        Ty.Vec(inner) => true,
        _ => false,
    };
}

pub fn ty_is_str(t: Ty) bool {
    return match t {
        Ty.StrV => true,
        _ => false,
    };
}

pub fn ty_is_bool(t: Ty) bool {
    return match t {
        Ty.BoolV => true,
        _ => false,
    };
}

pub fn same_ty(a: Ty, b: Ty) bool {
    return match a {
        Ty.I64 => ty_is_i64(b),
        Ty.BoolV => ty_is_bool(b),
        Ty.StrV => ty_is_str(b),
        Ty.UnitV => ty_is_unit(b),
        Ty.Named(n) => same_named(n, b),
        Ty.Vec(inner) => same_vec(inner, b),
        Ty.OptT(inner) => same_opt(inner, b),
        Ty.ResT(rz) => same_res(rz, b),
        Ty.Tup(tys) => same_tup(tys, b),
        Ty.ArrT(a2) => same_arr(a2, b),
        Ty.FnT(sig) => same_fnsig(sig, b),
        Ty.TyBad(x) => ty_is_unit(b),
    };
}

pub fn same_arr(a2: ArrTT, b: Ty) bool {
    var res: bool = false;
    match b {
        Ty.ArrT(b2) => {
            if a2.n == b2.n {
                res = same_ty(a2.ty, b2.ty);
            }
        },
        _ => {},
    };
    return res;
}

pub fn same_tup(tys: Vector(Ty), b: Ty) bool {
    var res: bool = false;
    match b {
        Ty.Tup(b2) => {
            const n: i64 = vector.len(tys);
            if n == vector.len(b2) {
                var ok: bool = true;
                var i: i64 = 0;
                while i < n {
                    if same_ty(vector.get(tys, i), vector.get(b2, i)) == false {
                        ok = false;
                    }
                    i = i + 1;
                }
                res = ok;
            }
        },
        _ => {},
    };
    return res;
}

pub fn same_opt(inner: Ty, b: Ty) bool {
    return match b {
        Ty.OptT(i2) => same_ty(inner, i2),
        _ => false,
    };
}

pub fn same_res(rz: ResTT, b: Ty) bool {
    return match b {
        Ty.ResT(r2) => same_ty(rz.err, r2.err) and same_ty(rz.ok, r2.ok),
        _ => false,
    };
}

pub fn is_opt_t(t: Ty) bool {
    return match t {
        Ty.OptT(inner) => true,
        _ => false,
    };
}

pub fn is_res_t(t: Ty) bool {
    return match t {
        Ty.ResT(rz) => true,
        _ => false,
    };
}

pub fn same_fnsig(sig: FnSig, b: Ty) bool {
    return match b {
        Ty.FnT(s2) => same_fnsig2(sig, s2),
        _ => false,
    };
}

pub fn same_fnsig2(a: FnSig, b: FnSig) bool {
    if vector.len(a.params) != vector.len(b.params) {
        return false;
    }
    if same_ty(a.ret, b.ret) == false {
        return false;
    }
    var ok: bool = true;
    const n: i64 = vector.len(a.params);
    var i: i64 = 0;
    while i < n {
        if same_ty(vector.get(a.params, i), vector.get(b.params, i)) == false {
            ok = false;
        }
        i = i + 1;
    }
    return ok;
}

pub fn same_named(n: Str, b: Ty) bool {
    return match b {
        Ty.Named(n2) => n == n2,
        _ => false,
    };
}

pub fn same_vec(inner: Ty, b: Ty) bool {
    return match b {
        Ty.Vec(inner2) => same_ty(inner, inner2),
        _ => false,
    };
}

// The D-074 erasure, mirrored (incl. the union nesting: rec_ref erases
// a box of a PRODUCT, so unions ride box<product<[box<sum>]>>).
pub fn wrap_store(mut e: Emitter, value: Str, t: Ty, line: i64, col: i64) Str {
    if is_named_t(t) == false {
        return value;
    }
    const a: Ast = e_ast(e);
    const vty: Str = value_ir_t(a, t);
    const nm: Str = named_of(t);
    const td: TypeDecl = find_td(a, nm);
    var box: Str = value;
    var ref_operand_ty: Str = vty;
    if td.is_union {
        var acc1: Str = "!frk_mem.box<!frk_adt.product<[!frk_mem.box<";
        acc1 = str.concat(acc1, vty);
        acc1 = str.concat(acc1, ">]>>");
        const pty: Str = str.concat("!frk_adt.product<[!frk_mem.box<", str.concat(vty, ">]>"));
        const sb: Str = fresh(e);
        var l1: Str = " = \"frk_mem.box_new\"(";
        l1 = str.concat(l1, value);
        l1 = str.concat(l1, ") : (");
        l1 = str.concat(l1, vty);
        l1 = str.concat(l1, ") -> !frk_mem.box<");
        l1 = str.concat(l1, vty);
        l1 = str.concat(l1, ">");
        emit_line(e, str.concat(sb, l1));
        const e0: Str = fresh(e);
        emit_line(e, str.concat(e0, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
        const p1: Str = fresh(e);
        var l2: Str = " = \"frk_adt.product_snoc\"(";
        l2 = str.concat(l2, e0);
        l2 = str.concat(l2, ", ");
        l2 = str.concat(l2, sb);
        l2 = str.concat(l2, ") : (!frk_adt.product<[]>, !frk_mem.box<");
        l2 = str.concat(l2, vty);
        l2 = str.concat(l2, ">) -> ");
        l2 = str.concat(l2, pty);
        emit_line(e, str.concat(p1, l2));
        const pb: Str = fresh(e);
        var l3: Str = " = \"frk_mem.box_new\"(";
        l3 = str.concat(l3, p1);
        l3 = str.concat(l3, ") : (");
        l3 = str.concat(l3, pty);
        l3 = str.concat(l3, ") -> !frk_mem.box<");
        l3 = str.concat(l3, pty);
        l3 = str.concat(l3, ">");
        emit_line(e, str.concat(pb, l3));
        box = pb;
        ref_operand_ty = acc1;
    }
    const r: Str = fresh(e);
    var lr: Str = " = \"frk_mem.rec_ref\"(";
    lr = str.concat(lr, box);
    lr = str.concat(lr, ") : (");
    lr = str.concat(lr, ref_operand_ty);
    lr = str.concat(lr, ") -> !frk_mem.recref");
    emit_line(e, str.concat(r, lr));
    return r;
}

pub fn named_of(t: Ty) Str {
    return match t {
        Ty.Named(n) => n,
        _ => "",
    };
}

pub fn unwrap_load(mut e: Emitter, stored: Str, t: Ty, line: i64, col: i64) Str {
    if is_named_t(t) == false {
        return stored;
    }
    const a: Ast = e_ast(e);
    const vty: Str = value_ir_t(a, t);
    const nm: Str = named_of(t);
    const td: TypeDecl = find_td(a, nm);
    var cast_ty: Str = vty;
    var is_u: bool = false;
    if td.is_union {
        var acc: Str = "!frk_mem.box<!frk_adt.product<[!frk_mem.box<";
        acc = str.concat(acc, vty);
        acc = str.concat(acc, ">]>>");
        cast_ty = acc;
        is_u = true;
    }
    const box: Str = fresh(e);
    var l1: Str = " = \"frk_mem.rec_cast\"(";
    l1 = str.concat(l1, stored);
    l1 = str.concat(l1, ") : (!frk_mem.recref) -> ");
    l1 = str.concat(l1, cast_ty);
    emit_line(e, str.concat(box, l1));
    if is_u == false {
        return box;
    }
    const pty: Str = str.concat("!frk_adt.product<[!frk_mem.box<", str.concat(vty, ">]>"));
    const prod: Str = fresh(e);
    var l2: Str = " = \"frk_mem.box_get\"(";
    l2 = str.concat(l2, box);
    l2 = str.concat(l2, ") : (");
    l2 = str.concat(l2, cast_ty);
    l2 = str.concat(l2, ") -> ");
    l2 = str.concat(l2, pty);
    emit_line(e, str.concat(prod, l2));
    const inb: Str = fresh(e);
    var l3: Str = " = \"frk_adt.get\"(";
    l3 = str.concat(l3, prod);
    l3 = str.concat(l3, ") {field = 0 : i64} : (");
    l3 = str.concat(l3, pty);
    l3 = str.concat(l3, ") -> !frk_mem.box<");
    l3 = str.concat(l3, vty);
    l3 = str.concat(l3, ">");
    emit_line(e, str.concat(inb, l3));
    const s: Str = fresh(e);
    var l4: Str = " = \"frk_mem.box_get\"(";
    l4 = str.concat(l4, inb);
    l4 = str.concat(l4, ") : (!frk_mem.box<");
    l4 = str.concat(l4, vty);
    l4 = str.concat(l4, ">) -> ");
    l4 = str.concat(l4, vty);
    emit_line(e, str.concat(s, l4));
    return s;
}

// %T{...} construction (the seed's emit_make: DECLARED field order,
// defaults, base updates, per-field storage wrapping).
pub fn mk_field_expr(fields: Vector(MakeField), name: Str) MakeField {
    const n: i64 = vector.len(fields);
    var i: i64 = 0;
    while i < n {
        const f: MakeField = vector.get(fields, i);
        if f.name == name {
            return f;
        }
        i = i + 1;
    }
    return %MakeField{name: "", expr: poison()};
}

pub fn emit_make(mut e: Emitter, m: MakeE, line: i64, col: i64) Str {
    const a: Ast = e_ast(e);
    const td: TypeDecl = find_td(a, m.ty);
    if td.name == "" {
        return e_fail_at(e, line, col, str.concat("unknown type `", str.concat(m.ty, "`")));
    }
    if td.is_union {
        var msg_u: Str = "`";
        msg_u = str.concat(msg_u, m.ty);
        msg_u = str.concat(msg_u, "` is a union; construct variants as `");
        msg_u = str.concat(msg_u, m.ty);
        msg_u = str.concat(msg_u, ".Variant`");
        return e_fail_at(e, line, col, msg_u);
    }
    var base_value: Str = "";
    if m.has_base {
        base_value = emit_expr(e, m.base);
        const bty: Ty = vget(e, base_value);
        if is_named_t(bty) == false {
            return e_fail_at(e, line, col, str.concat("the update base must be a `", str.concat(m.ty, "` value")));
        }
        if named_of(bty) != m.ty {
            return e_fail_at(e, line, col, str.concat("the update base must be a `", str.concat(m.ty, "` value")));
        }
    }
    const vty: Str = value_ir_t(a, Ty.Named(td.name));
    const e0: Str = fresh(e);
    emit_line(e, str.concat(e0, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
    var acc: Str = e0;
    var acc_fields: Str = "";
    var acc_ty: Str = "!frk_adt.product<[]>";
    const nf: i64 = vector.len(td.fields);
    var i: i64 = 0;
    while i < nf {
        const fld: FieldDecl = vector.get(td.fields, i);
        const pf: MakeField = mk_field_expr(m.fields, fld.name);
        var value: Str = "";
        if pf.name != "" {
            value = emit_expr_typed(e, pf.expr, fld.ty);
        } else {
            if m.has_base {
                const stored: Str = fresh(e);
                var l: Str = " = \"frk_mem.field_get\"(";
                l = str.concat(l, base_value);
                l = str.concat(l, ") {field = ");
                l = str.concat(l, str.fromI64(i));
                l = str.concat(l, " : i64} : (");
                l = str.concat(l, vty);
                l = str.concat(l, ") -> ");
                l = str.concat(l, storage_ir_t(a, fld.ty));
                emit_line(e, str.concat(stored, l));
                value = unwrap_load(e, stored, fld.ty, line, col);
            } else {
                if fld.has_default {
                    value = emit_expr_typed(e, fld.default, fld.ty);
                } else {
                    return e_fail_at(e, line, col, str.concat("missing required field `", str.concat(fld.name, "`")));
                }
            }
        }
        const stored2: Str = wrap_store(e, value, fld.ty, line, col);
        const sty: Str = storage_ir_t(a, fld.ty);
        var new_fields: Str = sty;
        if i > 0 {
            new_fields = str.concat(acc_fields, str.concat(", ", sty));
        }
        const new_ty: Str = str.concat("!frk_adt.product<[", str.concat(new_fields, "]>"));
        const nxt: Str = fresh(e);
        var l2: Str = " = \"frk_adt.product_snoc\"(";
        l2 = str.concat(l2, acc);
        l2 = str.concat(l2, ", ");
        l2 = str.concat(l2, stored2);
        l2 = str.concat(l2, ") : (");
        l2 = str.concat(l2, acc_ty);
        l2 = str.concat(l2, ", ");
        l2 = str.concat(l2, sty);
        l2 = str.concat(l2, ") -> ");
        l2 = str.concat(l2, new_ty);
        emit_line(e, str.concat(nxt, l2));
        acc = nxt;
        acc_fields = new_fields;
        acc_ty = new_ty;
        i = i + 1;
    }
    const b: Str = fresh(e);
    var l3: Str = " = \"frk_mem.box_new\"(";
    l3 = str.concat(l3, acc);
    l3 = str.concat(l3, ") : (");
    l3 = str.concat(l3, acc_ty);
    l3 = str.concat(l3, ") -> ");
    l3 = str.concat(l3, vty);
    emit_line(e, str.concat(b, l3));
    vset(e, b, Ty.Named(td.name));
    return b;
}

// The unit-variant value (`Token.Plus`) and payload construction
// (`Token.Ident("a")`), mirroring the seed's shapes.
pub fn emit_unit_variant(mut e: Emitter, td: TypeDecl, uty: Ty, vname: Str, line: i64, col: i64) Str {
    const idx: i64 = variant_index(td, vname);
    if idx < 0 {
        return e_fail_at(e, line, col, str.concat("unknown variant `", str.concat(vname, "`")));
    }
    const a: Ast = e_ast(e);
    const uir: Str = value_ir_t(a, uty);
    const e0: Str = fresh(e);
    emit_line(e, str.concat(e0, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
    const s: Str = fresh(e);
    var l: Str = " = \"frk_adt.make_sum\"(";
    l = str.concat(l, e0);
    l = str.concat(l, ") {variant = ");
    l = str.concat(l, str.fromI64(idx));
    l = str.concat(l, " : i64} : (!frk_adt.product<[]>) -> ");
    l = str.concat(l, uir);
    emit_line(e, str.concat(s, l));
    vset(e, s, uty);
    return s;
}

pub fn variant_index(td: TypeDecl, vname: Str) i64 {
    const n: i64 = vector.len(td.variants);
    var i: i64 = 0;
    while i < n {
        const v: VariantDecl = vector.get(td.variants, i);
        if v.name == vname {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Field access on a struct-typed receiver: `user.name` arrives as
// Ref{name = field, mod = receiver}.
pub fn emit_field_access(mut e: Emitter, recv: Str, rname: Str, field: Str, line: i64, col: i64) Str {
    const a: Ast = e_ast(e);
    const td: TypeDecl = find_td(a, rname);
    if td.name == "" {
        return e_fail_at(e, line, col, str.concat("unknown name `", str.concat(rname, "`")));
    }
    if td.is_union {
        return e_fail_at(e, line, col, str.concat("`", str.concat(rname, "` is a union; use `match`")));
    }
    const idx: i64 = field_index(td, field);
    const fld: FieldDecl = vector.get(td.fields, idx);
    const stored: Str = fresh(e);
    var l: Str = " = \"frk_mem.field_get\"(";
    l = str.concat(l, recv);
    l = str.concat(l, ") {field = ");
    l = str.concat(l, str.fromI64(idx));
    l = str.concat(l, " : i64} : (");
    l = str.concat(l, value_ir_t(a, Ty.Named(td.name)));
    l = str.concat(l, ") -> ");
    l = str.concat(l, storage_ir_t(a, fld.ty));
    emit_line(e, str.concat(stored, l));
    const out: Str = unwrap_load(e, stored, fld.ty, line, col);
    vset(e, out, fld.ty);
    return out;
}

// Payload variant construction: `T.Variant(expr)` (the seed's
// emit_call head, mirrored).
pub fn emit_variant_make(mut e: Emitter, td: TypeDecl, uty: Ty, vname: Str, args: Vector(Expr), line: i64, col: i64) Str {
    const idx: i64 = variant_index(td, vname);
    if idx < 0 {
        return e_fail_at(e, line, col, str.concat("unknown variant `", str.concat(vname, "`")));
    }
    const nv: i64 = vector.len(td.variants);
    const v: VariantDecl = vector.get(td.variants, idx);
    const a: Ast = e_ast(e);
    const uir: Str = value_ir_t(a, uty);
    const na: i64 = vector.len(args);
    if na == 0 {
        if v.has_payload {
            return e_fail_at(e, line, col, str.concat("variant `", str.concat(vname, "` carries a payload (one argument)")));
        }
        return emit_unit_variant(e, td, uty, vname, line, col);
    }
    if na != 1 {
        return e_fail_at(e, line, col, "a variant payload is ONE value (seed v0)");
    }
    if v.has_payload == false {
        return e_fail_at(e, line, col, str.concat("variant `", str.concat(vname, "` has no payload")));
    }
    const payload: Str = emit_expr_typed(e, vector.get(args, 0), v.ty);
    const stored: Str = wrap_store(e, payload, v.ty, line, col);
    const sty: Str = storage_ir_t(a, v.ty);
    const e0: Str = fresh(e);
    emit_line(e, str.concat(e0, " = \"frk_adt.product_new\"() : () -> !frk_adt.product<[]>"));
    const prod: Str = fresh(e);
    var l1: Str = " = \"frk_adt.product_snoc\"(";
    var l0: Str = "";
    l0 = str.concat(e0, "");
    l1 = str.concat(l1, l0);
    l1 = str.concat(l1, ", ");
    l1 = str.concat(l1, stored);
    l1 = str.concat(l1, ") : (!frk_adt.product<[]>, ");
    l1 = str.concat(l1, sty);
    l1 = str.concat(l1, ") -> !frk_adt.product<[");
    l1 = str.concat(l1, sty);
    l1 = str.concat(l1, "]>");
    emit_line(e, str.concat(prod, l1));
    const s: Str = fresh(e);
    var l2: Str = " = \"frk_adt.make_sum\"(";
    l2 = str.concat(l2, prod);
    l2 = str.concat(l2, ") {variant = ");
    l2 = str.concat(l2, str.fromI64(idx));
    l2 = str.concat(l2, " : i64} : (!frk_adt.product<[");
    l2 = str.concat(l2, sty);
    l2 = str.concat(l2, "]>) -> ");
    l2 = str.concat(l2, uir);
    emit_line(e, str.concat(s, l2));
    vset(e, s, uty);
    return s;
}

// Destructuring bindings (D-107), mirroring the seed's destr branch.
pub fn emit_destr_names(mut e: Emitter, d: DestrS, line: i64, col: i64) {
    const a: Ast = e_ast(e);
    const v: Str = emit_expr(e, d.expr);
    const bty: Ty = vget(e, v);
    if is_named_t(bty) == false {
        const _x: Str = e_fail_at(e, line, col, "destructuring needs a struct-typed initializer (seed v0)");
        return;
    }
    const td: TypeDecl = find_td(a, named_of(bty));
    if td.is_union {
        const _y: Str = e_fail_at(e, line, col, str.concat("`", str.concat(td.name, "` is a union; destructure with `match`")));
        return;
    }
    const n: i64 = vector.len(d.names);
    var i: i64 = 0;
    while i < n {
        const nm: DName = vector.get(d.names, i);
        const idx: i64 = field_index(td, nm.field);
        const fld: FieldDecl = vector.get(td.fields, idx);
        const stored: Str = fresh(e);
        var l: Str = " = \"frk_mem.field_get\"(";
        l = str.concat(l, v);
        l = str.concat(l, ") {field = ");
        l = str.concat(l, str.fromI64(idx));
        l = str.concat(l, " : i64} : (");
        l = str.concat(l, value_ir_t(a, bty));
        l = str.concat(l, ") -> ");
        l = str.concat(l, storage_ir_t(a, fld.ty));
        emit_line(e, str.concat(stored, l));
        const value: Str = unwrap_load(e, stored, fld.ty, line, col);
        if d.mutable {
            const b: Str = fresh(e);
            var lb: Str = " = \"frk_mem.box_new\"(";
            lb = str.concat(lb, value);
            lb = str.concat(lb, ") : (");
            lb = str.concat(lb, value_ir_t(a, fld.ty));
            lb = str.concat(lb, ") -> ");
            lb = str.concat(lb, box_ir_t(a, fld.ty));
            emit_line(e, str.concat(b, lb));
            declare(e, %Binding{name: nm.name, is_box: true, ty: fld.ty, id: b, box: box_ir_t(a, fld.ty)});
        } else {
            vset(e, value, fld.ty);
            declare(e, %Binding{name: nm.name, is_box: false, ty: fld.ty, id: value, box: ""});
        }
        i = i + 1;
    }
}


// The vector prelude (vector.len/push/set/get), mirroring the seed's
// type-driven resolution.
pub fn emit_vector_call(mut e: Emitter, vname: Str, args: Vector(Expr), line: i64, col: i64) Str {
    if vname == "new" {
        return e_fail_at(e, line, col, "vector.new() takes its instantiation from the declaration's annotation (seed v0)");
    }
    const na: i64 = vector.len(args);
    if na < 1 {
        return e_fail_at(e, line, col, str.concat("vector.", str.concat(vname, " needs the vector as its first argument")));
    }
    const vid: Str = emit_expr(e, vector.get(args, 0));
    const vty: Ty = vget(e, vid);
    if is_vec_t(vty) == false {
        return e_fail_at(e, line, col, str.concat("vector.", str.concat(vname, " expects a Vector receiver")));
    }
    const inner: Ty = vec_inner(vty);
    const a: Ast = e_ast(e);
    const box: Str = vec_box(a, inner);
    const slot: Str = vec_slot_ir(inner);
    const prefix: Str = vec_prefix(inner);
    if vname == "len" {
        const res: Str = fresh(e);
        var l: Str = " = func.call @";
        l = str.concat(l, prefix);
        l = str.concat(l, "_len(");
        l = str.concat(l, vid);
        l = str.concat(l, ") : (");
        l = str.concat(l, box);
        l = str.concat(l, ") -> i64");
        emit_line(e, str.concat(res, l));
        vset(e, res, Ty.I64);
        return res;
    }
    if vname == "push" {
        return emit_vec_push_set(e, vname, vid, vty, inner, box, slot, prefix, args, line, col);
    }
    if vname == "set" {
        return emit_vec_push_set(e, vname, vid, vty, inner, box, slot, prefix, args, line, col);
    }
    if vname == "get" {
        if na != 2 {
            return e_fail_at(e, line, col, "vector.get takes exactly two arguments (seed v0)");
        }
        const iid: Str = emit_expr(e, vector.get(args, 1));
        const res2: Str = fresh(e);
        var l2: Str = " = func.call @";
        l2 = str.concat(l2, prefix);
        l2 = str.concat(l2, "_get(");
        l2 = str.concat(l2, vid);
        l2 = str.concat(l2, ", ");
        l2 = str.concat(l2, iid);
        l2 = str.concat(l2, ") : (");
        l2 = str.concat(l2, box);
        l2 = str.concat(l2, ", i64) -> ");
        l2 = str.concat(l2, slot);
        emit_line(e, str.concat(res2, l2));
        if is_named_t(inner) {
            const value: Str = unwrap_load(e, res2, inner, line, col);
            vset(e, value, inner);
            return value;
        }
        vset(e, res2, inner);
        return res2;
    }
    return e_fail_at(e, line, col, str.concat("unknown vector operation `", str.concat(vname, "` (seed v0: new/push/get/set/len)")));
}

pub fn vec_inner(t: Ty) Ty {
    return match t {
        Ty.Vec(inner) => inner,
        _ => Ty.UnitV,
    };
}

pub fn emit_vec_push_set(mut e: Emitter, vname: Str, vid: Str, vty: Ty, inner: Ty, box: Str, slot: Str, prefix: Str, args: Vector(Expr), line: i64, col: i64) Str {
    const na: i64 = vector.len(args);
    var want: i64 = 2;
    if vname == "set" {
        want = 3;
    }
    if na != want {
        return e_fail_at(e, line, col, str.concat("vector.", str.concat(vname, " takes the wrong argument count (seed v0)")));
    }
    var index_id: Str = "";
    if vname == "set" {
        index_id = emit_expr(e, vector.get(args, 1));
    }
    const xid: Str = emit_expr(e, vector.get(args, want - 1));
    const xty: Ty = vget(e, xid);
    if same_ty(xty, inner) == false {
        return e_fail_at(e, line, col, str.concat("vector.", str.concat(vname, " value type does not match the Vector slot")));
    }
    var stored: Str = xid;
    if is_named_t(inner) {
        stored = wrap_store(e, xid, xty, line, col);
    }
    var l: Str = "func.call @";
    l = str.concat(l, prefix);
    l = str.concat(l, "_");
    l = str.concat(l, vname);
    l = str.concat(l, "(");
    l = str.concat(l, vid);
    var types: Str = box;
    if vname == "set" {
        l = str.concat(l, ", ");
        l = str.concat(l, index_id);
        types = str.concat(types, ", i64");
    }
    l = str.concat(l, ", ");
    l = str.concat(l, stored);
    l = str.concat(l, ") : (");
    l = str.concat(l, types);
    l = str.concat(l, ", ");
    l = str.concat(l, slot);
    l = str.concat(l, ") -> ()");
    emit_line(e, l);
    return "";
}


// `vector.new()` is instantiated from the BINDING's annotation (the
// seed's syntax-directed hook, mirrored).
pub fn is_vec_new(ex: Expr) bool {
    return match ex {
        Expr.Call(c) => is_vec_new_call(c),
        _ => false,
    };
}

pub fn is_vec_new_call(c: Call) bool {
    const r: Ref = c.callee;
    if r.mod != "vector" {
        return false;
    }
    if r.name != "new" {
        return false;
    }
    return vector.len(c.args) == 0;
}

pub fn emit_vec_new(mut e: Emitter, t: Ty, line: i64, col: i64) Str {
    if is_vec_t(t) == false {
        return e_fail_at(e, line, col, "vector.new() needs an annotated Vector binding (seed v0)");
    }
    const inner: Ty = vec_inner(t);
    const a: Ast = e_ast(e);
    const res: Str = fresh(e);
    var l: Str = " = func.call @";
    l = str.concat(l, vec_prefix(inner));
    l = str.concat(l, "_new() : () -> ");
    l = str.concat(l, vec_box(a, inner));
    emit_line(e, str.concat(res, l));
    vset(e, res, t);
    return res;
}

// ---------------------------------------------------------------- 3b-beta-2
// The MATCH emission, mirroring the seed's block machinery linearly:
// fresh-label order == the seed's block-creation order, so the
// serialized text is identical.

pub const MBind = struct {
    name: Str,
    ty: Ty,
    id: Str,
    line: i64,
    col: i64,
};

pub fn collect_bindings(mut e: Emitter, bindings: Vector(MBind)) {
    const n: i64 = vector.len(bindings);
    var i: i64 = 0;
    while i < n {
        const b: MBind = vector.get(bindings, i);
        declare(e, %Binding{name: b.name, is_box: false, ty: b.ty, id: b.id, box: ""});
        vset(e, b.id, b.ty);
        i = i + 1;
    }
}

pub fn emit_equality(mut e: Emitter, a: Str, b: Str, t: Ty, line: i64, col: i64) Str {
    if ty_is_i64(t) {
        const r: Str = fresh(e);
        emit_line(e, str.concat(r, str.concat(" = arith.cmpi eq, ", str.concat(a, str.concat(", ", str.concat(b, " : i64"))))));
        vset(e, r, Ty.BoolV);
        return r;
    }
    if ty_is_bool(t) {
        const r2: Str = fresh(e);
        emit_line(e, str.concat(r2, str.concat(" = arith.cmpi eq, ", str.concat(a, str.concat(", ", str.concat(b, " : i1"))))));
        vset(e, r2, Ty.BoolV);
        return r2;
    }
    if ty_is_str(t) {
        const r3: Str = fresh(e);
        var l: Str = " = \"frk_bstr.eq\"(";
        l = str.concat(l, a);
        l = str.concat(l, ", ");
        l = str.concat(l, b);
        l = str.concat(l, ") : (!frk_bstr.str, !frk_bstr.str) -> i1");
        emit_line(e, str.concat(r3, l));
        vset(e, r3, Ty.BoolV);
        return r3;
    }
    return e_fail_at(e, line, col, "seed v0 compares only i64/bool/Str in patterns");
}

pub fn pattern_is_catch_all2(p: Pat) bool {
    return match p {
        Pat.Wild => true,
        Pat.Bind(n) => true,
        Pat.Rec(r) => prec_is_catch_all(r),
        Pat.Lit(l) => false,
        Pat.Pin(n) => false,
        Pat.Variant(v) => false,
        Pat.Dot(v2) => false,
        Pat.PatBad(b) => false,
    };
}

pub fn prec_is_catch_all(r: PRec) bool {
    const n: i64 = vector.len(r.fields);
    var i: i64 = 0;
    while i < n {
        const f: PField = vector.get(r.fields, i);
        if pattern_is_catch_all2(f.sub) == false {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Returns the i1 condition ssa ("" = none) and pushes bindings.
pub fn pattern_conditions(mut e: Emitter, p: Pat, value: Str, lty: Ty, out_bindings: Vector(MBind)) Str {
    return match p {
        Pat.Wild => "",
        Pat.Bind(n) => pc_bind(e, n, value, lty, p, out_bindings),
        Pat.Pin(n) => pc_pin(e, n, value, lty, p),
        Pat.Lit(l) => pc_lit(e, l, value, lty, p),
        Pat.Rec(r) => pc_rec(e, r, value, lty, p, out_bindings),
        Pat.Variant(v) => pc_variant(e, v, value, lty, p),
        Pat.Dot(v) => pc_dot(e, v, value, lty, p),
        Pat.PatBad(b) => e_fail(e, b),
    };
}


pub fn pc_bind(mut e: Emitter, n: Str, value: Str, lty: Ty, p: Pat, out_bindings: Vector(MBind)) Str {
    vector.push(out_bindings, %MBind{name: n, ty: lty, id: value, line: 0, col: 0});
    return "";
}

pub fn pc_pin(mut e: Emitter, n: Str, value: Str, lty: Ty, p: Pat) Str {
    const b: Binding = lookup(e, n);
    if b.name == "" {
        return e_fail_at(e, 0, 0, str.concat("unknown pinned name `", str.concat(n, "`")));
    }
    const other: Str = read_binding(e, b);
    return emit_equality(e, value, other, lty, 0, 0);
}

pub fn pc_lit(mut e: Emitter, l: PLit, value: Str, lty: Ty, p: Pat) Str {
    var other: Str = "";
    if l.litty == "i64" {
        if ty_is_i64(lty) == false {
            return e_fail_at(e, 0, 0, "integer patterns match only i64 subjects");
        }
        other = const_i64(e, l.text);
    } else {
        if l.litty == "bool" {
            if ty_is_bool(lty) == false {
                return e_fail_at(e, 0, 0, "boolean patterns match only bool subjects");
            }
            other = e_bool(e, l.text);
        } else {
            if ty_is_str(lty) == false {
                return e_fail_at(e, 0, 0, "string patterns match only Str subjects");
            }
            other = e_str(e, l.text);
        }
    }
    return emit_equality(e, value, other, lty, 0, 0);
}

pub fn pc_rec(mut e: Emitter, r: PRec, value: Str, lty: Ty, p: Pat, out_bindings: Vector(MBind)) Str {
    if is_named_t(lty) == false {
        return e_fail_at(e, 0, 0, str.concat("pattern `%", str.concat(r.ty, "{...}` does not match the subject type")));
    }
    if named_of(lty) != r.ty {
        return e_fail_at(e, 0, 0, str.concat("pattern `%", str.concat(r.ty, "{...}` does not match the subject type")));
    }
    const a: Ast = e_ast(e);
    const td: TypeDecl = find_td(a, r.ty);
    if td.is_union {
        return e_fail_at(e, 0, 0, str.concat("`%", str.concat(r.ty, "{...}` is a struct pattern")));
    }
    var cond: Str = "";
    const self_ty: Ty = Ty.Named(td.name);
    const n: i64 = vector.len(r.fields);
    var i: i64 = 0;
    while i < n {
        const fp: PField = vector.get(r.fields, i);
        const idx: i64 = field_index(td, fp.name);
        const fld: FieldDecl = vector.get(td.fields, idx);
        const stored: Str = fresh(e);
        var l: Str = " = \"frk_mem.field_get\"(";
        l = str.concat(l, value);
        l = str.concat(l, ") {field = ");
        l = str.concat(l, str.fromI64(idx));
        l = str.concat(l, " : i64} : (");
        l = str.concat(l, value_ir_t(a, self_ty));
        l = str.concat(l, ") -> ");
        l = str.concat(l, storage_ir_t(a, fld.ty));
        emit_line(e, str.concat(stored, l));
        const fv: Str = unwrap_load(e, stored, fld.ty, 0, 0);
        const c2: Str = pattern_conditions(e, fp.sub, fv, fld.ty, out_bindings);
        if str.len(c2) > 0 {
            if str.len(cond) == 0 {
                cond = c2;
            } else {
                const both: Str = fresh(e);
                emit_line(e, str.concat(both, str.concat(" = arith.andi ", str.concat(cond, str.concat(", ", str.concat(c2, " : i1"))))));
                vset(e, both, Ty.BoolV);
                cond = both;
            }
        }
        i = i + 1;
    }
    return cond;
}

pub fn pc_dot(mut e: Emitter, v: PVar, value: Str, lty: Ty, p: Pat) Str {
    if is_named_t(lty) == false and is_opt_t(lty) == false and is_res_t(lty) == false {
        return e_fail_at(e, 0, 0, "`.Variant` patterns need a union subject");
    }
    const a: Ast = e_ast(e);
    const td: TypeDecl = decl_for(a, lty);
    if td.is_union == false {
        return e_fail_at(e, 0, 0, "`.Variant` patterns need a union subject");
    }
    const idx: i64 = variant_index(td, v.variant);
    if idx < 0 {
        return e_fail_at(e, 0, 0, str.concat("unknown variant `", str.concat(v.variant, "`")));
    }
    const tag: Str = fresh(e);
    var l: Str = " = \"frk_adt.tag_of\"(";
    l = str.concat(l, value);
    l = str.concat(l, ") : (");
    l = str.concat(l, value_ir_t(a, lty));
    l = str.concat(l, ") -> i64");
    emit_line(e, str.concat(tag, l));
    const eq: Str = fresh(e);
    emit_line(e, str.concat(eq, str.concat(" = arith.cmpi eq, ", str.concat(tag, str.concat(", ", str.concat(const_i64(e, str.fromI64(idx)), " : i64"))))));
    vset(e, eq, Ty.BoolV);
    return eq;
}

pub fn pc_variant(mut e: Emitter, v: PVar, value: Str, lty: Ty, p: Pat) Str {
    if is_named_t(lty) == false and is_opt_t(lty) == false and is_res_t(lty) == false {
        return e_fail_at(e, 0, 0, "variant patterns need a union subject");
    }
    const a: Ast = e_ast(e);
    const td: TypeDecl = decl_for(a, lty);
    if td.is_union == false {
        return e_fail_at(e, 0, 0, str.concat("pattern `", str.concat(v.ty, str.concat(".", str.concat(v.variant, "` does not match the subject type")))));
    }
    if td.name != v.ty {
        return e_fail_at(e, 0, 0, str.concat("pattern `", str.concat(v.ty, str.concat(".", str.concat(v.variant, "` does not match the subject type")))));
    }
    const idx: i64 = variant_index(td, v.variant);
    const tag: Str = fresh(e);
    var l: Str = " = \"frk_adt.tag_of\"(";
    l = str.concat(l, value);
    l = str.concat(l, ") : (");
    l = str.concat(l, value_ir_t(a, lty));
    l = str.concat(l, ") -> i64");
    emit_line(e, str.concat(tag, l));
    const eq: Str = fresh(e);
    emit_line(e, str.concat(eq, str.concat(" = arith.cmpi eq, ", str.concat(tag, str.concat(", ", str.concat(const_i64(e, str.fromI64(idx)), " : i64"))))));
    vset(e, eq, Ty.BoolV);
    return eq;
}


// ---------------------------------------------------------------- D-112
// Collection literals, typed by the target annotation only (never
// inference), emitted through the mirrored vector prelude; the same
// shapes as the seed's emit_list_literal.
pub fn ref_of_expr(ex: Expr) Ref {
    return match ex {
        Expr.Ref(r) => r,
        _ => %Ref{name: "", mod: ""},
    };
}

pub fn emit_expr_typed(mut e: Emitter, ex: Expr, ty: Ty) Str {
    match ex {
        Expr.Tup(es) => {
            return emit_tuple_e(e, es, ty);
        },
        Expr.Lam(l2) => {
            // Inferred closure parameters (D-086): a bare/partial
            // literal at a fn-typed position takes its signature from
            // the expected type.
            match ty {
                Ty.FnT(sig) => {
                    const nps: i64 = vector.len(sig.params);
                    const nlp: i64 = vector.len(l2.params);
                    if nps != nlp {
                        return e_fail_at(e, 0, 0, "the closure's parameter count does not match the expected fn type");
                    }
                    var lps2: Vector(Param) = vector.new();
                    var i2: i64 = 0;
                    while i2 < nlp {
                        const lp: Param = vector.get(l2.params, i2);
                        var lty: Ty = lp.ty;
                        if ty_is_hole(lty) {
                            lty = vector.get(sig.params, i2);
                        } else {
                            const lty0: Ty = tv_res(e, lty);
                            if same_ty(lty0, vector.get(sig.params, i2)) == false {
                                return e_fail_at(e, 0, 0, "the closure's parameter type does not match the expected fn type");
                            }
                            lty = lty0;
                        }
                        vector.push(lps2, %Param{name: lp.name, ty: lty, mut: lp.mut, is_comptime: false});
                        i2 = i2 + 1;
                    }
                    var lrt: Ty = l2.ret;
                    if ty_is_hole(lrt) {
                        lrt = sig.ret;
                    } else {
                        const lrt0: Ty = tv_res(e, lrt);
                        if same_ty(lrt0, sig.ret) == false {
                            return e_fail_at(e, 0, 0, "the closure's return type does not match the expected fn type");
                        }
                        lrt = lrt0;
                    }
                    const filled: LamE = %LamE{params: lps2, ret: lrt, body: l2.body};
                    return emit_lambda_expr(e, filled);
                },
                _ => {
                    return e_fail_at(e, 0, 0, "this closure has no expected fn type; annotate its parameters and return type");
                },
            };
        },
        _ => {},
    };
    var dot: Ref = %Ref{name: "", mod: ""};
    var dot_args: Vector(Expr) = empty_expr_vec();
    var is_dot: bool = false;
    match ex {
        Expr.Call(c2) => {
            const cr: Ref = c2.callee;
            if cr.mod == "@dot" {
                dot = cr;
                dot_args = c2.args;
                is_dot = true;
            }
        },
        _ => {},
    };
    if is_dot {
        if is_opt_t(ty) or is_res_t(ty) {
            return emit_variant_make(e, synth_td(ty), ty, dot.name, dot_args, 0, 0);
        }
        if is_named_t(ty) == false {
            return e_fail_at(e, 0, 0, "`.Variant` needs a union-typed context (annotate the binding or return a union)");
        }
        const synth: Call = %Call{callee: %Ref{name: dot.name, mod: named_of(ty)}, args: dot_args, line: 0, col: 0};
        return emit_call(e, synth, 0, 0);
    }
    if has_ty_annotation(ty) {
        return match ex {
            Expr.List(l) => emit_list_literal(e, ty, l),
            _ => emit_expr(e, ex),
        };
    }
    return emit_expr(e, ex);
}

pub fn empty_expr_vec() Vector(Expr) {
    var v: Vector(Expr) = vector.new();
    return v;
}

pub fn has_ty_annotation(ty: Ty) bool {
    return match ty {
        Ty.TyBad(b) => false,
        _ => true,
    };
}

pub fn emit_list_literal(mut e: Emitter, ty: Ty, items: Vector(Expr)) Str {
    match ty {
        Ty.ArrT(a2) => {
            // `[N]T` (the vector steering): exactly N elements, inline.
            const na: i64 = vector.len(items);
            if na != a2.n {
                return e_fail_at(e, 0, 0, str.concat("a fixed-length array literal needs exactly ", str.concat(str.fromI64(a2.n), " element(s)")));
            }
            const aa: Ast = e_ast(e);
            const av: Str = fresh(e);
            const nl: Str = const_i64(e, str.fromI64(a2.n));
            var la: Str = " = \"frk_mem.array_new\"(";
            la = str.concat(la, nl);
            la = str.concat(la, ") : (i64) -> ");
            la = str.concat(la, value_ir_t(aa, ty));
            emit_line(e, str.concat(av, la));
            var i2: i64 = 0;
            while i2 < na {
                const xa: Str = emit_expr_typed(e, vector.get(items, i2), a2.ty);
                const stored: Str = wrap_store(e, xa, a2.ty, 0, 0);
                const ki: Str = const_i64(e, str.fromI64(i2));
                var ls: Str = "\"frk_mem.array_set\"(";
                ls = str.concat(ls, av);
                ls = str.concat(ls, ", ");
                ls = str.concat(ls, ki);
                ls = str.concat(ls, ", ");
                ls = str.concat(ls, stored);
                ls = str.concat(ls, ") : (");
                ls = str.concat(ls, value_ir_t(aa, ty));
                ls = str.concat(ls, ", i64, ");
                ls = str.concat(ls, storage_ir_t(aa, a2.ty));
                ls = str.concat(ls, ") -> ()");
                emit_line(e, ls);
                i2 = i2 + 1;
            }
            vset(e, av, ty);
            return av;
        },
        _ => {},
    };
    if is_vec_t(ty) == false {
        return e_fail_at(e, 0, 0, "a collection literal needs a [T]/Vector or [N]T annotation");
    }
    const a: Ast = e_ast(e);
    const inner: Ty = vec_inner(ty);
    const prefix: Str = vec_prefix(inner);
    const v: Str = fresh(e);
    emit_line(e, str.concat(v, str.concat(" = func.call @", str.concat(prefix, str.concat("_new() : () -> ", vec_box(a, inner))))));
    const n: i64 = vector.len(items);
    var i: i64 = 0;
    while i < n {
        const xid: Str = emit_expr(e, vector.get(items, i));
        const xty: Ty = vget(e, xid);
        if same_ty(xty, inner) == false {
            e_fail_at(e, 0, 0, "collection literal element type does not match the [T] annotation");
            return "";
        }
        var stored: Str = xid;
        if is_named_t(inner) {
            stored = wrap_store(e, xid, xty, 0, 0);
        }
        const slot: Str = storage_ir_t(a, inner);
        var l: Str = "func.call @";
        l = str.concat(l, prefix);
        l = str.concat(l, "_push(");
        l = str.concat(l, v);
        l = str.concat(l, ", ");
        l = str.concat(l, stored);
        l = str.concat(l, ") : (");
        l = str.concat(l, vec_box(a, inner));
        l = str.concat(l, ", ");
        l = str.concat(l, slot);
        l = str.concat(l, ") -> ()");
        emit_line(e, l);
        i = i + 1;
    }
    vset(e, v, ty);
    return v;
}

// Field assignment (D-112): legal only through a mutable binding (a
// var local or a mut parameter); the write is frk_mem.field_set on the
// record's box.
pub fn emit_fassign(mut e: Emitter, f: FAssS) {
    const b: Binding = lookup(e, f.name);
    if b.name == "" {
        e_fail_at(e, 0, 0, str.concat("unknown name `", str.concat(f.name, "` in field assignment")));
        return;
    }
    var fassignable: bool = b.is_box;
    if b.is_cap {
        if b.cap_kind == "box" {
            fassignable = true;
        }
    }
    if fassignable == false {
        e_fail_at(e, 0, 0, str.concat("cannot set a field through immutable `", str.concat(f.name, "` (use a var binding or a mut parameter)")));
        return;
    }
    if is_named_t(b.ty) == false {
        e_fail_at(e, 0, 0, "field assignment needs a record binding (seed v0)");
        return;
    }
    const a: Ast = e_ast(e);
    const td: TypeDecl = find_td(a, named_of(b.ty));
    if td.is_union {
        e_fail_at(e, 0, 0, str.concat("`", str.concat(named_of(b.ty), "` is a union; assign through `match`")));
        return;
    }
    const idx: i64 = field_index(td, f.field);
    const fld: FieldDecl = vector.get(td.fields, idx);
    const v: Str = emit_expr_typed(e, f.expr, fld.ty);
    const vty: Ty = vget(e, v);
    if same_ty(vty, fld.ty) == false {
        e_fail_at(e, 0, 0, str.concat("field `", str.concat(f.field, "` does not take this value's type")));
        return;
    }
    const rec: Str = fresh(e);
    const self_ty: Ty = b.ty;
    var l0: Str = " = \"frk_mem.box_get\"(";
    l0 = str.concat(l0, binding_slot(e, b));
    l0 = str.concat(l0, ") : (");
    l0 = str.concat(l0, box_ir_t(a, self_ty));
    l0 = str.concat(l0, ") -> ");
    l0 = str.concat(l0, value_ir_t(a, self_ty));
    emit_line(e, str.concat(rec, l0));
    var stored: Str = v;
    if is_named_t(fld.ty) {
        stored = wrap_store(e, v, fld.ty, 0, 0);
    }
    var l1: Str = "\"frk_mem.field_set\"(";
    l1 = str.concat(l1, rec);
    l1 = str.concat(l1, ", ");
    l1 = str.concat(l1, stored);
    l1 = str.concat(l1, ") {field = ");
    l1 = str.concat(l1, str.fromI64(idx));
    l1 = str.concat(l1, " : i64} : (");
    l1 = str.concat(l1, value_ir_t(a, self_ty));
    l1 = str.concat(l1, ", ");
    l1 = str.concat(l1, storage_ir_t(a, fld.ty));
    l1 = str.concat(l1, ") -> ()");
    emit_line(e, l1);
}

// ---------------------------------------------------------------- match
pub const MTy = struct {
    label: Str,
    arg: Str,
    has: Vector(i64),
    ty: Vector(Ty),
    brs: Vector(i64),
};

pub fn mt_new(label: Str, arg: Str) MTy {
    var h: Vector(i64) = vector.new();
    vector.push(h, 0);
    var t: Vector(Ty) = vector.new();
    vector.push(t, Ty.UnitV);
    var b: Vector(i64) = vector.new();
    vector.push(b, 0);
    return %MTy{label: label, arg: arg, has: h, ty: t, brs: b};
}

pub fn emit_arm(mut e: Emitter, c: MTy, conditions: Str, bindings: Vector(MBind), body: Expr, false_target: Str) Str {
    if str.len(conditions) > 0 {
        const body_label: Str = fresh_label(e);
        var nlabel: Str = false_target;
        if str.len(nlabel) == 0 {
            nlabel = fresh_label(e);
        }
        emit_line(e, str.concat("cf.cond_br ", str.concat(conditions, str.concat(", ^", str.concat(body_label, str.concat(", ^", nlabel))))));
        new_label(e, body_label);
        emit_arm_body(e, c, bindings, body);
        new_label(e, nlabel);
        return "split";
    }
    emit_arm_body(e, c, bindings, body);
    return "inplace";
}

pub fn emit_arm_body(mut e: Emitter, c: MTy, bindings: Vector(MBind), body: Expr) {
    scope_push(e);
    collect_bindings(e, bindings);
    var v: Str = "";
    var is_blk: bool = false;
    match body {
        Expr.Blk(b0) => {
            is_blk = true;
            v = emit_value_block(e, b0);
        },
        _ => {},
    };
    if is_blk == false {
        v = emit_expr(e, body);
    }
    var vty: Ty = Ty.UnitV;
    var has: bool = false;
    if str.len(v) > 0 {
        vty = vget(e, v);
        has = true;
    }
    if is_terminated(e) == false {
        vector.set(c.brs, 0, vector.get(c.brs, 0) + 1);
        if has == false {
            terminate(e, str.concat("cf.br ^", c.label));
        } else {
            if ty_is_unit(vty) {
                terminate(e, str.concat("cf.br ^", c.label));
            } else {
                if vector.get(c.has, 0) > 0 {
                    const prev: Ty = vector.get(c.ty, 0);
                    if same_ty(prev, vty) == false {
                        e_fail_at(e, 0, 0, "match arms produce different types");
                        return;
                    }
                } else {
                    vector.set(c.has, 0, 1);
                    vector.set(c.ty, 0, vty);
                }
                var l: Str = "cf.br ^";
                l = str.concat(l, c.label);
                l = str.concat(l, "(");
                l = str.concat(l, v);
                l = str.concat(l, " : ");
                l = str.concat(l, value_ir_t(e_ast(e), vty));
                l = str.concat(l, ")");
                terminate(e, l);
            }
        }
    }
    scope_pop(e);
}

pub fn emit_join(mut e: Emitter, c: MTy) Str {
    const a: Ast = e_ast(e);
    if vector.get(c.brs, 0) == 0 {
        // Every arm returned: the join was never targeted; do not
        // create a predecessor-less block (its dead terminator would
        // survive lowering unconverted).
        e.terminated = true;
        return "";
    }
    if vector.get(c.has, 0) > 0 {
        const ty: Ty = vector.get(c.ty, 0);
        var l: Str = "^";
        l = str.concat(l, c.label);
        l = str.concat(l, "(");
        l = str.concat(l, c.arg);
        l = str.concat(l, ": ");
        l = str.concat(l, value_ir_t(a, ty));
        l = str.concat(l, "):");
        emit_top(e, l);
        e.terminated = false;
        vset(e, c.arg, ty);
        return c.arg;
    }
    new_label(e, c.label);
    return "";
}

pub fn pv_of(p: Pat) PVar {
    return match p {
        Pat.Variant(v) => v,
        Pat.Dot(v) => v,
        _ => %PVar{ty: "", variant: "", has_payload: false, sub: Pat.Wild},
    };
}

pub fn emit_match(mut e: Emitter, m: MatchE) Str {
    var sname: Str = "";
    var smod: Str = "";
    const scrut: Expr = m.scrut;
    match scrut {
        Expr.Ref(r) => { sname = r.name; smod = r.mod; },
        _ => {},
    };
    if str.len(sname) == 0 {
        return e_fail_at(e, 0, 0, "a match scrutinee must be a named value (seed v0)");
    }
    if str.len(smod) > 0 {
        return e_fail_at(e, 0, 0, "a match scrutinee must be a named value (seed v0)");
    }
    const b: Binding = lookup(e, sname);
    if b.name == "" {
        return e_fail_at(e, 0, 0, str.concat("unknown name `", str.concat(sname, "`")));
    }
    const value: Str = read_binding(e, b);
    const sty: Ty = b.ty;
    const join_label: Str = fresh_label(e);
    const join_arg: Str = str.concat("%j", str.fromI64(e.next_block));
    const c: MTy = mt_new(join_label, join_arg);
    if is_named_t(sty) {
        const td: TypeDecl = find_td(e_ast(e), named_of(sty));
        if td.is_union {
            return emit_match_union(e, m, td, value, sty, c);
        }
        return emit_match_struct(e, m, td, value, sty, c);
    }
    if is_opt_t(sty) or is_res_t(sty) {
        return emit_match_union(e, m, synth_td(sty), value, sty, c);
    }
    return emit_match_builtin(e, m, value, sty, c);
}


pub fn emit_match_union(mut e: Emitter, m: MatchE, d: TypeDecl, value: Str, sty: Ty, c: MTy) Str {
    const a: Ast = e_ast(e);
    const n_arms: i64 = vector.len(m.arms);
    const nv: i64 = vector.len(d.variants);
    var covered: Vector(i64) = vector.new();
    var q: i64 = 0;
    while q < nv {
        vector.push(covered, 0);
        q = q + 1;
    }
    var chain_idx: Vector(i64) = vector.new();
    var chain_arm: Vector(i64) = vector.new();
    var default_arm: i64 = 0 - 1;
    var i: i64 = 0;
    while i < n_arms {
        const arm: Arm = vector.get(m.arms, i);
        const p0: Pat = arm.pat;
        match p0 {
            Pat.Variant(v) => {
                if v.ty != d.name {
                    e_fail_at(e, 0, 0, str.concat("pattern `", str.concat(v.ty, str.concat("` does not match scrutinee type `", str.concat(d.name, "`")))));
                    return "";
                }
                const idx: i64 = variant_index(d, v.variant);
                if vector.get(covered, idx) > 0 {
                    e_fail_at(e, 0, 0, str.concat("redundant arm: `", str.concat(v.variant, "` is already covered")));
                    return "";
                }
                vector.set(covered, idx, 1);
                vector.push(chain_idx, idx);
                vector.push(chain_arm, i);
            },
            Pat.Dot(v3) => {
                const idx2: i64 = variant_index(d, v3.variant);
                if idx2 < 0 {
                    e_fail_at(e, 0, 0, str.concat("unknown variant `", str.concat(v3.variant, "`")));
                    return "";
                }
                if vector.get(covered, idx2) > 0 {
                    e_fail_at(e, 0, 0, str.concat("redundant arm: `", str.concat(v3.variant, "` is already covered")));
                    return "";
                }
                vector.set(covered, idx2, 1);
                vector.push(chain_idx, idx2);
                vector.push(chain_arm, i);
            },
            Pat.Wild => {
                if default_arm >= 0 {
                    e_fail_at(e, 0, 0, "unreachable arm: a previous arm already covers everything");
                    return "";
                }
                default_arm = i;
            },
            Pat.Bind(n) => {
                if default_arm >= 0 {
                    e_fail_at(e, 0, 0, "unreachable arm: a previous arm already covers everything");
                    return "";
                }
                default_arm = i;
            },
            _ => {
                e_fail_at(e, 0, 0, "in a union match, arms are variant patterns or `_`/bindings (seed v0)");
                return "";
            },
        };
        i = i + 1;
    }
    if default_arm < 0 {
        var missing: Str = "";
        var cnt: i64 = 0;
        var k: i64 = 0;
        while k < nv {
            if vector.get(covered, k) == 0 {
                if cnt > 0 {
                    missing = str.concat(missing, ", ");
                }
                const vd: VariantDecl = vector.get(d.variants, k);
                missing = str.concat(missing, str.concat(d.name, str.concat(".", vd.name)));
                cnt = cnt + 1;
            }
            k = k + 1;
        }
        if cnt > 0 {
            e_fail_at(e, 0, 0, str.concat("match does not cover ", missing));
            return "";
        }
    }
    var chain_n: i64 = vector.len(chain_idx);
    var fall_i: i64 = default_arm;
    if default_arm < 0 {
        fall_i = vector.get(chain_arm, chain_n - 1);
        const fa: Arm = vector.get(m.arms, fall_i);
        const fp: PVar = pv_of(fa.pat);
        var sub_can_fail: bool = false;
        if fp.has_payload {
            const fsub: Pat = fp.sub;
            match fsub {
                Pat.Wild => {},
                Pat.Bind(n) => {},
                _ => {
                    sub_can_fail = true;
                },
            };
        }
        if sub_can_fail {
            e_fail_at(e, 0, 0, "this payload pattern can fail; add a following `_` arm (seed v0)");
            return "";
        }
        chain_n = chain_n - 1;
    }
    var ci: i64 = 0;
    while ci < chain_n {
        const idx2: i64 = vector.get(chain_idx, ci);
        const ai: i64 = vector.get(chain_arm, ci);
        const arm: Arm = vector.get(m.arms, ai);
        const pa: PVar = pv_of(arm.pat);
        const arm_label: Str = fresh_label(e);
        const next_label: Str = fresh_label(e);
        const tag: Str = fresh(e);
        var tl: Str = " = \"frk_adt.tag_of\"(";
        tl = str.concat(tl, value);
        tl = str.concat(tl, ") : (");
        tl = str.concat(tl, value_ir_t(a, sty));
        tl = str.concat(tl, ") -> i64");
        emit_line(e, str.concat(tag, tl));
        const eq: Str = fresh(e);
        var el: Str = " = arith.cmpi eq, ";
        el = str.concat(el, tag);
        el = str.concat(el, ", ");
        el = str.concat(el, const_i64(e, str.fromI64(idx2)));
        el = str.concat(el, " : i64");
        emit_line(e, str.concat(eq, el));
        emit_line(e, str.concat("cf.cond_br ", str.concat(eq, str.concat(", ^", str.concat(arm_label, str.concat(", ^", next_label))))));
        new_label(e, arm_label);
        var conditions: Str = "";
        var bindings: Vector(MBind) = vector.new();
        if pa.has_payload {
            const vd2: VariantDecl = vector.get(d.variants, idx2);
            if vd2.has_payload == false {
                e_fail_at(e, 0, 0, str.concat("variant `", str.concat(pa.variant, "` has no payload")));
                return "";
            }
            const stored: Str = fresh(e);
            var sl: Str = " = \"frk_adt.extract\"(";
            sl = str.concat(sl, value);
            sl = str.concat(sl, ") {variant = ");
            sl = str.concat(sl, str.fromI64(idx2));
            sl = str.concat(sl, " : i64, field = 0 : i64} : (");
            sl = str.concat(sl, value_ir_t(a, sty));
            sl = str.concat(sl, ") -> ");
            sl = str.concat(sl, storage_ir_t(a, vd2.ty));
            emit_line(e, str.concat(stored, sl));
            const pv: Str = unwrap_load(e, stored, vd2.ty, 0, 0);
            conditions = pattern_conditions(e, pa.sub, pv, vd2.ty, bindings);
        }
        const step: Str = emit_arm(e, c, conditions, bindings, arm.body, next_label);
        if step == "inplace" {
            new_label(e, next_label);
        }
        ci = ci + 1;
    }
    const fall_arm: Arm = vector.get(m.arms, fall_i);
    var conditions2: Str = "";
    var bindings2: Vector(MBind) = vector.new();
    const fpat: Pat = fall_arm.pat;
    match fpat {
        Pat.Variant(v) => {
            if v.has_payload {
                const idx3: i64 = variant_index(d, v.variant);
                const vd3: VariantDecl = vector.get(d.variants, idx3);
                if vd3.has_payload == false {
                    e_fail_at(e, 0, 0, str.concat("variant `", str.concat(v.variant, "` has no payload")));
                    return "";
                }
                const stored2: Str = fresh(e);
                var sl2: Str = " = \"frk_adt.extract\"(";
                sl2 = str.concat(sl2, value);
                sl2 = str.concat(sl2, ") {variant = ");
                sl2 = str.concat(sl2, str.fromI64(idx3));
                sl2 = str.concat(sl2, " : i64, field = 0 : i64} : (");
                sl2 = str.concat(sl2, value_ir_t(a, sty));
                sl2 = str.concat(sl2, ") -> ");
                sl2 = str.concat(sl2, storage_ir_t(a, vd3.ty));
                emit_line(e, str.concat(stored2, sl2));
                const pv2: Str = unwrap_load(e, stored2, vd3.ty, 0, 0);
                conditions2 = pattern_conditions(e, v.sub, pv2, vd3.ty, bindings2);
                if str.len(conditions2) > 0 {
                    e_fail_at(e, 0, 0, "internal: the fall arm's conditions can fail");
                    return "";
                }
            }
        },
        Pat.Dot(v4) => {
            if v4.has_payload {
                const idx4: i64 = variant_index(d, v4.variant);
                const vd4: VariantDecl = vector.get(d.variants, idx4);
                if vd4.has_payload == false {
                    e_fail_at(e, 0, 0, str.concat("variant `", str.concat(v4.variant, "` has no payload")));
                    return "";
                }
                const stored4: Str = fresh(e);
                var sl4: Str = " = \"frk_adt.extract\"(";
                sl4 = str.concat(sl4, value);
                sl4 = str.concat(sl4, ") {variant = ");
                sl4 = str.concat(sl4, str.fromI64(idx4));
                sl4 = str.concat(sl4, " : i64, field = 0 : i64} : (");
                sl4 = str.concat(sl4, value_ir_t(a, sty));
                sl4 = str.concat(sl4, ") -> ");
                sl4 = str.concat(sl4, storage_ir_t(a, vd4.ty));
                emit_line(e, str.concat(stored4, sl4));
                const pv4: Str = unwrap_load(e, stored4, vd4.ty, 0, 0);
                conditions2 = pattern_conditions(e, v4.sub, pv4, vd4.ty, bindings2);
                if str.len(conditions2) > 0 {
                    e_fail_at(e, 0, 0, "internal: the fall arm's conditions can fail");
                    return "";
                }
            }
        },
        Pat.Bind(n) => {
            vector.push(bindings2, %MBind{name: n, ty: sty, id: value, line: 0, col: 0});
        },
        _ => {},
    };
    emit_arm(e, c, conditions2, bindings2, fall_arm.body, "");
    return emit_join(e, c);
}

pub fn emit_match_struct(mut e: Emitter, m: MatchE, d: TypeDecl, value: Str, sty: Ty, c: MTy) Str {
    const n_arms: i64 = vector.len(m.arms);
    var default_seen: i64 = 0 - 1;
    var i: i64 = 0;
    while i < n_arms {
        const arm: Arm = vector.get(m.arms, i);
        if default_seen >= 0 {
            e_fail_at(e, 0, 0, "unreachable arm: a previous arm already covers everything");
            return "";
        }
        if pattern_is_catch_all2(arm.pat) {
            default_seen = i;
        }
        i = i + 1;
    }
    if default_seen < 0 {
        e_fail_at(e, 0, 0, "a struct match needs a final catch-all arm (`_`, a binding, or an all-binding record pattern) (seed v0)");
        return "";
    }
    var j: i64 = 0;
    while j < n_arms {
        const arm: Arm = vector.get(m.arms, j);
        var bindings: Vector(MBind) = vector.new();
        if j == default_seen {
            const cond0: Str = pattern_conditions(e, arm.pat, value, sty, bindings);
            if str.len(cond0) > 0 {
                e_fail_at(e, 0, 0, "internal: a catch-all arm carries conditions");
                return "";
            }
            emit_arm(e, c, "", bindings, arm.body, "");
        } else {
            const cond1: Str = pattern_conditions(e, arm.pat, value, sty, bindings);
            if str.len(cond1) == 0 {
                e_fail_at(e, 0, 0, "this pattern matches unconditionally; use `_` as the catch-all arm (seed v0)");
                return "";
            }
            emit_arm(e, c, cond1, bindings, arm.body, "");
        }
        j = j + 1;
    }
    return emit_join(e, c);
}

pub fn emit_match_builtin(mut e: Emitter, m: MatchE, value: Str, sty: Ty, c: MTy) Str {
    const n_arms: i64 = vector.len(m.arms);
    var default_seen: i64 = 0 - 1;
    var i: i64 = 0;
    while i < n_arms {
        const arm: Arm = vector.get(m.arms, i);
        const p1: Pat = arm.pat;
        match p1 {
            Pat.Wild => {
                if default_seen >= 0 {
                    e_fail_at(e, 0, 0, "unreachable arm: a previous arm already covers everything");
                    return "";
                }
                default_seen = i;
            },
            Pat.Bind(n) => {
                if default_seen >= 0 {
                    e_fail_at(e, 0, 0, "unreachable arm: a previous arm already covers everything");
                    return "";
                }
                default_seen = i;
            },
            _ => {},
        };
        i = i + 1;
    }
    if default_seen < 0 {
        e_fail_at(e, 0, 0, "a builtin match needs a final `_` or binding arm (seed v0)");
        return "";
    }
    var j: i64 = 0;
    while j < n_arms {
        const arm: Arm = vector.get(m.arms, j);
        var bindings: Vector(MBind) = vector.new();
        if j == default_seen {
            const p2: Pat = arm.pat;
            match p2 {
                Pat.Bind(n) => {
                    vector.push(bindings, %MBind{name: n, ty: sty, id: value, line: 0, col: 0});
                },
                _ => {},
            };
            emit_arm(e, c, "", bindings, arm.body, "");
        } else {
            const cond1: Str = pattern_conditions(e, arm.pat, value, sty, bindings);
            if str.len(cond1) == 0 {
                e_fail_at(e, 0, 0, "this pattern matches unconditionally; use `_` as the catch-all arm (seed v0)");
                return "";
            }
            emit_arm(e, c, cond1, bindings, arm.body, "");
        }
        j = j + 1;
    }
    return emit_join(e, c);
}
