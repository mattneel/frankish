// calq0 slice-3a driver: lex + parse + EMIT input unit 0, printing the
// artifact text (one io.print per line). The emitter's failures render
// at this boundary like every other calq0 diagnostic.
pub fn main() i64 {
    const count: i64 = __calque_input_count();
    if count < 1 {
        io.print("error 1:1 no input unit\n");
        return 1;
    }
    const src: Str = __calque_input(0);
    const lx: Lexed = lex(src);
    if state_ok(lx.state) == false {
        io.print(fail_text(state_fail(lx.state)));
        io.print("\n");
        return 1;
    }
    const p: P = p_new(lx.toks);
    const a: Ast = p_ast(p);
    if p_ok(p) == false {
        io.print(fail_text(state_fail(p_state(p))));
        io.print("\n");
        return 1;
    }
    const e: Emit = e_init();
    emit_module(e, a);
    if e_ok(e) == false {
        io.print(fail_text(state_fail(e_state(e))));
        io.print("\n");
        return 1;
    }
    const lines: Vector(Str) = e_render(e);
    const n: i64 = vector.len(lines);
    var i: i64 = 0;
    while i < n {
        io.print(vector.get(lines, i));
        io.print("\n");
        i = i + 1;
    }
    return 0;
}
