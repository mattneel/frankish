// The vector steering: `[N]T` fixed-length inline arrays - the
// literal with exactly N elements and `v[i]` reads.
// Expected output (hand-derived): "15|6\n"
pub fn sum3(xs: [3]i64) i64 {
    xs[0] + xs[1] + xs[2]
}
pub fn main() i64 {
    const xs: [3]i64 = [4, 5, 6];
    io.print(str.fromI64(sum3(xs)));
    io.print("|");
    io.print(str.fromI64(xs[2]));
    io.print("\n");
    0
}
