alias Compiler.Emitter;
pub module Compiler.Emitter {
    pub struct { n: i64 = 0, }
    pub fn get(self: Self) i64 { self.n }
    pub fn bump(mut self: Self) { self.n = self.n + 1; }
}
pub fn main() i64 {
    var e: Emitter = %Emitter{};
    e.bump();
    e.bump();
    e.bump();
    io.print(str.fromI64(e.get()));
    io.print("\n");
    io.print(str.fromI64(Emitter.get(e)));
    io.print("\n");
    0
}
