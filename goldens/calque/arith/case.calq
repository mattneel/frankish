// b0 arithmetic: precedence, div/mod, comparison truth values.
// Expected output (hand-derived): "19\n3\n2\n1\n0\n"
pub fn main() i64 {
    io.print(str.fromI64((2 + 3) * 4 - 1));
    io.print("\n");
    io.print(str.fromI64(17 / 5));
    io.print("\n");
    io.print(str.fromI64(17 % 5));
    io.print("\n");
    if 3 < 4 { io.print("1\n"); } else { io.print("0\n"); }
    if 3 > 4 { io.print("1\n"); } else { io.print("0\n"); }
    0
}
